---
/**
 * Filtros por categoria. Las categorias se calculan solas a partir
 * de las fichas: nunca hay que mantener una lista aparte.
 *
 * El filtrado es un <script> chico que togglea `hidden` en el <li>
 * contenedor (el item de la grilla) segun `data-categoria`. Ocultar el
 * <li> y no el <article> hace que CSS Grid reacomode solo, sin huecos.
 */
interface Props {
  categorias: string[];
}

const { categorias } = Astro.props;
const opciones = ['todas', ...categorias];
---

<nav class="filtros" aria-label="Filtrar plantillas por categoria">
  <span class="filtros__label">Categoria</span>
  {
    opciones.map((cat) => (
      <button
        type="button"
        class="filtro-btn"
        data-filtro={cat}
        aria-pressed={cat === 'todas' ? 'true' : 'false'}
      >
        {cat === 'todas' ? 'Todas' : cat}
      </button>
    ))
  }
</nav>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');

  // Items de la grilla: el <li> que envuelve cada tarjeta. Se resuelve la
  // categoria desde el [data-categoria] interno una sola vez.
  const items = [...document.querySelectorAll<HTMLElement>('.catalogo-grid > li')].map(
    (li) => ({
      li,
      cat: li.querySelector<HTMLElement>('[data-categoria]')?.dataset.categoria ?? '',
    }),
  );

  function aplicar(filtro: string) {
    let visibles = 0;
    for (const { li, cat } of items) {
      const oculto = filtro !== 'todas' && cat !== filtro;
      li.hidden = oculto;
      if (!oculto) visibles++;
    }
    for (const btn of botones) {
      btn.setAttribute('aria-pressed', String(btn.dataset.filtro === filtro));
    }
    const vacio = document.querySelector<HTMLElement>('[data-catalogo-vacio]');
    if (vacio) vacio.hidden = visibles > 0;
  }

  for (const btn of botones) {
    btn.addEventListener('click', () => aplicar(btn.dataset.filtro ?? 'todas'));
  }
</script>
