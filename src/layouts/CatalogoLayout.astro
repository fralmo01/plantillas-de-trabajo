---
/**
 * Layout del PORTAL / catalogo.
 * Solo lo usan las paginas del showroom (index y, si hace falta, sub-paginas).
 * Las plantillas NO usan este layout: cada una es su propio mundo aislado.
 */
import '@styles/tokens.css';
import '@styles/filtros.css';
import '@styles/catalogo.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'Catalogo de Plantillas Web',
  descripcion = 'Showroom de plantillas web listas para personalizar.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
