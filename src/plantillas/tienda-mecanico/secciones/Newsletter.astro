<section class="tm-news">
  <div class="tm-wrap tm-news__inner">
    <h2>Obten Descuentos Exclusivos</h2>
    <form class="tm-news__form" id="tm-news-form">
      <input type="email" required placeholder="Tu correo electronico" aria-label="Correo electronico" />
      <button type="submit" class="tm-btn tm-btn--naranja">Suscribete!</button>
    </form>
    <p class="tm-news__nota" id="tm-news-nota">Ingresa tu email. Siempre tenemos informacion para ti.</p>
  </div>
</section>

<script>
  const f = document.getElementById('tm-news-form');
  const nota = document.getElementById('tm-news-nota');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    (f as HTMLFormElement).reset();
    if (nota) nota.textContent = 'Listo, te avisaremos de cada novedad.';
  });
</script>

<style>
  .tm-news {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .tm-news__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .tm-news__inner h2 {
    color: var(--tm-naranja);
    font-size: clamp(1.4rem, 3.2vw, 2rem);
  }

  .tm-news__form {
    display: flex;
    width: 100%;
    max-width: 460px;
    border: 1px solid var(--tm-linea);
    border-radius: 6px;
    overflow: hidden;
  }

  .tm-news__form input {
    flex: 1;
    background: transparent;
    border: none;
    color: #fff;
    padding: 0.85rem 1.1rem;
    font-size: 0.85rem;
    outline: none;
  }

  .tm-news__form input::placeholder {
    color: var(--tm-gris);
  }

  .tm-news__form .tm-btn {
    border-radius: 0;
  }

  .tm-news__nota {
    text-transform: none;
    font-size: 0.8rem;
    color: var(--tm-gris);
  }
</style>
