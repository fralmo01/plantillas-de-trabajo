---
import { heroSlides } from '../datos/mecanico.js';
---

<section class="tm-hero" aria-roledescription="carrusel">
  <div class="tm-hero__track" id="tm-hero-track">
    {heroSlides.map((s: { kicker: string; watermark: string; titulo: string; sub: string; cta: string; img: string }) => (
      <article class="tm-hero__slide">
        <div class="tm-hero__tx">
          <span class="tm-hero__marca">{s.kicker}</span>
          <span class="tm-hero__watermark" aria-hidden="true">{s.watermark}</span>
          <h2>{s.titulo}</h2>
          <p>{s.sub}</p>
          <a href="#productos" class="tm-btn tm-btn--naranja">{s.cta}</a>
        </div>
        <div class="tm-hero__img">
          <img src={s.img} alt={s.titulo} loading="eager" />
        </div>
      </article>
    ))}
  </div>
  <button class="tm-hero__nav tm-hero__nav--prev" id="tm-hero-prev" aria-label="Anterior">&lsaquo;</button>
  <button class="tm-hero__nav tm-hero__nav--next" id="tm-hero-next" aria-label="Siguiente">&rsaquo;</button>
  <div class="tm-hero__dots" id="tm-hero-dots">
    {heroSlides.map((_: unknown, i: number) => <button aria-label={`Ir al slide ${i + 1}`} data-dot={i}></button>)}
  </div>
</section>

<script>
  const track = document.getElementById('tm-hero-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#tm-hero-dots button'));
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }

  document.getElementById('tm-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('tm-hero-next')?.addEventListener('click', () => ir(idx + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => ir(i)));

  let timer = window.setInterval(() => ir(idx + 1), 6500);
  const box = track?.closest('section');
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6500)));
  ir(0);
</script>

<style>
  .tm-hero {
    position: relative;
    overflow: hidden;
    background: var(--tm-negro);
  }

  .tm-hero__track {
    display: flex;
    transition: transform 0.5s ease;
  }

  .tm-hero__slide {
    position: relative;
    flex: 0 0 100%;
    min-height: clamp(360px, 46vw, 640px);
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background:
      radial-gradient(circle at 78% 30%, rgba(244, 124, 32, 0.28), transparent 55%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.02) 0 2px, transparent 2px 26px),
      var(--tm-negro);
  }

  .tm-hero__tx {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.6rem;
    padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 4vw, 4rem);
    overflow: hidden;
  }

  .tm-hero__marca {
    font-family: var(--tm-titulos);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--tm-naranja);
  }

  .tm-hero__watermark {
    position: absolute;
    left: clamp(1rem, 4vw, 3.5rem);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--tm-titulos);
    font-size: clamp(6rem, 16vw, 12rem);
    color: rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    z-index: -1;
    line-height: 1;
    pointer-events: none;
  }

  .tm-hero__tx h2 {
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    max-width: 14ch;
    margin-top: 0.3rem;
  }

  .tm-hero__tx p {
    text-transform: none;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    color: #ccc;
    max-width: 38ch;
    margin-bottom: 0.5rem;
  }

  .tm-hero__img {
    position: relative;
    z-index: 1;
  }

  .tm-hero__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 14%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 14%);
  }

  .tm-hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    z-index: 3;
  }

  .tm-hero__nav:hover {
    background: var(--tm-naranja);
  }

  .tm-hero__nav--prev { left: 1rem; }
  .tm-hero__nav--next { right: 1rem; }

  .tm-hero__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 3;
  }

  .tm-hero__dots button {
    width: 26px;
    height: 4px;
    background: rgba(255, 255, 255, 0.35);
  }

  .tm-hero__dots button.is-on {
    background: var(--tm-naranja);
  }

  @media (max-width: 820px) {
    .tm-hero__slide {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .tm-hero__img {
      min-height: 260px;
      order: -1;
    }
    .tm-hero__img img {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .tm-hero__tx {
      padding-block: 1.75rem;
    }
    .tm-hero__watermark {
      display: none;
    }
  }
</style>
