---
import { loNuevo } from '../datos/mecanico.js';

interface ProductoNuevo { nombre: string; sub: string; img: string }
const productos = loNuevo.productos as ProductoNuevo[];
---

<section class="tm-lonuevo">
  <div class="tm-lonuevo__bg" aria-hidden="true">LO NUEVO</div>
  <div class="tm-wrap tm-lonuevo__inner">
    <h2 class="tm-lonuevo__titulo">{loNuevo.titulo}</h2>
    <div class="tm-lonuevo__grid">
      {productos.map((p) => (
        <div class="tm-lonuevo__item">
          <div class="tm-lonuevo__foto">
            <img src={p.img} alt={p.nombre} loading="lazy" />
          </div>
          <b>{p.nombre}</b>
          <span>{p.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tm-lonuevo {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #2a0f0a 0%, var(--tm-negro) 65%);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .tm-lonuevo__bg {
    position: absolute;
    top: 10%;
    left: 0;
    right: 0;
    font-family: var(--tm-titulos);
    font-size: clamp(4rem, 14vw, 9rem);
    color: rgba(255, 255, 255, 0.04);
    text-align: center;
    line-height: 1;
    white-space: nowrap;
  }

  .tm-lonuevo__inner {
    position: relative;
    z-index: 1;
  }

  .tm-lonuevo__titulo {
    text-align: center;
    font-size: clamp(1.5rem, 3.6vw, 2.2rem);
    margin-bottom: 2.5rem;
  }

  .tm-lonuevo__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .tm-lonuevo__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tm-lonuevo__foto {
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--tm-linea);
  }

  .tm-lonuevo__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tm-lonuevo__item b {
    font-family: var(--tm-titulos);
    color: var(--tm-naranja);
    font-size: 1rem;
  }

  .tm-lonuevo__item span {
    text-transform: none;
    font-size: 0.8rem;
    color: #ccc;
  }

  @media (max-width: 820px) {
    .tm-lonuevo__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tm-lonuevo__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
