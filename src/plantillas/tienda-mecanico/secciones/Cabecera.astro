---
import { marca, navPrincipal } from '../datos/mecanico.js';
---

<header class="tm-hdr" id="top">
  <div class="tm-wrap tm-hdr__row">
    <a href="#top" class="tm-logo" aria-label={`${marca.nombre} ${marca.sub}`}>
      <span class="tm-logo__linea">LA TIENDA DEL</span>
      <span class="tm-logo__marca">{marca.sub}</span>
    </a>

    <nav class="tm-nav" aria-label="Navegacion principal">
      {navPrincipal.map((n: { t: string; href: string }) => (
        <a href={n.href}>{n.t}</a>
      ))}
    </nav>

    <div class="tm-buscar" id="tm-buscar">
      <input type="search" id="tm-buscar-input" placeholder="Buscar |" aria-label="Buscar productos" />
      <div class="tm-buscar__panel" id="tm-buscar-panel" hidden></div>
    </div>

    <a href="#nosotros" class="tm-btn tm-btn--naranja tm-hdr__contacto">Contacto</a>

    <div class="tm-hdr__acc">
      <button type="button" class="tm-hdr__ico" id="tm-cart-toggle" aria-label="Ver carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6h15l-1.5 9h-12z"></path><path d="M6 6 5 3H2"></path><circle cx="9" cy="20" r="1.6"></circle><circle cx="18" cy="20" r="1.6"></circle>
        </svg>
        <span class="tm-hdr__badge" id="tm-cart-count" hidden>0</span>
      </button>
      <div class="tm-hdr__redes" aria-label="Redes sociales">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="TikTok">&#9835;</a>
        <a href="#" aria-label="Instagram">&#9678;</a>
      </div>
    </div>
  </div>
</header>

<div class="tm-cart-overlay" id="tm-cart-overlay" hidden></div>
<aside class="tm-cart" id="tm-cart" hidden aria-label="Carrito de compras">
  <header class="tm-cart__head">
    <h2>Carrito <small id="tm-cart-n">(0 productos)</small></h2>
    <button type="button" id="tm-cart-cerrar" aria-label="Cerrar carrito">&times;</button>
  </header>
  <div class="tm-cart__body" id="tm-cart-body">
    <p class="tm-cart__vacio" id="tm-cart-vacio">Tu carrito esta vacio.</p>
  </div>
  <footer class="tm-cart__foot">
    <p>Envios a nivel nacional, rapidos y seguros.</p>
    <div class="tm-cart__total">
      <span>Subtotal</span>
      <b id="tm-cart-total">S/ 0.00</b>
    </div>
  </footer>
</aside>

<script>
  import { productosDiagnostico, productosBooster, productosTaller, productosPintura } from '../datos/mecanico.js';

  interface ProductoBuscable { nombre: string; codigo: string; precio: number; img: string }
  const catalogo: ProductoBuscable[] = [
    ...productosDiagnostico,
    ...productosBooster,
    ...productosTaller,
    ...productosPintura,
  ];

  const input = document.getElementById('tm-buscar-input') as HTMLInputElement | null;
  const panel = document.getElementById('tm-buscar-panel');

  function soles(n: number): string {
    return 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (!panel) return;
    if (!q) {
      panel.hidden = true;
      panel.innerHTML = '';
      return;
    }
    const hits = catalogo.filter((p) => p.nombre.toLowerCase().includes(q)).slice(0, 5);
    panel.hidden = false;
    if (hits.length === 0) {
      panel.innerHTML = '<p class="tm-buscar__vacio">Lo siento, no encontramos el producto</p>';
      return;
    }
    panel.innerHTML = hits
      .map(
        (p) => `
      <a href="#productos" class="tm-buscar__item">
        <img src="${p.img}" alt="" />
        <span>${p.nombre}<b>${soles(p.precio)}</b></span>
      </a>`
      )
      .join('');
  });

  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    const buscar = document.getElementById('tm-buscar');
    if (buscar && !buscar.contains(t) && panel) {
      panel.hidden = true;
    }
  });

  interface ItemCarrito { nombre: string; precio: number; img: string; cantidad: number }
  const carrito: ItemCarrito[] = [];

  const cartToggle = document.getElementById('tm-cart-toggle');
  const cartPanel = document.getElementById('tm-cart');
  const cartOverlay = document.getElementById('tm-cart-overlay');
  const cartCerrar = document.getElementById('tm-cart-cerrar');
  const cartBody = document.getElementById('tm-cart-body');
  const cartVacio = document.getElementById('tm-cart-vacio');
  const cartN = document.getElementById('tm-cart-n');
  const cartTotalEl = document.getElementById('tm-cart-total');
  const badge = document.getElementById('tm-cart-count');

  function pintarCarrito() {
    if (!cartBody || !cartN || !cartTotalEl || !badge) return;
    const totalItems = carrito.reduce((a, i) => a + i.cantidad, 0);
    const totalSoles = carrito.reduce((a, i) => a + i.cantidad * i.precio, 0);
    cartN.textContent = `(${totalItems} producto${totalItems === 1 ? '' : 's'})`;
    cartTotalEl.textContent = soles(totalSoles);
    badge.textContent = String(totalItems);
    badge.hidden = totalItems === 0;

    cartBody.querySelectorAll('.tm-cart__item').forEach((el) => el.remove());
    if (cartVacio) cartVacio.hidden = carrito.length > 0;

    carrito.forEach((item) => {
      const row = document.createElement('div');
      row.className = 'tm-cart__item';
      row.innerHTML = `
        <img src="${item.img}" alt="" />
        <div class="tm-cart__item-tx">
          <b>${item.nombre}</b>
          <span>${item.cantidad} x ${soles(item.precio)}</span>
        </div>
      `;
      cartBody.appendChild(row);
    });
  }

  function abrirCarrito(v: boolean) {
    if (!cartPanel || !cartOverlay) return;
    cartPanel.hidden = !v;
    cartOverlay.hidden = !v;
  }

  cartToggle?.addEventListener('click', () => abrirCarrito(true));
  cartCerrar?.addEventListener('click', () => abrirCarrito(false));
  cartOverlay?.addEventListener('click', () => abrirCarrito(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') abrirCarrito(false);
  });

  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;

    const step = el.closest<HTMLButtonElement>('.tm-qty__b');
    if (step) {
      const cont = step.closest('.tm-prod__qty');
      const n = cont?.querySelector<HTMLElement>('.tm-qty__n');
      if (n) {
        const val = Math.max(1, (parseInt(n.textContent || '1', 10) || 1) + Number(step.dataset.step));
        n.textContent = String(val);
      }
      return;
    }

    const add = el.closest<HTMLButtonElement>('.tm-prod__add');
    if (add) {
      const card = add.closest<HTMLElement>('.tm-prod');
      const n = card?.querySelector<HTMLElement>('.tm-qty__n');
      const cantidad = parseInt(n?.textContent || '1', 10) || 1;
      const nombre = card?.querySelector<HTMLElement>('.tm-prod__nombre')?.textContent || 'Producto';
      const precio = Number(card?.dataset.precio || '0');
      const img = card?.querySelector('img')?.getAttribute('src') || '';

      const existente = carrito.find((i) => i.nombre === nombre);
      if (existente) existente.cantidad += cantidad;
      else carrito.push({ nombre, precio, img, cantidad });
      pintarCarrito();

      const prev = add.textContent;
      add.textContent = 'Agregado!';
      add.classList.add('is-ok');
      window.setTimeout(() => {
        add.textContent = prev;
        add.classList.remove('is-ok');
      }, 1100);
    }
  });
</script>

<style>
  .tm-hdr {
    background: var(--tm-negro);
    position: sticky;
    top: 0;
    z-index: 80;
    border-bottom: 1px solid var(--tm-linea);
  }

  .tm-hdr__row {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    padding-block: 0.9rem;
  }

  .tm-logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    flex-shrink: 0;
    transform: skewX(-6deg);
  }

  .tm-logo__linea {
    font-family: var(--tm-titulos);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: #fff;
  }

  .tm-logo__marca {
    font-family: var(--tm-titulos);
    font-size: 1.5rem;
    color: #fff;
    position: relative;
  }

  .tm-logo__marca::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 8px;
    background: var(--tm-naranja);
    z-index: -1;
  }

  .tm-nav {
    display: flex;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .tm-nav a {
    font-size: 0.82rem;
    font-weight: 600;
    color: #ccc;
  }

  .tm-nav a:hover {
    color: #fff;
  }

  .tm-buscar {
    position: relative;
    flex: 1;
    max-width: 320px;
  }

  .tm-buscar input {
    width: 100%;
    background: #1e1e1e;
    border: 1px solid var(--tm-linea);
    border-radius: 6px;
    padding: 0.55rem 0.9rem;
    font-size: 0.82rem;
    color: #fff;
    outline: none;
  }

  .tm-buscar input:focus {
    border-color: var(--tm-naranja);
  }

  .tm-buscar input::placeholder {
    color: var(--tm-gris);
  }

  .tm-buscar__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.6);
    z-index: 90;
  }

  .tm-buscar__panel[hidden] {
    display: none;
  }

  .tm-buscar__panel :global(.tm-buscar__item) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.8rem;
    color: var(--tm-negro);
  }

  .tm-buscar__panel :global(.tm-buscar__item:hover) {
    background: #f4f4f4;
  }

  .tm-buscar__panel :global(.tm-buscar__item img) {
    width: 34px;
    height: 34px;
    object-fit: contain;
    background: #f4f4f4;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .tm-buscar__panel :global(.tm-buscar__item span) {
    display: flex;
    flex-direction: column;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .tm-buscar__panel :global(.tm-buscar__item b) {
    color: var(--tm-naranja-osc);
    font-size: 0.75rem;
  }

  .tm-buscar__panel :global(.tm-buscar__vacio) {
    padding: 0.75rem 0.9rem;
    font-size: 0.78rem;
    color: var(--tm-gris-osc);
  }

  .tm-hdr__contacto {
    flex-shrink: 0;
    padding-block: 0.6rem;
  }

  .tm-hdr__acc {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .tm-hdr__ico {
    position: relative;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    color: #fff;
  }

  .tm-hdr__ico:hover {
    color: var(--tm-naranja);
  }

  .tm-hdr__badge[hidden] {
    display: none;
  }

  .tm-hdr__badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 50%;
    background: var(--tm-naranja);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .tm-hdr__redes {
    display: flex;
    gap: 0.4rem;
  }

  .tm-hdr__redes a {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #1e1e1e;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .tm-hdr__redes a:hover {
    background: var(--tm-naranja);
  }

  .tm-cart-overlay[hidden] {
    display: none;
  }

  .tm-cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 140;
  }

  .tm-cart[hidden] {
    display: none;
  }

  .tm-cart {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(400px, 92vw);
    background: #fff;
    color: var(--tm-negro);
    z-index: 150;
    display: flex;
    flex-direction: column;
    box-shadow: -20px 0 40px -20px rgba(0, 0, 0, 0.5);
  }

  .tm-cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #eee;
  }

  .tm-cart__head h2 {
    color: var(--tm-negro);
    font-size: 1.3rem;
  }

  .tm-cart__head small {
    font-family: var(--tm-font);
    text-transform: none;
    font-size: 0.75rem;
    color: var(--tm-gris-osc);
    font-weight: 600;
  }

  .tm-cart__head button {
    font-size: 1.6rem;
    line-height: 1;
    color: var(--tm-negro);
  }

  .tm-cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tm-cart__vacio[hidden] {
    display: none;
  }

  .tm-cart__vacio {
    color: var(--tm-gris-osc);
    font-size: 0.88rem;
  }

  .tm-cart__item {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .tm-cart__item img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    background: #f4f4f4;
    border-radius: 6px;
  }

  .tm-cart__item-tx {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tm-cart__item-tx b {
    font-size: 0.82rem;
    color: var(--tm-negro);
  }

  .tm-cart__item-tx span {
    font-size: 0.76rem;
    color: var(--tm-gris-osc);
  }

  .tm-cart__foot {
    border-top: 1px solid #eee;
    padding: 1.25rem 1.5rem;
  }

  .tm-cart__foot p {
    font-size: 0.74rem;
    color: var(--tm-gris-osc);
    margin-bottom: 0.75rem;
  }

  .tm-cart__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    color: var(--tm-negro);
  }

  @media (max-width: 1150px) {
    .tm-nav {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .tm-buscar {
      display: none;
    }
  }
</style>
