---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import CategoriasCarrusel from './secciones/CategoriasCarrusel.astro';
import OfertasDestacadas from './secciones/OfertasDestacadas.astro';
import LoNuevoBanner from './secciones/LoNuevoBanner.astro';
import MarcasCarrusel from './secciones/MarcasCarrusel.astro';
import Productos from './secciones/Productos.astro';
import Nosotros from './secciones/Nosotros.astro';
import Newsletter from './secciones/Newsletter.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-tienda-mecanico">
  <BarraSuperior />
  <Cabecera />
  <main>
    <HeroCarrusel />
    <CategoriasCarrusel />
    <OfertasDestacadas />
    <LoNuevoBanner />
    <MarcasCarrusel />
    <Productos />
    <Nosotros />
    <Newsletter />
  </main>
  <PiePagina />
  <ChatBot />
</div>
