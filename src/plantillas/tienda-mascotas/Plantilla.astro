---
import './estilos.css';

import AnuncioBarra from './secciones/AnuncioBarra.astro';
import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import BeneficiosFranja from './secciones/BeneficiosFranja.astro';
import OfertasCards from './secciones/OfertasCards.astro';
import SelloConfianza from './secciones/SelloConfianza.astro';
import EtapaVida from './secciones/EtapaVida.astro';
import ComboGrid from './secciones/ComboGrid.astro';
import SeguroBanner from './secciones/SeguroBanner.astro';
import ProductosCarrusel from './secciones/ProductosCarrusel.astro';
import ServiciosFranja from './secciones/ServiciosFranja.astro';
import SeoTexto from './secciones/SeoTexto.astro';
import Newsletter from './secciones/Newsletter.astro';
