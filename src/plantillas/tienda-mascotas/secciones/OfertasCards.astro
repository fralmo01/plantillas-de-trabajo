---
import { ofertasCards } from '../datos/mascotas.js';

interface Card { badge: string; tag: string; titulo: string; img: string }
---

<section class="ms-seccion" id="ofertas">
  <div class="ms-wrap">
    <div class="ms-ofertas__grid">
      {ofertasCards.map((c: Card) => (
        <div class="ms-ofertas__card">
          <div class="ms-ofertas__tx">
            <span class="ms-ofertas__badge">{c.badge}</span>
            <span class="ms-ofertas__tag">{c.tag}</span>
          </div>
          <img src={c.img} alt={c.titulo} loading="lazy" />
          <a href="#bomba" class="ms-btn ms-btn--rojo ms-ofertas__btn">Comprar</a>
          <p class="ms-ofertas__cap">{c.titulo}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ms-ofertas__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .ms-ofertas__card {
    position: relative;
    background: var(--ms-crema);
    border-radius: 12px;
    padding: 1.1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .ms-ofertas__tx {
    align-self: flex-start;
    display: flex;
    flex-direction: column;
  }

  .ms-ofertas__badge {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--ms-rojo);
    line-height: 1;
  }

  .ms-ofertas__tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ms-gris);
  }

  .ms-ofertas__card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
  }

  .ms-ofertas__btn {
    width: 100%;
  }

  .ms-ofertas__cap {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ms-texto);
  }
</style>
