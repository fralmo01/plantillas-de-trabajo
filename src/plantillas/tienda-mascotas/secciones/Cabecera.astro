---
import { marca, categoriasMenu, marcasChip, ofertasNav } from '../datos/mascotas.js';
import Icono from '../componentes/Icono.astro';
---

<header class="ms-hdr" id="top">
  <div class="ms-wrap ms-hdr__row">
    <a href="#top" class="ms-logo" aria-label={marca.nombre}>
      <span class="ms-logo__ico" aria-hidden="true"><Icono name="pelota" size={22} /></span>
      <span class="ms-logo__tx">{marca.nombre}<b>{marca.sub}</b></span>
    </a>

    <form class="ms-buscar" id="ms-buscar-form" role="search">
      <input type="search" id="ms-buscar-input" placeholder="Busca tus marcas y productos favoritos" aria-label="Buscar productos" />
      <button type="submit" aria-label="Buscar"><Icono name="busqueda" size={18} /></button>
    </form>

    <div class="ms-hdr__acc">
      <a href="#servicios" class="ms-hdr__ico" aria-label="Localiza tu tienda">
        <Icono name="tienda" size={21} />
      </a>
      <button type="button" class="ms-hdr__ico" id="ms-cart-toggle" aria-label="Ver carrito">
        <Icono name="carrito" size={21} />
        <span class="ms-hdr__badge" id="ms-cart-count" hidden>0</span>
      </button>
    </div>
  </div>

  <nav class="ms-nav" aria-label="Categorias">
    <div class="ms-wrap ms-nav__row">
      {categoriasMenu.map((c: { cat: string; ico: string }, i: number) => (
        <button type="button" class="ms-nav__item" data-mega={`cat-${i}`}>
          {c.cat} <Icono name="chevron" size={12} />
        </button>
      ))}
      <a href="#ofertas" class="ms-nav__link">Farmacia</a>
      <button type="button" class="ms-nav__item" data-mega="marcas">Marcas <Icono name="chevron" size={12} /></button>
      <a href="#servicios" class="ms-nav__link">Peluqueria</a>
      <button type="button" class="ms-nav__item ms-nav__item--dest" data-mega="ofertas">Ofertas <Icono name="chevron" size={12} /></button>
      <a href="#seguro" class="ms-nav__link">Seguros</a>
    </div>

    <div class="ms-mega" id="ms-mega" hidden>
      {categoriasMenu.map((c: { cat: string; grupos: { titulo: string; items: string[] }[] }, i: number) => (
        <div class="ms-mega__panel" data-panel={`cat-${i}`} hidden>
          <div class="ms-wrap ms-mega__grid">
            {c.grupos.map((g: { titulo: string; items: string[] }) => (
              <div class="ms-mega__col">
                <h3>{g.titulo}</h3>
                <ul>
                  {g.items.map((it: string) => <li><a href="#footer">{it}</a></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="ms-mega__panel" data-panel="marcas" hidden>
        <div class="ms-wrap ms-mega__marcas">
          {marcasChip.map((m: string) => (
            <div class="ms-mega__marca-chip">{m}</div>
          ))}
        </div>
      </div>

      <div class="ms-mega__panel" data-panel="ofertas" hidden>
        <div class="ms-wrap ms-mega__grid">
          {ofertasNav.map((o: { titulo: string; items: string[] }) => (
            <div class="ms-mega__col">
              <h3>{o.titulo}</h3>
              <ul>
                {o.items.map((it: string) => <li><a href="#ofertas">{it}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<div class="ms-mega-overlay" id="ms-mega-overlay" hidden></div>

<!-- Drawer de carrito -->
<div class="ms-cart-overlay" id="ms-cart-overlay" hidden></div>
<aside class="ms-cart" id="ms-cart" hidden aria-label="Carrito de compras">
  <header class="ms-cart__head">
    <h2>Mis compras <small id="ms-cart-n">(0)</small></h2>
    <button type="button" id="ms-cart-cerrar" aria-label="Cerrar carrito"><Icono name="cerrar" size={20} /></button>
  </header>
  <div class="ms-cart__body" id="ms-cart-body">
    <p class="ms-cart__vacio" id="ms-cart-vacio">Tu carrito esta vacio.</p>
  </div>
  <footer class="ms-cart__foot">
    <div class="ms-cart__total">
      <span>Subtotal</span>
      <b id="ms-cart-total">S/ 0.00</b>
    </div>
  </footer>
</aside>

<script>
  const megaBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.ms-nav__item'));
  const mega = document.getElementById('ms-mega');
  const megaOverlay = document.getElementById('ms-mega-overlay');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.ms-mega__panel'));

  function cerrarMega() {
    if (mega) mega.hidden = true;
    if (megaOverlay) megaOverlay.hidden = true;
    megaBtns.forEach((b) => b.classList.remove('is-on'));
  }

  megaBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.mega;
      const yaAbierto = btn.classList.contains('is-on');
      megaBtns.forEach((b) => b.classList.remove('is-on'));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      if (yaAbierto) {
        cerrarMega();
      } else {
        btn.classList.add('is-on');
        if (mega) mega.hidden = false;
        if (megaOverlay) megaOverlay.hidden = false;
      }
    });
  });

  megaOverlay?.addEventListener('click', cerrarMega);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      cerrarMega();
      abrirCarrito(false);
    }
  });

  const buscarForm = document.getElementById('ms-buscar-form');
  const buscarInput = document.getElementById('ms-buscar-input') as HTMLInputElement | null;
  buscarForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (buscarInput?.value || '').trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.ms-prod').forEach((card) => {
      const hit = !q || (card.dataset.nombre || '').includes(q);
      card.hidden = !hit;
    });
    document.getElementById('bomba')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  interface ItemCarrito { nombre: string; precio: number; img: string; cantidad: number }
  const carrito: ItemCarrito[] = [];

  const cartToggle = document.getElementById('ms-cart-toggle');
  const cartPanelEl = document.getElementById('ms-cart');
  const cartOverlay = document.getElementById('ms-cart-overlay');
  const cartCerrar = document.getElementById('ms-cart-cerrar');
  const cartBody = document.getElementById('ms-cart-body');
  const cartVacio = document.getElementById('ms-cart-vacio');
  const cartN = document.getElementById('ms-cart-n');
  const cartTotalEl = document.getElementById('ms-cart-total');
  const badge = document.getElementById('ms-cart-count');

  function soles(n: number): string {
    return 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function pintarCarrito() {
    if (!cartBody || !cartN || !cartTotalEl || !badge) return;
    const totalItems = carrito.reduce((a, i) => a + i.cantidad, 0);
    const totalSoles = carrito.reduce((a, i) => a + i.cantidad * i.precio, 0);
    cartN.textContent = `(${totalItems})`;
    cartTotalEl.textContent = soles(totalSoles);
    badge.textContent = String(totalItems);
    badge.hidden = totalItems === 0;

    cartBody.querySelectorAll('.ms-cart__item').forEach((el) => el.remove());
    if (cartVacio) cartVacio.hidden = carrito.length > 0;

    carrito.forEach((item) => {
      const row = document.createElement('div');
      row.className = 'ms-cart__item';
      row.innerHTML = `
        <img src="${item.img}" alt="" />
        <div class="ms-cart__item-tx">
          <b>${item.nombre}</b>
          <span>${item.cantidad} x ${soles(item.precio)}</span>
        </div>
      `;
      cartBody.appendChild(row);
    });
  }

  function abrirCarrito(v: boolean) {
    if (!cartPanelEl || !cartOverlay) return;
    cartPanelEl.hidden = !v;
    cartOverlay.hidden = !v;
  }

  cartToggle?.addEventListener('click', () => abrirCarrito(true));
  cartCerrar?.addEventListener('click', () => abrirCarrito(false));
  cartOverlay?.addEventListener('click', () => abrirCarrito(false));

  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;

    const step = el.closest<HTMLButtonElement>('.ms-qty__b');
    if (step) {
      const cont = step.closest('.ms-prod__qty');
      const n = cont?.querySelector<HTMLElement>('.ms-qty__n');
      if (n) {
        const val = Math.max(1, (parseInt(n.textContent || '1', 10) || 1) + Number(step.dataset.step));
        n.textContent = String(val);
      }
      return;
    }

    const add = el.closest<HTMLButtonElement>('.ms-prod__add');
    if (add) {
      const card = add.closest<HTMLElement>('.ms-prod');
      const n = card?.querySelector<HTMLElement>('.ms-qty__n');
      const cantidad = parseInt(n?.textContent || '1', 10) || 1;
      const nombre = card?.querySelector<HTMLElement>('.ms-prod__nombre')?.textContent || 'Producto';
      const precio = Number(card?.dataset.precio || '0');
      const img = card?.querySelector('img')?.getAttribute('src') || '';

      const existente = carrito.find((i) => i.nombre === nombre);
      if (existente) existente.cantidad += cantidad;
      else carrito.push({ nombre, precio, img, cantidad });
      pintarCarrito();

      const prev = add.textContent;
      add.textContent = '¡Agregado!';
      add.classList.add('is-ok');
      window.setTimeout(() => {
        add.textContent = prev;
        add.classList.remove('is-ok');
      }, 1100);
    }
  });
</script>

<style>
  .ms-hdr {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 65;
  }

  .ms-hdr__row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.85rem;
  }

  .ms-logo {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .ms-logo__ico {
    color: var(--ms-rojo);
    position: relative;
    top: 2px;
  }

  .ms-logo__tx {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--ms-negro);
    letter-spacing: -0.02em;
  }

  .ms-logo__tx b {
    font-weight: 700;
    color: var(--ms-rojo);
    font-size: 0.85rem;
    margin-left: 0.3rem;
  }

  .ms-buscar {
    flex: 1;
    display: flex;
    align-items: center;
    border: 1.5px solid var(--ms-linea);
    border-radius: 999px;
    max-width: 620px;
    padding-left: 0.3rem;
  }

  .ms-buscar input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.6rem 0.6rem;
    font-size: 0.85rem;
    background: transparent;
  }

  .ms-buscar button {
    width: 40px;
    display: grid;
    place-items: center;
    color: var(--ms-rojo);
  }

  .ms-hdr__acc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .ms-hdr__ico {
    position: relative;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    color: var(--ms-negro);
  }

  .ms-hdr__ico:hover {
    color: var(--ms-rojo);
  }

  .ms-hdr__badge[hidden] {
    display: none;
  }

  .ms-hdr__badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 50%;
    background: var(--ms-verde);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .ms-nav {
    background: var(--ms-rojo);
    position: relative;
  }

  .ms-nav__row {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-block: 0.7rem;
    flex-wrap: wrap;
  }

  .ms-nav__item,
  .ms-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .ms-nav__item:hover,
  .ms-nav__link:hover,
  .ms-nav__item.is-on {
    color: var(--ms-crema);
  }

  .ms-nav__item--dest {
    color: #ffe27a;
  }

  .ms-mega[hidden] {
    display: none;
  }

  .ms-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
    z-index: 90;
  }

  .ms-mega__panel[hidden] {
    display: none;
  }

  .ms-mega__panel {
    padding-block: 1.75rem;
  }

  .ms-mega__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.5rem;
  }

  .ms-mega__col h3 {
    color: var(--ms-rojo);
    font-size: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .ms-mega__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ms-mega__col a {
    font-size: 0.82rem;
    color: var(--ms-texto);
  }

  .ms-mega__col a:hover {
    color: var(--ms-rojo);
  }

  .ms-mega__marcas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1rem;
  }

  .ms-mega__marca-chip {
    background: var(--ms-fondo);
    border-radius: 8px;
    padding: 1rem;
    text-align: center;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ms-negro);
  }

  .ms-mega-overlay[hidden] {
    display: none;
  }

  .ms-mega-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 80;
  }

  .ms-cart-overlay[hidden] {
    display: none;
  }

  .ms-cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 140;
  }

  .ms-cart[hidden] {
    display: none;
  }

  .ms-cart {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(400px, 92vw);
    background: #fff;
    z-index: 150;
    display: flex;
    flex-direction: column;
    box-shadow: -20px 0 40px -20px rgba(0, 0, 0, 0.5);
  }

  .ms-cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--ms-linea);
  }

  .ms-cart__head small {
    font-size: 0.75rem;
    color: var(--ms-gris);
    font-weight: 600;
  }

  .ms-cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ms-cart__vacio[hidden] {
    display: none;
  }

  .ms-cart__vacio {
    color: var(--ms-gris);
    font-size: 0.88rem;
  }

  .ms-cart__foot {
    border-top: 1px solid var(--ms-linea);
    padding: 1.25rem 1.5rem;
  }

  .ms-cart__total {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .ms-buscar {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
    .ms-hdr__row {
      flex-wrap: wrap;
    }
    .ms-nav__row {
      gap: 1rem;
    }
  }
</style>
