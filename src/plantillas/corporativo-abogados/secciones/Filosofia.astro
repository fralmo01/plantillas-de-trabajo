---
import { manifiesto } from '../datos/firma.js';
---

<section class="ca-philo" id="filosofia">
  <div class="ca-wrap">
    <p class="ca-eyebrow ca-philo__eyebrow">Filosofía</p>
    <h2 class="ca-h ca-philo__h">Tres principios, sin excepciones</h2>
    <div class="ca-philo__grid">
      {
        manifiesto.map((m, i) => (
          <article class="ca-philo__card">
            <span class="ca-philo__i">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ca-philo {
    background: var(--ca-dark);
    color: var(--ca-parch);
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .ca-philo__eyebrow {
    color: var(--ca-gold);
  }

  .ca-philo__h {
    color: var(--ca-parch);
  }

  .ca-philo__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .ca-philo__card h3 {
    color: var(--ca-parch);
    font-size: 1.4rem;
    margin: 0.75rem 0 0.5rem;
  }

  .ca-philo__i {
    font-family: var(--ca-serif);
    font-size: 1rem;
    color: var(--ca-gold);
  }

  .ca-philo__card p {
    color: rgba(253, 252, 249, 0.68);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .ca-philo__grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
