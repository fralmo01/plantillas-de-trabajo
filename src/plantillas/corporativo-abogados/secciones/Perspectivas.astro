---
import { perspectivas } from '../datos/firma.js';
---

<section class="ca-insights" id="perspectivas">
  <div class="ca-wrap">
    <p class="ca-eyebrow">Perspectivas</p>
    <h2 class="ca-h">Lo que estamos leyendo del mercado</h2>

    <div class="ca-ins__grid">
      {
        perspectivas.map((p) => (
          <article class="ca-ins">
            <div class="ca-ins__media">
              <img src={p.img} alt={p.titulo} loading="lazy" />
            </div>
            <p class="ca-ins__meta">{p.fecha} · {p.tag}</p>
            <h3>{p.titulo}</h3>
            <p class="ca-ins__ex">{p.extracto}</p>
            <a href="#" class="ca-ins__leer">Leer artículo →</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ca-insights {
    background: var(--ca-panel);
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }

  .ca-ins__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem;
    margin-top: 2.5rem;
  }

  .ca-ins__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .ca-ins__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4);
    transition: transform 0.3s ease;
  }

  .ca-ins:hover .ca-ins__media img {
    transform: scale(1.04);
  }

  .ca-ins__meta {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ca-bronze);
  }

  .ca-ins h3 {
    font-size: 1.25rem;
    margin: 0.4rem 0 0.5rem;
  }

  .ca-ins__ex {
    font-size: 0.86rem;
    color: rgba(26, 26, 26, 0.7);
  }

  .ca-ins__leer {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .ca-ins__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
