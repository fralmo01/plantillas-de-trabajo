---
import { firma } from '../datos/firma.js';
const anio = new Date().getFullYear();
const cols = [
  { titulo: 'Firma', enlaces: ['Disciplinas', 'La sociedad', 'Perspectivas', 'Trabaja con nosotros'] },
  { titulo: 'Recursos', enlaces: ['Portal de clientes', 'Newsletter', 'Prensa', 'Libro de reclamaciones'] },
  { titulo: 'Legal', enlaces: ['Aviso de privacidad', 'Términos de uso', 'Política de cookies'] },
];
---

<footer class="ca-ftr">
  <div class="ca-wrap ca-ftr__grid">
    <div>
      <span class="ca-ftr__brand">{firma.nombre}</span>
      <p class="ca-ftr__lead">{firma.claim} Estudio jurídico independiente desde {firma.fundacion}.</p>
    </div>
    {
      cols.map((c) => (
        <div>
          <h4>{c.titulo}</h4>
          <ul>
            {c.enlaces.map((e) => (
              <li>
                <a href="#">{e}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="ca-ftr__legal">Maqueta de referencia (demo). Contenido ilustrativo, no constituye asesoría legal. © {anio} {firma.nombre}</p>
</footer>

<style>
  .ca-ftr {
    border-top: 1px solid var(--ca-line);
    padding-block: 3rem 1.5rem;
  }

  .ca-ftr__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2rem;
  }

  .ca-ftr__brand {
    font-family: var(--ca-serif);
    font-size: 1.3rem;
  }

  .ca-ftr__lead {
    font-size: 0.82rem;
    color: rgba(26, 26, 26, 0.62);
    max-width: 340px;
    margin-top: 0.75rem;
  }

  .ca-ftr h4 {
    font-family: var(--ca-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ca-bronze);
    margin-bottom: 0.75rem;
  }

  .ca-ftr ul {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .ca-ftr a {
    font-size: 0.82rem;
  }

  .ca-ftr a:hover {
    color: var(--ca-bronze);
  }

  .ca-ftr__legal {
    text-align: center;
    font-size: 0.7rem;
    color: rgba(26, 26, 26, 0.45);
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ca-line-soft);
  }

  @media (max-width: 820px) {
    .ca-ftr__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .ca-ftr__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
