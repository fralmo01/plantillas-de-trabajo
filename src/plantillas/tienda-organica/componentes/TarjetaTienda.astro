---
import { getOrganaImg } from "../datos/organica.js";

interface Tienda {
  nombre: string;
  grupo: string;
  direccion: string;
  telefono: string;
  horario: string;
  seed: string;
  img?: string;
}
const { tienda } = Astro.props as { tienda: Tienda };
---

<article class="or-tienda" data-grupo={tienda.grupo}>
  <div class="or-tienda__foto">
    <span class="or-tienda__nombre">{tienda.nombre}</span>
    <img
      src={tienda.img ?? getOrganaImg(tienda.seed, 600, 400)}
      alt={tienda.nombre}
      loading="lazy"
    />
  </div>
  <div class="or-tienda__body">
    <p>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        ><path d="M18 10c0 5-6 11-6 11S6 15 6 10a6 6 0 1 1 12 0Z"></path><circle
          cx="12"
          cy="10"
          r="2"></circle></svg
      >
      {tienda.direccion}
    </p>
    <p>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        ><path
          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c1 .4 2 .6 3 .7a2 2 0 0 1 1.7 2Z"
        ></path></svg
      >
      {tienda.telefono}
    </p>
    <p>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"
        ></path></svg
      >
      {tienda.horario}
    </p>
    <div class="or-tienda__btns">
      <a href="#top" class="or-btn or-btn--verde">Ver en Google Maps</a>
      <a href="#top" class="or-btn or-btn--outline">Ver en Waze</a>
    </div>
  </div>
</article>

<style>
  .or-tienda[hidden] {
    display: none;
  }

  .or-tienda {
    border: 1px solid var(--or-linea);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
  }

  .or-tienda__foto {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .or-tienda__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .or-tienda__nombre {
    position: absolute;
    top: 0.75rem;
    left: 0;
    background: var(--or-verde);
    color: #fff;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.4rem 0.8rem;
    border-radius: 0 6px 6px 0;
    z-index: 1;
  }

  .or-tienda__body {
    padding: 1rem 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .or-tienda__body p {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--or-tinta);
  }

  .or-tienda__body svg {
    color: var(--or-verde);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .or-tienda__btns {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .or-tienda__btns .or-btn {
    flex: 1;
    font-size: 0.75rem;
    padding: 0.6rem 1rem;
  }
</style>
