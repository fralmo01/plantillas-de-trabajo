---
import { soles, getOrganaImg } from '../datos/organica.js';

interface Producto {
  nombre: string;
  precio: number;
  antes?: number;
  tag?: string;
  seed: string;
  img?: string;
}
const { producto } = Astro.props as { producto: Producto };
const img = producto.img ?? getOrganaImg(producto.seed, 360, 360);
---

<article class="or-prod" data-nombre={producto.nombre.toLowerCase()}>
  <div class="or-prod__media">
    {producto.tag && <span class="or-prod__tag">{producto.tag}</span>}
    <button type="button" class="or-prod__fav" aria-label="Agregar a favoritos">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.35-9.5-8.5C.8 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.2 4 3.5 7.5C19 16.65 12 21 12 21z"></path></svg>
    </button>
    <img src={img} alt={producto.nombre} loading="lazy" decoding="async" />
  </div>
  <div class="or-prod__body">
    <h3 class="or-prod__nombre">{producto.nombre}</h3>
    <p class="or-prod__precio">
      <b>{soles(producto.precio)}</b>
      {producto.antes && <s>{soles(producto.antes)}</s>}
    </p>
    <div class="or-prod__entrega">
      <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8 6 6 9 6 12a6 6 0 0 0 12 0c0-3-2-6-6-10z"></path></svg> Delivery</span>
      <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8"></path><path d="M5 10v10h14V10"></path></svg> Recojo en tienda</span>
    </div>
    <button type="button" class="or-btn or-btn--verde or-prod__add">Agregar al carrito</button>
  </div>
</article>

<style>
  .or-prod {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--or-linea);
    border-radius: 10px;
    overflow: hidden;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .or-prod:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -22px rgba(0, 0, 0, 0.3);
  }

  .or-prod__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--or-verde-claro);
  }

  .or-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .or-prod__tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--or-rojo);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .or-prod__fav {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--or-gris);
  }

  .or-prod__fav:hover {
    color: var(--or-rojo);
  }

  .or-prod__body {
    padding: 0.85rem 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .or-prod__nombre {
    font-size: 0.82rem;
    font-weight: 600;
    min-height: 2.3em;
  }

  .or-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .or-prod__precio b {
    color: var(--or-verde-osc);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .or-prod__precio s {
    color: var(--or-gris);
    font-size: 0.78rem;
  }

  .or-prod__entrega {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.68rem;
    color: var(--or-gris);
  }

  .or-prod__entrega span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--or-verde-osc);
  }

  .or-prod__add {
    margin-top: auto;
    width: 100%;
  }

  .or-prod__add.is-ok {
    background: var(--or-verde-osc);
  }
</style>
