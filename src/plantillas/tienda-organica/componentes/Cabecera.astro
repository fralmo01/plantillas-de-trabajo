---
import { marca } from '../datos/organica.js';

const base = '/plantillas/tienda-organica';
---

<header class="or-hdr" id="top">
  <div class="or-wrap or-hdr__row">
    <a href={`${base}/`} class="or-logo" aria-label={`${marca.nombre} ${marca.sub}`}>
      <span class="or-logo__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c4 0 8 3 8 8 0 6-8 12-8 12S4 16 4 10c0-5 4-8 8-8Zm0 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"></path></svg>
      </span>
      <span class="or-logo__tx">{marca.nombre}<b>{marca.sub}</b></span>
    </a>

    <form class="or-buscar" id="or-buscar" role="search" action={`${base}/buscar/`} method="get">
      <input type="search" name="q" id="or-buscar-input" placeholder="Que estas buscando hoy?" aria-label="Buscar productos" autocomplete="off" />
      <button type="submit" aria-label="Buscar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </form>

    <div class="or-hdr__contacto">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10c0 5-6 11-6 11S6 15 6 10a6 6 0 1 1 12 0Z"></path><circle cx="12" cy="10" r="2"></circle></svg>
      <div>
        <strong>{marca.tel}</strong>
        <span>Solo WhatsApp - Atencion 9AM-6PM</span>
      </div>
    </div>

    <div class="or-hdr__envios">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h13v10H3zM16 10h4l1 3v4h-5"></path><circle cx="7" cy="18" r="1.6"></circle><circle cx="17.5" cy="18" r="1.6"></circle></svg>
      <div>
        <strong>Envios</strong>
        <span>Delivery para todo el Peru</span>
      </div>
    </div>

    <div class="or-hdr__acc">
      <a href="#top" class="or-hdr__ico" aria-label="Mi cuenta">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
      </a>
      <a href="#top" class="or-hdr__ico" aria-label="Favoritos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.35-9.5-8.5C.8 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.2 4 3.5 7.5C19 16.65 12 21 12 21z"></path></svg>
      </a>
      <button type="button" class="or-hdr__ico or-hdr__cart" id="or-cart" aria-label="Ver carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"></path><path d="M6 6 5 3H2"></path><circle cx="9" cy="20" r="1.6"></circle><circle cx="18" cy="20" r="1.6"></circle></svg>
        <span class="or-hdr__badge" id="or-cart-count" hidden>0</span>
      </button>
    </div>
  </div>
</header>

<script>
  const input = document.getElementById('or-buscar-input') as HTMLInputElement | null;
  const qActual = new URLSearchParams(location.search).get('q');
  if (input && qActual) input.value = qActual;

  const badge = document.getElementById('or-cart-count');
  let total = 0;

  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const fav = el.closest<HTMLButtonElement>('.or-prod__fav');
    if (fav) {
      fav.classList.toggle('is-on');
      return;
    }
    const add = el.closest<HTMLButtonElement>('.or-prod__add');
    if (add) {
      total += 1;
      if (badge) {
        badge.textContent = String(total);
        badge.hidden = false;
      }
      const prev = add.textContent;
      add.textContent = 'Agregado!';
      add.classList.add('is-ok');
      window.setTimeout(() => {
        add.textContent = prev;
        add.classList.remove('is-ok');
      }, 1100);
    }
  });
</script>

<style>
  .or-hdr {
    background: #fff;
    border-bottom: 1px solid var(--or-linea);
    position: sticky;
    top: 0;
    z-index: 80;
  }

  .or-hdr__row {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: 0.85rem;
  }

  .or-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .or-logo__ico {
    width: 1.9rem;
    height: 1.9rem;
    color: var(--or-verde);
  }

  .or-logo__ico svg {
    width: 100%;
    height: 100%;
  }

  .or-logo__tx {
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--or-verde);
    line-height: 1;
  }

  .or-logo__tx b {
    display: block;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--or-gris);
    margin-top: 0.1rem;
  }

  .or-buscar {
    flex: 1;
    max-width: 420px;
    display: flex;
    align-items: center;
    border: 1.5px solid var(--or-linea);
    border-radius: 8px;
    padding: 0.1rem 0.1rem 0.1rem 0.9rem;
  }

  .or-buscar:focus-within {
    border-color: var(--or-verde);
  }

  .or-buscar input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    padding: 0.55rem 0;
    font-size: 0.82rem;
  }

  .or-buscar button {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: var(--or-verde);
    color: #fff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .or-hdr__contacto,
  .or-hdr__envios {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--or-verde);
    flex-shrink: 0;
  }

  .or-hdr__contacto div,
  .or-hdr__envios div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .or-hdr__contacto strong,
  .or-hdr__envios strong {
    font-size: 0.8rem;
    color: var(--or-tinta);
  }

  .or-hdr__contacto span,
  .or-hdr__envios span {
    font-size: 0.65rem;
    color: var(--or-gris);
  }

  .or-hdr__acc {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  .or-hdr__ico {
    position: relative;
    color: var(--or-tinta);
    display: grid;
    place-items: center;
  }

  .or-hdr__ico:hover {
    color: var(--or-verde);
  }

  .or-hdr__badge[hidden] {
    display: none;
  }

  .or-hdr__badge {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--or-pill);
    background: var(--or-rojo);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  @media (max-width: 1100px) {
    .or-hdr__contacto,
    .or-hdr__envios {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .or-buscar {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
    .or-hdr__row {
      flex-wrap: wrap;
    }
  }
</style>
