---
import MarcoTienda from '../componentes/MarcoTienda.astro';
import { marca } from '../datos/organica.js';

export const titulo = 'Contacto | tienda.com Natural';
export const descripcion = 'Escribenos y te responderemos a la brevedad.';
---

<MarcoTienda activo="Contacto">
  <section class="or-seccion or-wrap or-contacto">
    <div class="or-tiendas-hero__banner">
      <h1>Contactanos</h1>
    </div>

    <div class="or-contacto__grid">
      <form class="or-contacto__form" onsubmit="return false">
        <label>Nombre<input type="text" placeholder="Tu nombre" /></label>
        <label>Correo<input type="email" placeholder="tu@correo.com" /></label>
        <label>Mensaje<textarea rows="5" placeholder="Escribe tu consulta..."></textarea></label>
        <button type="submit" class="or-btn or-btn--verde">Enviar mensaje</button>
      </form>
      <div class="or-contacto__info">
        <h3>Otras formas de contacto</h3>
        <p><b>Telefono:</b> {marca.tel}</p>
        <p><b>Correo:</b> {marca.correo}</p>
        <p><b>Atencion:</b> Solo WhatsApp, 9AM - 6PM</p>
      </div>
    </div>
  </section>
</MarcoTienda>

<style>
  .or-tiendas-hero__banner {
    background: var(--or-verde);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .or-tiendas-hero__banner h1 {
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .or-contacto__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
  }

  .or-contacto__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .or-contacto__form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .or-contacto__form input,
  .or-contacto__form textarea {
    border: 1.5px solid var(--or-linea);
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    font-size: 0.85rem;
    font-family: inherit;
  }

  .or-contacto__form input:focus,
  .or-contacto__form textarea:focus {
    outline: none;
    border-color: var(--or-verde);
  }

  .or-contacto__form button {
    align-self: flex-start;
  }

  .or-contacto__info {
    background: var(--or-verde-claro);
    border-radius: 12px;
    padding: 1.5rem;
    height: fit-content;
  }

  .or-contacto__info h3 {
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .or-contacto__info p {
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
    color: var(--or-gris);
  }

  @media (max-width: 700px) {
    .or-contacto__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
