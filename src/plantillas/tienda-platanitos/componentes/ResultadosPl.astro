---
import FiltrosPl from './FiltrosPl.astro';
import TarjetaProducto from './TarjetaProducto.astro';
import { productosOrdenados, sugerencias, ordenarPor } from '../datos/productos.js';

const base = '/plantillas/tienda-platanitos';

const norm = (s: unknown) =>
  (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const conHeno = productosOrdenados.map((p) => ({
  p,
  heno: norm([p.nombre, p.marca, p.cat, p.v, ...(p.tags ?? [])].join(' ')),
}));
---

<section class="pl-res pl-seccion">
  <div class="pl-contenedor">
    <div class="pl-res__top">
      <p class="pl-res__para">Resultados para <b id="pl-q">…</b></p>
      <label class="pl-res__orden">
        <span class="visually">Ordenar por</span>
        <select>
          {ordenarPor.map((o: string) => <option>{o}</option>)}
        </select>
      </label>
    </div>

    <div class="pl-res__layout">
      <button class="pl-res__toggle" type="button" id="pl-toggle-filtros">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6" /><line x1="7" y1="12" x2="17" y2="12" /><line x1="10" y1="18" x2="14" y2="18" />
        </svg>
        Filtrar
      </button>

      <FiltrosPl />

      <div class="pl-res__wrap">
        <p class="pl-res__conteo"><span id="pl-n">0</span> productos</p>

        <div class="pl-res__vacio" id="pl-vacio" hidden>
          <p>No hay resultados para <b id="pl-q2"></b>.</p>
          <p class="pl-res__prueba">Prueba con:</p>
          <div class="pl-res__sugs">
            {
              sugerencias.map((s) => (
                <a href={`${base}/buscar/?q=${encodeURIComponent(s)}`} class="pl-res__chip">
                  {s}
                </a>
              ))
            }
          </div>
        </div>

        <div class="pl-res__grid" id="pl-grid">
          {
            conHeno.map(({ p, heno }) => (
              <div data-buscable data-heno={heno}>
                <TarjetaProducto producto={p} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const norm = (s: string) =>
    (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const termino = (new URLSearchParams(location.search).get('q') ?? '').trim();
  const palabras = norm(termino).split(/\s+/).filter(Boolean);
  const $ = (id: string) => document.getElementById(id);

  if ($('pl-q')) $('pl-q')!.textContent = termino ? `“${termino}”` : '(vacío)';
  if ($('pl-q2')) $('pl-q2')!.textContent = `“${termino}”`;

  
  const coincide = (heno: string, w: string) =>
    heno.includes(w) || heno.includes(w.replace(/s$/, ''));

  let visibles = 0;
  for (const it of document.querySelectorAll<HTMLElement>('[data-buscable]')) {
    const heno = it.dataset.heno ?? '';
    const ok = palabras.length > 0 && palabras.every((w) => coincide(heno, w));
    it.hidden = !ok;
    if (ok) visibles++;
  }
  if ($('pl-n')) $('pl-n')!.textContent = String(visibles);
  if ($('pl-vacio')) ($('pl-vacio') as HTMLElement).hidden = visibles > 0;
  if ($('pl-grid')) ($('pl-grid') as HTMLElement).hidden = visibles === 0;

  const inputCab = document.querySelector<HTMLInputElement>('.pl-buscador input');
  if (inputCab && termino) inputCab.value = termino;

  const panel = document.getElementById('pl-filtros');
  document.getElementById('pl-toggle-filtros')?.addEventListener('click', () =>
    panel?.classList.toggle('is-abierto'),
  );
  panel?.querySelectorAll('.pl-filtros__x, [data-cerrar-filtros]').forEach((b) =>
    b.addEventListener('click', () => panel?.classList.remove('is-abierto')),
  );
</script>

<style>
  .pl-res__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--pl-gris-borde);
    margin-bottom: 1.25rem;
  }

  .pl-res__para {
    font-size: 0.95rem;
  }

  .pl-res__orden {
    margin-left: auto;
  }

  .pl-res__orden select {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.45rem 2rem 0.45rem 0.9rem;
    border: 1px solid var(--pl-gris-borde);
    border-radius: 8px;
    background: var(--pl-blanco);
    cursor: pointer;
  }

  .pl-res__layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }

  .pl-res__toggle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--pl-gris-borde);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .pl-res__conteo {
    font-size: 0.8rem;
    color: var(--pl-gris-texto);
    margin-bottom: 1rem;
  }

  .pl-res__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }

  .pl-res__vacio {
    border: 1px dashed var(--pl-gris-borde);
    border-radius: var(--pl-radio);
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .pl-res__prueba {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  .pl-res__sugs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.75rem;
  }

  .pl-res__chip {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--pl-gris-borde);
    border-radius: 999px;
    background: var(--pl-blanco);
  }

  @media (max-width: 1100px) {
    .pl-res__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .pl-res__layout {
      grid-template-columns: 1fr;
    }
    .pl-res__toggle {
      display: inline-flex;
    }
    :global(.pl-filtros) {
      position: fixed;
      inset: 0 25% 0 0;
      z-index: 350;
      background: var(--pl-blanco);
      padding: 1.25rem;
      overflow-y: auto;
      transform: translateX(-105%);
      transition: transform 0.25s ease;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.25);
    }
    :global(.pl-filtros.is-abierto) {
      transform: none;
    }
    :global(.pl-filtros__x) {
      display: block !important;
    }
  }

  @media (max-width: 680px) {
    .pl-res__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
