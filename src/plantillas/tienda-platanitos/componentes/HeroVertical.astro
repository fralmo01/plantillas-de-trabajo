---
import { contenidoVertical } from '../datos/verticales.js';

const { vertical = 'moda' } = Astro.props as { vertical?: string };
const cv = contenidoVertical as Record<string, any>;
const c = cv[vertical] ?? contenidoVertical.moda;
---

<section class="pl-seccion">
  <div class="pl-contenedor">
    <div class="pl-hero">
      <img src={`https://picsum.photos/seed/pl-hero-${vertical}/1400/520`} alt="" loading="eager" />
      <span class="pl-badge pl-badge--rosa pl-hero__newin">NewIn</span>
      <div class="pl-hero__texto">
        <span class="pl-hero__kicker">{c.heroKicker}</span>
        <p class="pl-hero__frase">
          <span class="pl-hero__pill">{c.heroTitulo} <b aria-hidden="true">❤</b></span>
          <em>{c.heroPalabra}</em>
        </p>
        <a href="/plantillas/tienda-platanitos/buscar/?q=zapatillas" class="pl-btn pl-btn--lima pl-hero__cta">
          Ver todo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
        </a>
      </div>
      <span class="pl-hero__logo" aria-hidden="true">🍃 tienda.com</span>
    </div>
  </div>
</section>

<style>
  .pl-hero {
    position: relative;
    border-radius: var(--pl-radio);
    overflow: hidden;
    min-height: clamp(260px, 34vw, 460px);
    background: var(--pl-crema);
    isolation: isolate;
  }

  .pl-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    filter: brightness(0.98) saturate(0.95);
  }

  .pl-hero__newin {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    font-size: 1rem;
    padding: 0.35rem 1.1rem;
    font-style: italic;
  }

  .pl-hero__texto {
    position: absolute;
    left: clamp(1.25rem, 5vw, 4rem);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .pl-hero__kicker {
    font-style: italic;
    font-weight: 700;
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    color: var(--pl-tinta);
  }

  .pl-hero__frase {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.4rem, 4vw, 2.6rem);
  }

  .pl-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--pl-verde);
    color: #fff;
    border-radius: var(--pl-radio-pill);
    padding: 0.1rem 0.9rem;
    font-weight: 800;
  }

  .pl-hero__pill b {
    font-size: 0.8em;
  }

  .pl-hero__frase em {
    font-style: italic;
    font-weight: 700;
  }

  .pl-hero__cta {
    padding: 0.7rem 1.5rem;
    font-size: 0.95rem;
  }

  .pl-hero__logo {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: var(--pl-blanco);
    border-radius: var(--pl-radio-pill);
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--pl-verde-osc);
  }

  @media (max-width: 640px) {
    .pl-hero__texto {
      right: 1.25rem;
    }
  }
</style>
