---
import { verticales } from '../datos/verticales.js';
const anio = new Date().getFullYear();

const cols = [
  { titulo: 'Ayuda', enlaces: ['Centro de ayuda', 'Cómo comprar', 'Envíos y entregas', 'Cambios y devoluciones', 'Libro de reclamaciones'] },
  { titulo: 'Nosotros', enlaces: ['Quiénes somos', 'Trabaja con nosotros', 'Tiendas físicas', 'Vende en tienda.com', 'Blog'] },
  { titulo: 'Legal', enlaces: ['Términos y condiciones', 'Políticas de privacidad', 'Política de cookies', 'Bases legales'] },
];
---

<footer class="pl-pie">
  <div class="pl-contenedor pl-pie__grid">
    {
      cols.map((c) => (
        <div class="pl-pie__col">
          <h4>{c.titulo}</h4>
          <ul>
            {c.enlaces.map((e) => (
              <li>
                <a href="#">{e}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="pl-pie__col">
      <h4>Verticales</h4>
      <ul>
        {verticales.map((v) => (
          <li>
            <a href={v.href}>{v.etiqueta}</a>
          </li>
        ))}
      </ul>
      <h4 style="margin-top:1.1rem">Pagos</h4>
      <div class="pl-pie__pagos">
        <span>Visa</span><span>Mastercard</span><span>Yape</span><span>PagoEfectivo</span>
      </div>
    </div>
  </div>

  <p class="pl-pie__legal">
    Maqueta de referencia (demo). Sin funciones reales de cuenta ni pago. © {anio} tienda.com
  </p>
</footer>

<style>
  .pl-pie {
    background: var(--pl-gris-bg);
    border-top: 1px solid var(--pl-gris-borde);
    padding-block: 2.5rem 1.5rem;
  }

  .pl-pie__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .pl-pie__col h4 {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .pl-pie__col ul {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .pl-pie__col a {
    font-size: 0.8rem;
    color: var(--pl-gris-texto);
  }

  .pl-pie__col a:hover {
    color: var(--pl-verde-osc);
  }

  .pl-pie__pagos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pl-pie__pagos span {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--pl-gris-borde);
    border-radius: 4px;
    background: var(--pl-blanco);
  }

  .pl-pie__legal {
    text-align: center;
    font-size: 0.72rem;
    color: var(--pl-gris-texto);
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .pl-pie__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .pl-pie__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
