---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import TiraMarcas from './secciones/TiraMarcas.astro';
import Novedades from './secciones/Novedades.astro';
import Destacados from './secciones/Destacados.astro';
import CategoriasBanner from './secciones/CategoriasBanner.astro';
import MarcaDestacada from './secciones/MarcaDestacada.astro';
import ColeccionSillas from './secciones/ColeccionSillas.astro';
import CapasBanner from './secciones/CapasBanner.astro';
import Newsletter from './secciones/Newsletter.astro';
import Instagram from './secciones/Instagram.astro';
import Beneficios from './secciones/Beneficios.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-tienda-barberia">
  <BarraSuperior />
  <Cabecera />
  <main>
    <HeroCarrusel />
    <TiraMarcas />
    <Novedades />
    <Destacados />
    <CategoriasBanner />
    <MarcaDestacada />
    <ColeccionSillas />
    <CapasBanner />
    <Newsletter />
    <Instagram />
  </main>
  <Beneficios />
  <PiePagina />
  <ChatBot />
</div>
