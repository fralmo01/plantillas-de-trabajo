---
import { coleccionSillas } from '../datos/barberia.js';

const modelos = coleccionSillas.modelos as string[];
---

<section class="tb-sillas">
  <img src={coleccionSillas.img} alt={coleccionSillas.titulo} loading="lazy" class="tb-sillas__bg" />
  <div class="tb-sillas__overlay"></div>
  <div class="tb-wrap tb-sillas__inner">
    <ul class="tb-sillas__modelos">
      {modelos.map((m: string) => <li>{m}</li>)}
    </ul>
    <a href="#destacados" class="tb-btn tb-btn--dorado">{coleccionSillas.cta}</a>
  </div>
</section>

<style>
  .tb-sillas {
    position: relative;
    min-height: clamp(260px, 34vw, 420px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .tb-sillas__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tb-sillas__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(12, 8, 2, 0.9), rgba(12, 8, 2, 0.5));
  }

  .tb-sillas__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .tb-sillas__modelos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 3rem);
  }

  .tb-sillas__modelos li {
    font-family: var(--tb-titulos);
    font-size: clamp(1.1rem, 2.6vw, 1.8rem);
    letter-spacing: 0.18em;
    color: #fff;
  }
</style>
