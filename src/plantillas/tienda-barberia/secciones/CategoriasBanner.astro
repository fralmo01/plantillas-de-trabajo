---
import { categoriasBanner } from '../datos/barberia.js';
---

<section class="tb-catban">
  {categoriasBanner.map((c: { t: string; sub: string; img: string }) => (
    <a href="#novedades" class="tb-catban__item">
      <img src={c.img} alt={c.t} loading="lazy" />
      <div class="tb-catban__tx">
        <span>{c.sub}</span>
        <b>{c.t}</b>
        <em>Comprar</em>
      </div>
    </a>
  ))}
</section>

<style>
  .tb-catban {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .tb-catban__item {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    display: block;
  }

  .tb-catban__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55);
    transition: transform 0.4s ease, filter 0.3s ease;
  }

  .tb-catban__item:hover img {
    transform: scale(1.06);
    filter: brightness(0.4);
  }

  .tb-catban__tx {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    gap: 0.35rem;
  }

  .tb-catban__tx span {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-dorado);
  }

  .tb-catban__tx b {
    font-family: var(--tb-titulos);
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.03em;
  }

  .tb-catban__tx em {
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .tb-catban__item:hover .tb-catban__tx em {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 720px) {
    .tb-catban {
      grid-template-columns: 1fr;
    }
  }
</style>
