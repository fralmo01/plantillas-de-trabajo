---
import { marcaDestacada, soles } from '../datos/barberia.js';

interface MiniProd { nombre: string; precio: number; img: string }
const productos = marcaDestacada.productos as MiniProd[];
---

<section class="tb-seccion tb-wrap">
  <div class="tb-spot">
    <div class="tb-spot__img">
      <img src={marcaDestacada.img} alt={marcaDestacada.titulo} loading="lazy" />
      <div class="tb-spot__tx">
        <span>{marcaDestacada.sub}</span>
        <a href="#novedades" class="tb-btn tb-btn--dorado">{marcaDestacada.cta}</a>
      </div>
    </div>
    <div class="tb-spot__prods">
      <h2 class="tb-titulo">{marcaDestacada.titulo}</h2>
      <div class="tb-spot__list">
        {productos.map((p) => (
          <div class="tb-spot__prod">
            <img src={p.img} alt={p.nombre} loading="lazy" />
            <div>
              <b>{p.nombre}</b>
              <span>{soles(p.precio)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tb-spot {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: stretch;
  }

  .tb-spot__img {
    position: relative;
    min-height: 380px;
    overflow: hidden;
  }

  .tb-spot__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tb-spot__tx {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.85), transparent 70%);
  }

  .tb-spot__tx span {
    color: #fff;
    text-transform: none;
    font-size: 0.9rem;
    max-width: 32ch;
  }

  .tb-spot__prods {
    display: flex;
    flex-direction: column;
  }

  .tb-spot__prods .tb-titulo {
    margin-bottom: 1.25rem;
  }

  .tb-spot__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tb-spot__prod {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--tb-linea);
    padding-bottom: 1rem;
  }

  .tb-spot__prod img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    background: var(--tb-crema);
    flex-shrink: 0;
  }

  .tb-spot__prod div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tb-spot__prod b {
    font-size: 0.88rem;
  }

  .tb-spot__prod span {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--tb-dorado-osc);
  }

  @media (max-width: 820px) {
    .tb-spot {
      grid-template-columns: 1fr;
    }
    .tb-spot__img {
      min-height: 260px;
    }
  }
</style>
