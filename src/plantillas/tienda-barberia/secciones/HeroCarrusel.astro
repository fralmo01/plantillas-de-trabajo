---
import { heroSlides } from '../datos/barberia.js';
---

<section class="tb-hero" aria-roledescription="carrusel">
  <div class="tb-hero__track" id="tb-hero-track">
    {heroSlides.map((s: { tema: string; kicker: string; titulo: string; sub: string; cta: string; img: string }) => (
      <article class={`tb-hero__slide tb-hero__slide--${s.tema}`}>
        <div class="tb-wrap tb-hero__inner">
          <div class="tb-hero__tx">
            <span class="tb-hero__kicker">{s.kicker}</span>
            <h2>{s.titulo}</h2>
            <p>{s.sub}</p>
            <a href="#novedades" class="tb-btn tb-btn--claro">{s.cta}</a>
          </div>
          <div class="tb-hero__img">
            <img src={s.img} alt={s.titulo} loading="eager" />
          </div>
        </div>
      </article>
    ))}
  </div>
  <button class="tb-hero__nav tb-hero__nav--prev" id="tb-hero-prev" aria-label="Anterior">&lsaquo;</button>
  <button class="tb-hero__nav tb-hero__nav--next" id="tb-hero-next" aria-label="Siguiente">&rsaquo;</button>
  <div class="tb-hero__dots" id="tb-hero-dots">
    {heroSlides.map((_: unknown, i: number) => <button aria-label={`Ir al slide ${i + 1}`} data-dot={i}></button>)}
  </div>
</section>

<script>
  const track = document.getElementById('tb-hero-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#tb-hero-dots button'));
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }

  document.getElementById('tb-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('tb-hero-next')?.addEventListener('click', () => ir(idx + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => ir(i)));

  let timer = window.setInterval(() => ir(idx + 1), 6000);
  const box = track?.closest('section');
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6000)));
  ir(0);
</script>

<style>
  .tb-hero {
    position: relative;
    overflow: hidden;
  }

  .tb-hero__track {
    display: flex;
    transition: transform 0.5s ease;
  }

  .tb-hero__slide {
    flex: 0 0 100%;
    min-height: clamp(340px, 44vw, 560px);
    display: flex;
    align-items: center;
  }

  .tb-hero__slide--violeta {
    background: radial-gradient(circle at 75% 30%, #a855f7 0%, #4c1d95 45%, #0c0c0c 100%);
  }

  .tb-hero__slide--coral {
    background: radial-gradient(circle at 75% 30%, #fb923c 0%, #d1477a 45%, #1a0b12 100%);
  }

  .tb-hero__slide--ambar {
    background: radial-gradient(circle at 75% 30%, #f5b942 0%, #7c4a12 45%, #0c0c0c 100%);
  }

  .tb-hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  .tb-hero__tx {
    color: #fff;
  }

  .tb-hero__kicker {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    border: 1px solid rgba(255, 255, 255, 0.6);
    padding: 0.3rem 0.8rem;
  }

  .tb-hero__tx h2 {
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin: 0.9rem 0 0.75rem;
  }

  .tb-hero__tx p {
    text-transform: none;
    font-size: clamp(0.88rem, 1.6vw, 1.05rem);
    max-width: 34ch;
    margin-bottom: 1.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .tb-hero__img {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 340px;
    justify-self: end;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .tb-hero__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tb-hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    backdrop-filter: blur(4px);
  }

  .tb-hero__nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .tb-hero__nav--prev { left: 1rem; }
  .tb-hero__nav--next { right: 1rem; }

  .tb-hero__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .tb-hero__dots button {
    width: 26px;
    height: 3px;
    background: rgba(255, 255, 255, 0.4);
  }

  .tb-hero__dots button.is-on {
    background: var(--tb-dorado);
  }

  @media (max-width: 780px) {
    .tb-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .tb-hero__img {
      justify-self: center;
      max-width: 220px;
    }
    .tb-hero__tx p {
      margin-inline: auto;
    }
  }
</style>
