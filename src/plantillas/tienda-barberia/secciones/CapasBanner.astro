---
import { capasBanner } from '../datos/barberia.js';
---

<section class="tb-capas">
  <img src={capasBanner.img} alt={capasBanner.titulo} loading="lazy" class="tb-capas__bg" />
  <div class="tb-capas__overlay"></div>
  <div class="tb-wrap tb-capas__inner">
    <h2>{capasBanner.titulo}</h2>
    <p>{capasBanner.sub}</p>
    <a href="#destacados" class="tb-btn tb-btn--claro">{capasBanner.cta}</a>
  </div>
</section>

<style>
  .tb-capas {
    position: relative;
    min-height: clamp(280px, 36vw, 440px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .tb-capas__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tb-capas__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(12, 12, 12, 0.85) 0%, rgba(12, 12, 12, 0.35) 60%, transparent 100%);
  }

  .tb-capas__inner {
    position: relative;
    z-index: 1;
    max-width: 30rem;
  }

  .tb-capas__inner h2 {
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 0.75rem;
  }

  .tb-capas__inner p {
    text-transform: none;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
</style>
