---
import { soles } from '../datos/barberia.js';

interface Producto {
  nombre: string;
  precio: number;
  antes?: number;
  tag?: string;
  marca?: string;
  img: string;
}
const { producto } = Astro.props as { producto: Producto };
---

<article class="tb-prod" data-nombre={producto.nombre.toLowerCase()} data-precio={producto.precio}>
  <div class="tb-prod__media">
    {producto.tag && <span class="tb-prod__tag">{producto.tag}</span>}
    <img src={producto.img} alt={producto.nombre} loading="lazy" decoding="async" />
  </div>
  <div class="tb-prod__body">
    {producto.marca && <span class="tb-prod__marca">{producto.marca}</span>}
    <h3 class="tb-prod__nombre">{producto.nombre}</h3>
    <p class="tb-prod__precio">
      <b>{soles(producto.precio)}</b>
      {producto.antes && <s>{soles(producto.antes)}</s>}
    </p>
    <div class="tb-prod__qty" role="group" aria-label="Cantidad">
      <button type="button" class="tb-qty__b" data-step="-1" aria-label="Quitar uno">-</button>
      <span class="tb-qty__n">1</span>
      <button type="button" class="tb-qty__b" data-step="1" aria-label="Agregar uno">+</button>
    </div>
    <button type="button" class="tb-btn tb-btn--negro tb-prod__add">Anadir</button>
  </div>
</article>

<style>
  .tb-prod[hidden] {
    display: none;
  }

  .tb-prod {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--tb-linea);
    overflow: hidden;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .tb-prod:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.45);
  }

  .tb-prod__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--tb-crema);
  }

  .tb-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tb-prod__tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: var(--tb-rojo);
    color: #fff;
    font-family: var(--tb-titulos);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
  }

  .tb-prod__body {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .tb-prod__marca {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--tb-gris);
  }

  .tb-prod__nombre {
    font-family: var(--tb-font);
    text-transform: none;
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 2.4em;
  }

  .tb-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .tb-prod__precio b {
    font-size: 1.05rem;
    font-weight: 800;
  }

  .tb-prod__precio s {
    color: var(--tb-gris);
    font-size: 0.78rem;
  }

  .tb-prod__qty {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.2rem;
  }

  .tb-qty__b {
    width: 26px;
    height: 26px;
    background: var(--tb-crema);
    color: var(--tb-negro);
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
  }

  .tb-qty__b:hover {
    background: var(--tb-dorado);
  }

  .tb-qty__n {
    min-width: 1.4ch;
    text-align: center;
    font-weight: 600;
  }

  .tb-prod__add {
    margin-top: auto;
    width: 100%;
  }

  .tb-prod__add.is-ok {
    background: var(--tb-dorado);
    color: var(--tb-negro);
  }
</style>
