---
import { soles, getWongImg } from '../datos/wong.js';

interface Producto {
  nombre: string;
  precio: number;
  antes?: number;
  tag?: string;
  seed: string;
  img?: string;
}
const { producto } = Astro.props as { producto: Producto };
const img = producto.img ?? getWongImg(producto.seed, 360, 360);
---

<article class="wg-prod" data-nombre={producto.nombre.toLowerCase()} data-precio={producto.precio}>
  <div class="wg-prod__media">
    {producto.tag && <span class="wg-prod__tag">{producto.tag}</span>}
    <img src={img} alt={producto.nombre} loading="lazy" decoding="async" />
  </div>
  <div class="wg-prod__body">
    <h3 class="wg-prod__nombre">{producto.nombre}</h3>
    <p class="wg-prod__precio">
      {producto.antes && <s>{soles(producto.antes)}</s>}
      <b>{soles(producto.precio)}</b>
    </p>
    <div class="wg-prod__qty" role="group" aria-label="Cantidad">
      <button type="button" class="wg-qty__b" data-step="-1" aria-label="Quitar uno">-</button>
      <span class="wg-qty__n">1</span>
      <button type="button" class="wg-qty__b" data-step="1" aria-label="Agregar uno">+</button>
    </div>
    <button type="button" class="wg-btn wg-btn--amarillo wg-prod__add">Agregar</button>
  </div>
</article>

<style>
  .wg-prod[hidden] {
    display: none;
  }

  .wg-prod {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--wg-linea);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .wg-prod:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -22px rgba(0, 0, 0, 0.35);
  }

  .wg-prod__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--wg-suave);
  }

  .wg-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wg-prod__tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--wg-rojo);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: var(--wg-pill);
  }

  .wg-prod__body {
    padding: 0.85rem 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .wg-prod__nombre {
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
    min-height: 2.4em;
  }

  .wg-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .wg-prod__precio s {
    color: var(--wg-gris);
    font-size: 0.78rem;
  }

  .wg-prod__precio b {
    color: var(--wg-rojo);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .wg-prod__qty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
  }

  .wg-qty__b {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--wg-suave);
    color: var(--wg-tinta);
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
  }

  .wg-qty__b:hover {
    background: var(--wg-linea);
  }

  .wg-qty__n {
    min-width: 1.4ch;
    text-align: center;
    font-weight: 600;
  }

  .wg-prod__add {
    margin-top: auto;
    width: 100%;
  }

  .wg-prod__add.is-ok {
    background: var(--wg-verde);
    color: #fff;
  }
</style>
