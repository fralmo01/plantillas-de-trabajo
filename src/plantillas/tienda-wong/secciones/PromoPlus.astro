---
import { plusSuscripcion, plusBeneficios, getWongImg } from '../datos/wong.js';
---

<section class="wg-wrap" id="plus">
  <div class="wg-plus">
    <a href="#plus" class="wg-plus__card">
      <img src={plusSuscripcion.img ?? getWongImg(plusSuscripcion.seed, 800, 450)} alt="tienda.com Plus" loading="lazy" />
      <div class="wg-plus__tx">
        <p>{plusSuscripcion.titulo}</p>
        <span class="wg-btn wg-btn--amarillo">{plusSuscripcion.cta}</span>
      </div>
    </a>

    <div class="wg-plus__card wg-plus__card--beneficios">
      <div class="wg-plus__ben-head">
        <b>tienda.com <span>Plus</span></b>
        <span class="wg-plus__kicker">{plusBeneficios.kicker}</span>
      </div>
      <div class="wg-plus__ben-list">
        {plusBeneficios.items.map((b: { nombre: string; dcto: number }) => (
          <div class="wg-plus__ben-item">
            <b>{b.dcto}%</b>
            <span>dcto. en<br />{b.nombre}</span>
          </div>
        ))}
      </div>
      <a href="#plus" class="wg-plus__ben-cta">Descubre mas aqui</a>
    </div>
  </div>
</section>

<style>
  .wg-plus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .wg-plus__card {
    position: relative;
    background: var(--wg-negro);
    border-radius: 14px;
    overflow: hidden;
    min-height: 200px;
    display: block;
  }

  .wg-plus__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .wg-plus__tx {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    color: #fff;
  }

  .wg-plus__tx p {
    font-size: 1.15rem;
    font-weight: 800;
    max-width: 22ch;
  }

  .wg-plus__tx .wg-btn {
    align-self: flex-start;
  }

  .wg-plus__card--beneficios {
    padding: 1.5rem;
    color: #fff;
  }

  .wg-plus__ben-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wg-plus__ben-head b {
    font-size: 1.1rem;
  }

  .wg-plus__ben-head b span {
    color: var(--wg-rosa);
  }

  .wg-plus__kicker {
    background: rgba(255, 255, 255, 0.12);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: var(--wg-pill);
  }

  .wg-plus__ben-list {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .wg-plus__ben-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wg-plus__ben-item b {
    color: var(--wg-rosa);
    font-size: 1.4rem;
  }

  .wg-plus__ben-item span {
    font-size: 0.72rem;
    color: #d9d9d9;
  }

  .wg-plus__ben-cta {
    display: inline-block;
    background: var(--wg-rosa);
    color: #fff;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.55rem 1rem;
    border-radius: var(--wg-pill);
  }

  @media (max-width: 760px) {
    .wg-plus {
      grid-template-columns: 1fr;
    }
  }
</style>
