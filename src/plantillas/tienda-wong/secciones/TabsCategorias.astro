---
import { tabsCategorias, getWongImg } from '../datos/wong.js';
---

<section class="wg-seccion wg-wrap" id="tabs">
  <div class="wg-tabs" id="wg-tabs">
    <div class="wg-tabs__nav" role="tablist">
      {tabsCategorias.map((t: { t: string }, i: number) => (
        <button type="button" class={`wg-tabs__btn${i === 0 ? ' is-on' : ''}`} data-tab={i} role="tab" aria-selected={i === 0}>
          {t.t}
        </button>
      ))}
    </div>
    <div class="wg-tabs__panels">
      {tabsCategorias.map((t: { t: string; items: { t: string; seed: string; img?: string }[] }, i: number) => (
        <div class="wg-tabs__panel" data-panel={i} hidden={i !== 0}>
          {t.items.map((it) => (
            <a href="#" class="wg-tabs__card">
              <img src={it.img ?? getWongImg(it.seed, 400, 300)} alt={it.t} loading="lazy" />
              <span>{it.t}</span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = document.getElementById('wg-tabs');
  const btns = Array.from(tabs?.querySelectorAll<HTMLButtonElement>('.wg-tabs__btn') ?? []);
  const panels = Array.from(tabs?.querySelectorAll<HTMLElement>('.wg-tabs__panel') ?? []);

  btns.forEach((b) => {
    b.addEventListener('click', () => {
      btns.forEach((x) => {
        x.classList.toggle('is-on', x === b);
        x.setAttribute('aria-selected', String(x === b));
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
    });
  });
</script>

<style>
  .wg-tabs__nav {
    display: flex;
    border-bottom: 2px solid var(--wg-linea);
    margin-bottom: 1.5rem;
  }

  .wg-tabs__btn {
    padding: 0.85rem 1.5rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--wg-gris);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
  }

  .wg-tabs__btn.is-on {
    color: var(--wg-tinta);
    background: var(--wg-amarillo);
    border-bottom-color: var(--wg-amarillo);
  }

  .wg-tabs__panel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .wg-tabs__panel[hidden] {
    display: none;
  }

  .wg-tabs__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
  }

  .wg-tabs__card img {
    border-radius: 12px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--wg-suave);
  }

  .wg-tabs__card span {
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .wg-tabs__panel {
      grid-template-columns: repeat(2, 1fr);
    }
    .wg-tabs__btn {
      padding: 0.7rem 0.9rem;
      font-size: 0.72rem;
    }
  }
</style>
