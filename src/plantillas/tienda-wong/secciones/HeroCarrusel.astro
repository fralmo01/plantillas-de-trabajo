---
import { heroSlides, soles, getWongImg } from '../datos/wong.js';

interface Slide {
  kicker: string;
  titulo: string;
  sub: string;
  precioAntes: number;
  precioOferta: number;
  cuota: number;
  seed: string;
  marcaProd: string;
  img?: string;
}
---

<section class="wg-hero" aria-roledescription="carrusel">
  <div class="wg-hero__track" id="wg-hero-track">
    {(heroSlides as Slide[]).map((s, i) => (
      <article class="wg-hero__slide">
        <div class="wg-wrap wg-hero__inner">
          <div class="wg-hero__foto">
            <img src={s.img ?? getWongImg(s.seed, 900, 600)} alt={s.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="wg-hero__texto">
            <span class="wg-hero__kicker">{s.kicker}</span>
            <p class="wg-hero__marca">{s.marcaProd}</p>
            <h2>{s.titulo}</h2>
            <p class="wg-hero__sub">{s.sub}</p>
            <div class="wg-hero__precios">
              <span class="wg-hero__oferta">Precio oferta: <b>{soles(s.precioOferta)}</b></span>
              <span class="wg-hero__antes">Precio regular {soles(s.precioAntes)}</span>
              <span class="wg-hero__cuota">14 cuotas sin intereses de {soles(s.cuota)}</span>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
  <button class="wg-hero__nav wg-hero__nav--prev" id="wg-hero-prev" aria-label="Anterior">&lsaquo;</button>
  <button class="wg-hero__nav wg-hero__nav--next" id="wg-hero-next" aria-label="Siguiente">&rsaquo;</button>
  <div class="wg-hero__dots" id="wg-hero-dots">
    {heroSlides.map((_: unknown, i: number) => <button aria-label={`Ir al slide ${i + 1}`} data-dot={i}></button>)}
  </div>
</section>

<script>
  const track = document.getElementById('wg-hero-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#wg-hero-dots button'));
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }

  document.getElementById('wg-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('wg-hero-next')?.addEventListener('click', () => ir(idx + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => ir(i)));

  let timer = window.setInterval(() => ir(idx + 1), 6000);
  const box = track?.parentElement;
  box?.addEventListener('mouseenter', () => window.clearInterval(timer));
  box?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6000)));
  ir(0);
</script>

<style>
  .wg-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--wg-amarillo) 0%, var(--wg-amarillo-osc) 100%);
  }

  .wg-hero__track {
    display: flex;
    transition: transform 0.5s ease;
  }

  .wg-hero__slide {
    flex: 0 0 100%;
  }

  .wg-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    min-height: clamp(320px, 34vw, 420px);
  }

  .wg-hero__foto {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .wg-hero__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wg-hero__kicker {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--wg-tinta);
    color: #fff;
    padding: 0.25rem 0.7rem;
    border-radius: var(--wg-pill);
    margin-bottom: 0.75rem;
  }

  .wg-hero__marca {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .wg-hero__texto h2 {
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    margin: 0.35rem 0 0.6rem;
  }

  .wg-hero__sub {
    font-size: 0.9rem;
    margin-bottom: 1.1rem;
    max-width: 34ch;
  }

  .wg-hero__precios {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .wg-hero__oferta {
    font-size: 0.85rem;
  }

  .wg-hero__oferta b {
    color: #fff;
    font-size: 1.6rem;
  }

  .wg-hero__antes {
    font-size: 0.78rem;
    color: var(--wg-tinta);
    text-decoration: line-through;
    opacity: 0.7;
  }

  .wg-hero__cuota {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .wg-hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    color: var(--wg-tinta);
    font-size: 1.4rem;
    line-height: 1;
  }

  .wg-hero__nav--prev { left: 1rem; }
  .wg-hero__nav--next { right: 1rem; }

  .wg-hero__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .wg-hero__dots button {
    width: 8px;
    height: 8px;
    border-radius: var(--wg-pill);
    background: rgba(26, 26, 26, 0.3);
  }

  .wg-hero__dots button.is-on {
    background: var(--wg-tinta);
    width: 20px;
  }

  @media (max-width: 760px) {
    .wg-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
