---
import { marcas, getWongImg } from '../datos/wong.js';
---

<section class="wg-seccion wg-wrap">
  <h2 class="wg-titulo">Nuestras marcas destacadas</h2>
  <div class="wg-marcas">
    {marcas.map((m: { t: string; sub: string; seed: string; img?: string }) => (
      <a href="#tabs" class="wg-marcas__card">
        <img src={m.img ?? getWongImg(m.seed, 500, 300)} alt={m.t} loading="lazy" />
        <div class="wg-marcas__tx">
          <strong>{m.t}</strong>
          <span>{m.sub}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .wg-marcas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .wg-marcas__card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    min-height: 150px;
    display: block;
  }

  .wg-marcas__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wg-marcas__tx {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.2rem;
    color: #fff;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.68), transparent 65%);
  }

  .wg-marcas__tx strong {
    font-size: 0.95rem;
    font-weight: 800;
  }

  .wg-marcas__tx span {
    font-size: 0.76rem;
  }

  @media (max-width: 820px) {
    .wg-marcas {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .wg-marcas {
      grid-template-columns: 1fr;
    }
  }
</style>
