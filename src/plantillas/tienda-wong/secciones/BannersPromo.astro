---
import { bannersPromo, getWongImg } from '../datos/wong.js';
---

<section class="wg-seccion wg-wrap">
  <div class="wg-promo">
    {bannersPromo.map((b: { titulo: string; sub: string; seed: string; img?: string }) => (
      <a href="#tabs" class="wg-promo__card">
        <img src={b.img ?? getWongImg(b.seed, 700, 400)} alt={b.titulo} loading="lazy" />
        <div class="wg-promo__tx">
          <strong>{b.titulo}</strong>
          <span>{b.sub}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .wg-promo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .wg-promo__card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    min-height: 180px;
    display: block;
  }

  .wg-promo__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wg-promo__tx {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.25rem;
    color: #fff;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.65), transparent 65%);
  }

  .wg-promo__tx strong {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .wg-promo__tx span {
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .wg-promo {
      grid-template-columns: 1fr;
    }
  }
</style>
