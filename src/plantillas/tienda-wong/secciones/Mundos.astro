---
import { mundos, getWongImg } from '../datos/wong.js';
---

<section class="wg-seccion wg-wrap">
  <h2 class="wg-titulo">Descubre lo genial de nuestros mundos</h2>
  <div class="wg-fila wg-mundos">
    {mundos.map((m: { t: string; seed: string; img?: string }) => (
      <a href="#tabs" class="wg-mundos__item">
        <img src={m.img ?? getWongImg(m.seed, 400, 280)} alt={m.t} loading="lazy" />
        <span>{m.t}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .wg-mundos {
    grid-auto-columns: minmax(220px, 1fr);
  }

  .wg-mundos__item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .wg-mundos__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wg-mundos__item span {
    position: absolute;
    left: 0.75rem;
    bottom: 0.6rem;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }
</style>
