---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import SubNav from './secciones/SubNav.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import TresDestacados from './secciones/TresDestacados.astro';
import OfertaRelampago from './secciones/OfertaRelampago.astro';
import BannersPromo from './secciones/BannersPromo.astro';
import CategoriasBloques from './secciones/CategoriasBloques.astro';
import SeoTexto from './secciones/SeoTexto.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-tienda-tecno">
  <BarraSuperior />
  <Cabecera />
  <SubNav />
  <main>
    <HeroCarrusel />
    <TresDestacados />
    <OfertaRelampago />
    <BannersPromo />
    <CategoriasBloques />
    <SeoTexto />
  </main>
  <PiePagina />
  <ChatBot />
</div>
