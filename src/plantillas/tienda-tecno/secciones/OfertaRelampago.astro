---
import { ofertaRelampago, ofertaRelampagoMin } from '../datos/tecno.js';
import TarjetaProducto from '../componentes/TarjetaProducto.astro';

interface Producto { marca: string; nombre: string; precio: number; antes: number; dscto: string; img: string }
const productos = ofertaRelampago as Producto[];
---

<section class="tn-seccion tn-wrap">
  <div class="tn-relampago">
    <div class="tn-relampago__panel">
      <span class="tn-relampago__rayo" aria-hidden="true">&#9889;</span>
      <b>OFERTAS<br />RELAMPAGO</b>
      <span class="tn-relampago__sub">Por tiempo limitado!</span>
      <div class="tn-relampago__cronometro" id="tn-cronometro" data-min={ofertaRelampagoMin}>
        <div><span id="tn-crono-h">00</span><small>Hrs</small></div>
        <span class="tn-relampago__dospuntos">:</span>
        <div><span id="tn-crono-m">00</span><small>Min</small></div>
        <span class="tn-relampago__dospuntos">:</span>
        <div><span id="tn-crono-s">00</span><small>Seg</small></div>
      </div>
    </div>

    <div class="tn-relampago__prods">
      {productos.map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </div>
</section>

<script>
  const el = document.getElementById('tn-cronometro');
  const min = Number(el?.dataset.min || '15');
  let restante = min * 60;

  const hEl = document.getElementById('tn-crono-h');
  const mEl = document.getElementById('tn-crono-m');
  const sEl = document.getElementById('tn-crono-s');

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function tick() {
    if (restante <= 0) {
      restante = min * 60;
    }
    const h = Math.floor(restante / 3600);
    const m = Math.floor((restante % 3600) / 60);
    const s = restante % 60;
    if (hEl) hEl.textContent = pad(h);
    if (mEl) mEl.textContent = pad(m);
    if (sEl) sEl.textContent = pad(s);
    restante--;
  }

  tick();
  window.setInterval(tick, 1000);
</script>

<style>
  .tn-relampago {
    background: var(--tn-negro);
    border-radius: 6px;
    display: flex;
    overflow: hidden;
  }

  .tn-relampago__panel {
    background: linear-gradient(160deg, #2a2a2a, var(--tn-negro));
    color: #fff;
    padding: 1.75rem;
    width: 260px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tn-relampago__rayo {
    font-size: 1.6rem;
    color: #ffb800;
  }

  .tn-relampago__panel b {
    font-size: 1.3rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .tn-relampago__sub {
    font-size: 0.78rem;
    color: #ccc;
    margin-bottom: 0.75rem;
  }

  .tn-relampago__cronometro {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tn-relampago__cronometro div {
    background: #fff;
    color: var(--tn-negro);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    text-align: center;
    min-width: 46px;
  }

  .tn-relampago__cronometro span:first-child {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
  }

  .tn-relampago__cronometro small {
    font-size: 0.6rem;
    color: var(--tn-gris);
  }

  .tn-relampago__dospuntos {
    color: #fff;
    font-weight: 700;
  }

  .tn-relampago__prods {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--tn-linea);
  }

  @media (max-width: 900px) {
    .tn-relampago {
      flex-direction: column;
    }
    .tn-relampago__panel {
      width: 100%;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
    .tn-relampago__prods {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
