---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import DescuentosCarrusel from './secciones/DescuentosCarrusel.astro';
import Encomiendas from './secciones/Encomiendas.astro';
import Experiencia from './secciones/Experiencia.astro';
import Destinos from './secciones/Destinos.astro';
import Servicios from './secciones/Servicios.astro';
import MetodosPago from './secciones/MetodosPago.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-tienda-transporte">
  <Cabecera />
  <main>
    <HeroCarrusel />
    <DescuentosCarrusel />
    <Encomiendas />
    <Experiencia />
    <Destinos />
    <Servicios />
  </main>
  <MetodosPago />
  <PiePagina />
  <ChatBot />
</div>
