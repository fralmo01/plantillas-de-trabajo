---
import { marca } from '../datos/transporte.js';
import Icono from '../componentes/Icono.astro';
---

<div class="tt-chat" id="tt-chat">
  <button type="button" class="tt-chat__toggle" id="tt-chat-toggle" aria-label="Abrir chat de ayuda" aria-expanded="false">
    <svg class="tt-chat__i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V6a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
    </svg>
    <span class="tt-chat__i-close" aria-hidden="true">&times;</span>
  </button>

  <section class="tt-chat__panel" id="tt-chat-panel" hidden aria-label="Chat de ayuda">
    <header class="tt-chat__head">
      <span class="tt-chat__ava" aria-hidden="true"><Icono name="bus" size={17} /></span>
      <div>
        <b>Asistente {marca.nombre}</b>
        <small>En linea</small>
      </div>
    </header>

    <div class="tt-chat__body" id="tt-chat-body">
      <p class="tt-chat__msg tt-chat__msg--bot">Hola! Buscas comprar un pasaje, enviar una encomienda o conocer un destino?</p>
      <p class="tt-chat__msg tt-chat__msg--bot">Cuentame que necesitas y te ayudo.</p>
    </div>

    <form class="tt-chat__form" id="tt-chat-form">
      <input type="text" id="tt-chat-input" placeholder="Escribe aqui..." aria-label="Mensaje" autocomplete="off" />
      <button type="submit" aria-label="Enviar">&#10148;</button>
    </form>
    <p class="tt-chat__pow">Demo &mdash; respuestas automaticas</p>
  </section>
</div>

<script>
  import { chatCanned } from '../datos/transporte.js';

  const toggle = document.getElementById('tt-chat-toggle');
  const panel = document.getElementById('tt-chat-panel');
  const body = document.getElementById('tt-chat-body');
  const form = document.getElementById('tt-chat-form');
  const input = document.getElementById('tt-chat-input') as HTMLInputElement | null;
  let paso = 0;

  function abrir(v: boolean) {
    if (!panel || !toggle) return;
    panel.hidden = !v;
    toggle.classList.toggle('is-open', v);
    toggle.setAttribute('aria-expanded', String(v));
    if (v) input?.focus();
  }

  toggle?.addEventListener('click', () => abrir(panel?.hidden ?? true));

  function push(texto: string, quien: 'bot' | 'yo') {
    if (!body) return;
    const p = document.createElement('p');
    p.className = `tt-chat__msg tt-chat__msg--${quien}`;
    p.textContent = texto;
    body.appendChild(p);
    body.scrollTop = body.scrollHeight;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const txt = (input?.value || '').trim();
    if (!txt) return;
    push(txt, 'yo');
    if (input) input.value = '';
    const reply = chatCanned[Math.min(paso, chatCanned.length - 1)];
    paso++;
    window.setTimeout(() => push(reply, 'bot'), 650);
  });
</script>

<style>
  .tt-chat {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 120;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .tt-chat__toggle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--tt-naranja);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 12px 30px -10px rgba(242, 105, 31, 0.6);
    order: 2;
  }

  .tt-chat__i-close {
    display: none;
    font-size: 1.7rem;
    line-height: 1;
  }

  .tt-chat__toggle.is-open .tt-chat__i-open { display: none; }
  .tt-chat__toggle.is-open .tt-chat__i-close { display: block; }

  .tt-chat__panel[hidden] {
    display: none;
  }

  .tt-chat__panel {
    width: min(340px, 88vw);
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 24px 60px -16px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    order: 1;
  }

  .tt-chat__head {
    background: var(--tt-negro);
    color: #fff;
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .tt-chat__ava {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--tt-naranja);
    display: grid;
    place-items: center;
  }

  .tt-chat__head b {
    color: #fff;
    font-size: 0.9rem;
    display: block;
  }

  .tt-chat__head small {
    font-size: 0.68rem;
    opacity: 0.75;
  }

  .tt-chat__body {
    background: var(--tt-gris-claro);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: 320px;
    min-height: 180px;
    overflow-y: auto;
  }

  .tt-chat__form {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--tt-linea);
  }

  .tt-chat__form input {
    flex: 1;
    border: 1px solid var(--tt-linea);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    font-size: 0.82rem;
    outline: none;
  }

  .tt-chat__form input:focus {
    border-color: var(--tt-naranja);
  }

  .tt-chat__form button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tt-naranja);
    color: #fff;
    flex-shrink: 0;
  }

  .tt-chat__pow {
    text-align: center;
    font-size: 0.62rem;
    color: var(--tt-gris);
    padding: 0 0 0.6rem;
  }
</style>
