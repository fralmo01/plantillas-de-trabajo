---
import { categorias } from '../datos/juguetes.js';
---

<section class="tj-seccion tj-wrap" id="categorias">
  <h2 class="tj-titulo">Encuentra el juguete perfecto</h2>
  <ul class="tj-cats">
    {categorias.map((c: { t: string; img: string }) => (
      <li>
        <a href="#novedades" class="tj-cats__item">
          <span class="tj-cats__foto"><img src={c.img} alt={c.t} loading="lazy" /></span>
          <span class="tj-cats__lbl">{c.t}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .tj-cats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  .tj-cats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .tj-cats__foto {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 150px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--tj-verde-claro);
    display: block;
    border: 3px solid var(--tj-verde-claro);
  }

  .tj-cats__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .tj-cats__item:hover .tj-cats__foto {
    border-color: var(--tj-oro);
  }

  .tj-cats__item:hover .tj-cats__foto img {
    transform: scale(1.07);
  }

  .tj-cats__lbl {
    font-family: var(--tj-titulos);
    font-weight: 700;
    color: var(--tj-verde-osc);
    font-size: 0.85rem;
    text-align: center;
  }

  @media (max-width: 820px) {
    .tj-cats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tj-cats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
