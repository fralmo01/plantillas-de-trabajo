---
import { tendencia, soles } from '../datos/juguetes.js';
import Icono from '../componentes/Icono.astro';

interface MiniProd { nombre: string; precio: number; img: string }
const productos = tendencia.productos as MiniProd[];
---

<section class="tj-seccion tj-wrap">
  <div class="tj-tend">
    <div class="tj-tend__tx">
      <h2>{tendencia.titulo} <span class="tj-tend__ico" aria-hidden="true"><Icono name="fuego" size={22} /></span></h2>
      <p>{tendencia.sub}</p>
      <ul class="tj-tend__mini">
        {productos.map((p) => (
          <li>
            <img src={p.img} alt={p.nombre} loading="lazy" />
            <span>{p.nombre}</span>
            <b>{soles(p.precio)}</b>
          </li>
        ))}
      </ul>
      <a href="#novedades" class="tj-btn tj-btn--verde">{tendencia.cta}</a>
    </div>
    <div class="tj-tend__img">
      <img src={tendencia.img} alt={tendencia.titulo} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .tj-tend {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: #fff;
    border: 1px solid var(--tj-linea);
    border-radius: 20px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .tj-tend__tx h2 {
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tj-tend__ico {
    display: inline-flex;
    color: var(--tj-terracota);
  }

  .tj-tend__tx > p {
    color: var(--tj-gris);
    margin-top: 0.4rem;
    font-size: 0.9rem;
  }

  .tj-tend__mini {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .tj-tend__mini li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
    width: 100px;
  }

  .tj-tend__mini img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 12px;
    background: var(--tj-verde-claro);
  }

  .tj-tend__mini span {
    font-size: 0.72rem;
    color: var(--tj-tinta);
    line-height: 1.3;
  }

  .tj-tend__mini b {
    font-size: 0.8rem;
    color: var(--tj-terracota-osc);
  }

  .tj-tend__img img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
  }

  @media (max-width: 820px) {
    .tj-tend {
      grid-template-columns: 1fr;
    }
    .tj-tend__mini {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
