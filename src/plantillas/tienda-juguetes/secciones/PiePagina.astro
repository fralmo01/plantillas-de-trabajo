---
import { marca, footerCols, tiendas, pagoMetodos } from '../datos/juguetes.js';
---

<footer class="tj-foot">
  <div class="tj-wrap tj-foot__grid">
    {footerCols.map((col: { t: string; links: string[] }) => (
      <nav class="tj-foot__col" aria-label={col.t}>
        <h3>{col.t}</h3>
        <ul>
          {col.links.map((l: string) => <li>{l.includes('@') || /^\(/.test(l) ? <span>{l}</span> : <a href="#top">{l}</a>}</li>)}
        </ul>
      </nav>
    ))}

    <div class="tj-foot__col">
      <h3>Tiendas</h3>
      {tiendas.map((t: { t: string; dir: string; horario: string }) => (
        <div class="tj-foot__tienda">
          <b>{t.t}</b>
          <p>{t.dir}</p>
          <p>{t.horario}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="tj-wrap tj-foot__pagos-row">
    <ul class="tj-foot__pagos">
      {pagoMetodos.map((p: string) => <li>{p}</li>)}
    </ul>
  </div>

  <div class="tj-wrap tj-foot__base">
    <span>&copy; 2026 {marca.nombre}. Tecnologia de plantillas.</span>
    <div class="tj-foot__redes" aria-label="Redes sociales">
      <a href="#" aria-label="Facebook">f</a>
      <a href="#" aria-label="Instagram">&#9678;</a>
      <a href="#" aria-label="TikTok">&#9835;</a>
    </div>
  </div>
</footer>

<style>
  .tj-foot {
    background: var(--tj-terracota);
    color: #fff;
    margin-top: 2rem;
  }

  .tj-foot__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-block: 2.5rem 1.5rem;
  }

  .tj-foot__col h3 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.9rem;
  }

  .tj-foot__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .tj-foot__col a,
  .tj-foot__col span {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .tj-foot__col a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .tj-foot__tienda {
    margin-bottom: 1rem;
  }

  .tj-foot__tienda b {
    display: block;
    font-size: 0.82rem;
    margin-bottom: 0.2rem;
  }

  .tj-foot__tienda p {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }

  .tj-foot__pagos-row {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-block: 1rem;
  }

  .tj-foot__pagos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tj-foot__pagos li {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .tj-foot__base {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-block: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .tj-foot__redes {
    display: flex;
    gap: 0.4rem;
  }

  .tj-foot__redes a {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-weight: 700;
    font-size: 0.75rem;
  }

  .tj-foot__redes a:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 900px) {
    .tj-foot__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .tj-foot__grid {
      grid-template-columns: 1fr;
    }
    .tj-foot__base {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
