---
const items = [
  { titulo: 'banco tienda.com', copa: '¡Pide tu Tarjeta de Crédito y te regalamos $10.000!', cta: 'pídela aquí', fondo: 'var(--mk-amarillo)', tinta: 'var(--mk-negro)' },
  { titulo: 'seguros tienda.com', copa: 'Protege tu auto y celebra tranquilo · 45% dcto. en 6 cuotas', cta: 'cotiza acá', fondo: 'var(--mk-morado)', tinta: 'var(--mk-blanco)' },
];
---

<section class="mk-seccion">
  <div class="mk-contenedor">
    <div class="mk-fin">
      {
        items.map((it) => (
          <a href="#" class="mk-fin__card" style={`background:${it.fondo}; color:${it.tinta}`}>
            <strong>{it.titulo}</strong>
            <p>{it.copa}</p>
            <span class="mk-btn mk-btn--negro">{it.cta}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mk-fin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .mk-fin__card {
    border-radius: var(--mk-radio);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    min-height: 160px;
  }

  .mk-fin__card strong {
    font-size: 1.1rem;
  }

  .mk-fin__card p {
    font-size: 0.88rem;
    flex: 1;
  }

  @media (max-width: 760px) {
    .mk-fin {
      grid-template-columns: 1fr;
    }
  }
</style>
