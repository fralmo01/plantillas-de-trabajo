---
const base = '/plantillas/tienda-marketplace';
---

<header class="mk-cab">
  <div class="mk-contenedor mk-cab__inner">
    <button
      class="mk-cab__menu"
      id="mk-burger"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mk-menu-lateral"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <a href={`${base}/`} class="mk-logo" aria-label="tienda.com — inicio">tienda<span>.com</span></a>

    <form class="mk-buscador" role="search" action={`${base}/buscar/`} method="get">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.7" y2="16.7" />
      </svg>
      <input type="search" name="q" placeholder="Buscar productos" aria-label="Buscar productos" autocomplete="off" />
      <button type="submit" class="visually" aria-label="Buscar">Buscar</button>
    </form>

    <div class="mk-cab__acc">
      <button type="button" class="mk-cab__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.6" />
        </svg>
        Enviar a Santiago ▾
      </button>

      
      <button type="button" class="mk-cab__item" aria-disabled="true" title="Demo sin login">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
        </svg>
        Mi cuenta ▾
      </button>

      <a href="#" class="mk-cab__carrito" aria-label="Carrito de compras">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="20" r="1.6" /><circle cx="18" cy="20" r="1.6" />
          <path d="M2 3h3l2.4 12.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L23 7H6" />
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .mk-cab {
    background: var(--mk-negro);
    color: var(--mk-blanco);
    position: sticky;
    top: 0;
    z-index: 80;
  }

  .mk-cab__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.5rem);
    padding-block: 0.7rem;
  }

  .mk-cab__menu {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
  }

  .mk-logo {
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mk-logo span {
    letter-spacing: 0.05em;
    opacity: 0.6;
  }

  .mk-buscador {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--mk-blanco);
    color: var(--mk-tinta);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    max-width: 640px;
  }

  .mk-buscador input {
    flex: 1;
    border: 0;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
  }

  .mk-cab__acc {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.6vw, 1.5rem);
    flex-shrink: 0;
  }

  .mk-cab__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .mk-cab__item[aria-disabled='true'] {
    opacity: 0.75;
    cursor: default;
  }

  .mk-cab__carrito {
    color: inherit;
    display: inline-flex;
  }

  @media (max-width: 900px) {
    .mk-cab__item {
      display: none;
    }
    .mk-cab__item:first-child {
      display: inline-flex;
    }
  }

  @media (max-width: 620px) {
    .mk-cab__inner {
      flex-wrap: wrap;
    }
    .mk-buscador {
      order: 5;
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>
