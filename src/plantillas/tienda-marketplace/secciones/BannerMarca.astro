---
const { marca, bajada, detalle, seed } = Astro.props;
---

<section class="mk-seccion">
  <div class="mk-contenedor">
    <a href="#" class="mk-marca">
      <img src={`https://picsum.photos/seed/${seed}/1300/260`} alt={marca} loading="lazy" />
      <div class="mk-marca__texto">
        <span class="mk-marca__bajada">{bajada}</span>
        <strong class="mk-marca__nombre">{marca}</strong>
        <span class="mk-marca__detalle">{detalle}</span>
      </div>
    </a>
  </div>
</section>

<style>
  .mk-marca {
    position: relative;
    display: block;
    border-radius: var(--mk-radio);
    overflow: hidden;
    min-height: 170px;
    isolation: isolate;
  }

  .mk-marca img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    filter: brightness(0.9) saturate(0.9);
  }

  .mk-marca__texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    height: 100%;
    min-height: 170px;
    text-align: center;
    background: rgba(255, 255, 255, 0.72);
    padding: 1.5rem;
  }

  .mk-marca__bajada {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mk-gris-texto);
  }

  .mk-marca__nombre {
    font-size: clamp(1.6rem, 5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .mk-marca__detalle {
    font-size: 0.85rem;
  }
</style>
