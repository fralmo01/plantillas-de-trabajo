---
import { categoriasCirculares } from '../datos/contenido.js';
---

<section class="mk-seccion">
  <div class="mk-contenedor">
    <h2 class="mk-titulo">encuentra aquí <span class="mk-rosa">todas las tendencias</span></h2>
    <div class="mk-fila mk-fila--6">
      {
        categoriasCirculares.map((c) => (
          <a href="#" class="mk-cat">
            <span class="mk-cat__circulo">
              <img src={`https://picsum.photos/seed/${c.seed}/240/240`} alt={c.nombre} loading="lazy" />
            </span>
            <span class="mk-cat__nombre">{c.nombre}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mk-cat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .mk-cat__circulo {
    width: 100%;
    max-width: 150px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .mk-cat:hover .mk-cat__circulo {
    border-color: var(--mk-morado);
    transform: scale(1.04);
  }

  .mk-cat__circulo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mk-cat__nombre {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: lowercase;
  }
</style>
