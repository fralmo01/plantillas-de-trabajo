---
const banners = [
  { titulo: 'tablet 128 GB', precio: '$159.990', nota: 'precio normal $229.990', seed: 'mk-duo-1' },
  { titulo: 'brand day · 40% dcto.', precio: 'todo vestuario', nota: 'marcas seleccionadas', seed: 'mk-duo-2' },
];
---

<section class="mk-seccion">
  <div class="mk-contenedor">
    <div class="mk-duo">
      {
        banners.map((b) => (
          <a href="#" class="mk-duo__card">
            <img src={`https://picsum.photos/seed/${b.seed}/720/300`} alt={b.titulo} loading="lazy" />
            <div class="mk-duo__texto">
              <h3>{b.titulo}</h3>
              <p class="mk-duo__precio">{b.precio}</p>
              <p class="mk-duo__nota">{b.nota}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mk-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .mk-duo__card {
    position: relative;
    border-radius: var(--mk-radio);
    overflow: hidden;
    min-height: 210px;
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  .mk-duo__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    filter: brightness(0.92);
  }

  .mk-duo__texto {
    padding: 1.5rem;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.4));
    backdrop-filter: blur(1px);
    border-radius: 8px;
    margin: 1rem;
  }

  .mk-duo__texto h3 {
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    text-transform: lowercase;
  }

  .mk-duo__precio {
    font-size: 1.2rem;
    font-weight: 800;
    margin-top: 0.25rem;
  }

  .mk-duo__nota {
    font-size: 0.72rem;
    color: var(--mk-gris-texto);
  }

  @media (max-width: 760px) {
    .mk-duo {
      grid-template-columns: 1fr;
    }
  }
</style>
