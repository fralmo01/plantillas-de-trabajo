---
import { promosBuscadas } from '../datos/contenido.js';
---

<section class="mk-seccion">
  <div class="mk-contenedor">
    <h2 class="mk-titulo">¡los <span class="mk-mas">+</span> buscados!</h2>
    <div class="mk-promos">
      {
        promosBuscadas.map((p) => (
          <a href="#" class="mk-promos__tile">
            <img src={`https://picsum.photos/seed/${p.seed}/520/420`} alt={p.copa} loading="lazy" />
            <span class="mk-promos__envio">envío gratis</span>
            <div class="mk-promos__texto">
              <p class="mk-promos__dcto">{p.dcto}</p>
              <p class="mk-promos__copa">{p.copa}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mk-titulo .mk-mas {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2em;
    height: 1.2em;
    background: var(--mk-rosa);
    color: #fff;
    border-radius: 50%;
    font-size: 0.8em;
  }

  .mk-promos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .mk-promos__tile {
    position: relative;
    border-radius: var(--mk-radio);
    overflow: hidden;
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }

  .mk-promos__tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .mk-promos__envio {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--mk-negro);
    color: var(--mk-blanco);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .mk-promos__texto {
    width: 100%;
    padding: 1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    color: #fff;
  }

  .mk-promos__dcto {
    font-size: 1.05rem;
    font-weight: 800;
  }

  .mk-promos__copa {
    font-size: 0.8rem;
  }

  @media (max-width: 860px) {
    .mk-promos {
      grid-template-columns: repeat(2, 1fr);
    }
    .mk-promos__tile.is-destacado {
      grid-row: span 1;
    }
  }
</style>
