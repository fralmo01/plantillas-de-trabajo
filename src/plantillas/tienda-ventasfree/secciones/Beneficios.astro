---
import { beneficios } from '../datos/ventasfree.js';

const ICONOS: Record<string, string> = {
  escudo: 'M12 2 4 5v6c0 5.2 3.4 9.7 8 11 4.6-1.3 8-5.8 8-11V5l-8-3Z',
  camion: 'M3 7h13v10H3zM16 10h4l1 3v4h-5',
  auricular: 'M4 14v-2a8 8 0 0 1 16 0v2M2 14h4v6H4a2 2 0 0 1-2-2v-4Zm20 0h-4v6h2a2 2 0 0 0 2-2v-4Z',
  check: 'm20 6-11 11L4 12',
  tienda: 'M3 9l1-5h16l1 5M4 9v11h16V9M9 21v-6h6v6',
};
---

<section class="vf-benef vf-wrap">
  {beneficios.map((b) => (
    <div class="vf-benef__item">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={ICONOS[b.icono]}></path></svg>
      <div>
        <strong>{b.t}</strong>
        <span>{b.sub}</span>
      </div>
    </div>
  ))}
</section>

<style>
  .vf-benef {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .vf-benef__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: #fff;
    border: 1px solid var(--vf-linea);
    border-radius: 10px;
    padding: 0.9rem;
  }

  .vf-benef__item svg {
    color: var(--vf-azul);
    flex-shrink: 0;
  }

  .vf-benef__item strong {
    display: block;
    font-size: 0.78rem;
  }

  .vf-benef__item span {
    font-size: 0.68rem;
    color: var(--vf-gris);
  }

  @media (max-width: 1000px) {
    .vf-benef {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .vf-benef {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
