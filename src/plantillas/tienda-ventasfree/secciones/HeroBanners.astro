---
import { heroBanners, getVfImg } from '../datos/ventasfree.js';

interface Banner {
  t: string;
  sub: string;
  chip?: string;
  precio?: string;
  seed: string;
  img?: string;
  grande?: boolean;
}

const base = '/plantillas/tienda-ventasfree';
---

<section class="vf-hero vf-wrap">
  <div class="vf-hero__grid">
    {(heroBanners as Banner[]).map((b, i) => (
      <a href={`${base}/buscar/`} class={`vf-hero__tile vf-hero__tile--${i}`}>
        <img src={b.img ?? getVfImg(b.seed, 700, 500)} alt={b.t} loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="vf-hero__tx">
          {b.chip && <span class="vf-hero__chip">{b.chip}</span>}
          <h2>{b.t}</h2>
          <p>{b.sub}</p>
          {b.precio && <span class="vf-hero__precio">{b.precio}</span>}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .vf-hero {
    padding-block: 1.25rem;
  }

  .vf-hero__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1rem;
  }

  .vf-hero__tile {
    position: relative;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    background: var(--vf-azul-osc);
  }

  .vf-hero__tile--0 {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .vf-hero__tile--1 {
    grid-column: 2;
    grid-row: 1 / 3;
  }

  .vf-hero__tile--2 {
    grid-column: 3;
    grid-row: 1;
  }

  .vf-hero__tile--3 {
    grid-column: 3;
    grid-row: 2;
  }

  .vf-hero__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    position: absolute;
    inset: 0;
  }

  .vf-hero__tx {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    color: #fff;
  }

  .vf-hero__chip {
    align-self: flex-start;
    background: #fff;
    color: var(--vf-azul-osc);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.3rem;
  }

  .vf-hero__tx h2 {
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: #fff;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .vf-hero__tx p {
    font-size: 0.8rem;
    opacity: 0.9;
  }

  .vf-hero__precio {
    margin-top: 0.4rem;
    align-self: flex-start;
    background: var(--vf-rojo);
    color: #fff;
    font-weight: 800;
    font-size: 1.1rem;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
  }

  @media (max-width: 900px) {
    .vf-hero__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
    .vf-hero__tile--0,
    .vf-hero__tile--1,
    .vf-hero__tile--2,
    .vf-hero__tile--3 {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 560px) {
    .vf-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
