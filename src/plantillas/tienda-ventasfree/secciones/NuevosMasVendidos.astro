---
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import { catalogo } from '../datos/ventasfree.js';

const nuevos = catalogo.slice(0, 4);
const vendidos = [...catalogo].reverse().slice(0, 4);
const base = '/plantillas/tienda-ventasfree';
---

<section class="vf-seccion vf-wrap">
  <div class="vf-nv__grid">
    <div class="vf-nv__col vf-nv__col--nuevos">
      <div class="vf-nv__cab">
        <h2 class="vf-titulo-seccion">Nuevos ingresos</h2>
        <a href={`${base}/buscar/`}>Ver todos →</a>
      </div>
      <div class="vf-nv__row">
        {nuevos.map((p) => <TarjetaProducto producto={p} />)}
      </div>
    </div>

    <div class="vf-nv__col vf-nv__col--vendidos">
      <div class="vf-nv__cab">
        <h2 class="vf-titulo-seccion">Más vendidos</h2>
        <a href={`${base}/buscar/`}>Ver todos →</a>
      </div>
      <div class="vf-nv__row">
        {vendidos.map((p) => <TarjetaProducto producto={p} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .vf-nv__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .vf-nv__col {
    border-radius: 12px;
    padding: 1.25rem;
  }

  .vf-nv__col--nuevos {
    background: #eef3fd;
    border: 1px solid #d3e0f8;
  }

  .vf-nv__col--vendidos {
    background: #fff9e8;
    border: 1px solid #f3e6b8;
  }

  .vf-nv__cab {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .vf-nv__cab a {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--vf-azul);
  }

  .vf-nv__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  @media (max-width: 1100px) {
    .vf-nv__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .vf-nv__row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
