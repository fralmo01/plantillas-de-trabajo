---
const items = ['Gorras', 'Morrales', 'Canguros'];
---

<section class="tm-seccion">
  <div class="tm-contenedor">
    <a href="/plantillas/tutienda-moda/colecciones/" class="tm-acc">
      <div class="tm-acc__texto">
        <span class="tm-acc__script">Tus accesorios</span>
        <span class="tm-acc__fav">favoritos</span>
        <span class="tm-btn tm-btn--amarillo">Ver más »</span>
      </div>
      <div class="tm-acc__fotos">
        {
          items.map((it, i) => (
            <figure>
              <img src={`https://picsum.photos/seed/tm-acc-${i}/360/300`} alt={it} loading="lazy" />
              <figcaption>{it}</figcaption>
            </figure>
          ))
        }
      </div>
    </a>
  </div>
</section>

<style>
  .tm-acc {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) 1.3fr;
    align-items: center;
    gap: 1.5rem;
    background: var(--tm-crema);
    border: 1px solid #e9e0cf;
    border-radius: var(--tm-radio);
    padding: 1.5rem;
    overflow: hidden;
  }

  .tm-acc__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .tm-acc__script {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .tm-acc__fav {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    margin-bottom: 0.6rem;
  }

  .tm-acc__fotos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .tm-acc__fotos figure {
    position: relative;
    border-radius: var(--tm-radio);
    overflow: hidden;
  }

  .tm-acc__fotos img {
    width: 100%;
    aspect-ratio: 6 / 5;
    object-fit: cover;
  }

  .tm-acc__fotos figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.5rem;
    text-align: center;
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  }

  @media (max-width: 760px) {
    .tm-acc {
      grid-template-columns: 1fr;
    }
    .tm-acc__fotos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
