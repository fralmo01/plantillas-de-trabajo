---
import TarjetaProducto from './TarjetaProducto.astro';
import { grupos, ordenarPor } from '../datos/categorias.js';
import type { Producto, MetaCategoria, GrupoFiltro } from '../datos/tipos.ts';

interface Props {
  slug: string;
  meta: MetaCategoria;
  lista: Producto[];
}

const { slug, meta, lista } = Astro.props as Props;
const base = '/plantillas/tutienda-moda';
const totalFiltros = 2053; 
---

<section class="tm-cat">
  <div class="tm-contenedor">
    <nav class="tm-cat__crumbs" aria-label="Ruta">
      <a href={`${base}/`}>Inicio</a>
      <span>/</span>
      <span aria-current="page">{meta.titulo}</span>
    </nav>

    <div class="tm-cat__layout">
      
      <aside class="tm-filtros" id="tm-filtros">
        <div class="tm-filtros__cab">
          <h2>Shop {meta.titulo}</h2>
          <button class="tm-filtros__cerrar" type="button" aria-label="Cerrar filtros">✕</button>
        </div>

        <form class="tm-filtros__form" onsubmit="return false">
          
          <ul class="tm-filtros__subcats">
            {
              meta.subcategorias.map((s: string, i: number) => (
                <li>
                  <label>
                    <input type="checkbox" name="subcat" value={s} />
                    <span>{s}</span>
                  </label>
                </li>
              ))
            }
          </ul>

          <p class="tm-filtros__conteo">Filtros ({totalFiltros.toLocaleString('es-PE')})</p>

          
          <details class="tm-grupo" open>
            <summary>Precio</summary>
            <div class="tm-grupo__cuerpo">
              <div class="tm-rango">
                <input
                  type="range"
                  min={meta.precio[0]}
                  max={meta.precio[1]}
                  value={meta.precio[0]}
                  aria-label="Precio mínimo"
                  class="tm-rango__input tm-rango__input--min"
                />
                <input
                  type="range"
                  min={meta.precio[0]}
                  max={meta.precio[1]}
                  value={meta.precio[1]}
                  aria-label="Precio máximo"
                  class="tm-rango__input tm-rango__input--max"
                />
              </div>
              <div class="tm-rango__valores">
                <span>S/ {meta.precio[0]}</span>
                <span>S/ {meta.precio[1]}</span>
              </div>
            </div>
          </details>

          
          {
            grupos.map((g: GrupoFiltro) => (
              <details class="tm-grupo">
                <summary>{g.titulo}</summary>
                <div class="tm-grupo__cuerpo">
                  <ul class="tm-grupo__lista">
                    {g.opciones.map((op: string) => (
                      <li>
                        <label>
                          <input type="checkbox" name={g.titulo} value={op} />
                          <span>{op}</span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ))
          }

          <div class="tm-filtros__acciones">
            <button type="reset" class="tm-btn tm-btn--blanco">Limpiar</button>
            <button type="button" class="tm-btn tm-btn--negro" data-cerrar-filtros>Ver resultados</button>
          </div>
        </form>
      </aside>

      
      <div class="tm-cat__resultados">
        <header class="tm-cat__head">
          <div>
            <h1 class="tm-titulo-seccion">{meta.titulo}</h1>
            <p class="tm-cat__intro">{meta.intro}</p>
          </div>
        </header>

        <div class="tm-cat__barra">
          <button class="tm-cat__toggle" type="button" id="tm-toggle-filtros">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" y1="6" x2="20" y2="6" /><line x1="7" y1="12" x2="17" y2="12" /><line x1="10" y1="18" x2="14" y2="18" />
            </svg>
            Filtros
          </button>

          <span class="tm-cat__conteo">{lista.length} productos</span>

          <label class="tm-cat__orden">
            <span>Ordenar por</span>
            <select>
              {ordenarPor.map((o: string) => <option>{o}</option>)}
            </select>
          </label>
        </div>

        <div class="tm-cat__grid">
          {lista.map((p: Producto) => <TarjetaProducto producto={p} />)}
        </div>

        <div class="tm-cat__mas">
          <button class="tm-btn tm-btn--negro" type="button">Ver más</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const abrir = document.getElementById('tm-toggle-filtros');
  const panel = document.getElementById('tm-filtros');
  const cerrar = panel?.querySelector('.tm-filtros__cerrar');
  const verResultados = panel?.querySelector('[data-cerrar-filtros]');

  const toggle = () => panel?.classList.toggle('is-abierto');
  abrir?.addEventListener('click', toggle);
  cerrar?.addEventListener('click', toggle);
  verResultados?.addEventListener('click', () => panel?.classList.remove('is-abierto'));
</script>

<style>
  .tm-cat {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4rem);
  }

  .tm-cat__crumbs {
    display: flex;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--tm-gris-texto);
    margin-bottom: 1rem;
  }

  .tm-cat__crumbs a:hover {
    color: var(--tm-tinta);
  }

  .tm-cat__layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  
  .tm-filtros {
    position: sticky;
    top: 90px;
  }

  .tm-filtros__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .tm-filtros__cab h2 {
    font-size: 1.05rem;
    text-transform: uppercase;
  }

  .tm-filtros__cerrar {
    display: none;
    background: none;
    border: 0;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .tm-filtros__subcats {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    max-height: 260px;
    overflow-y: auto;
    padding-right: 0.25rem;
    border-left: 3px solid var(--tm-amarillo);
    padding-left: 0.75rem;
  }

  .tm-filtros__subcats label,
  .tm-grupo__lista label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .tm-filtros__subcats input,
  .tm-grupo__lista input {
    width: 15px;
    height: 15px;
    accent-color: var(--tm-negro);
    flex-shrink: 0;
  }

  .tm-filtros__conteo {
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    margin: 1.1rem 0 0.5rem;
  }

  .tm-grupo {
    border-top: 1px solid var(--tm-gris-borde);
    padding-block: 0.55rem;
  }

  .tm-grupo summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    padding-block: 0.3rem;
  }

  .tm-grupo summary::-webkit-details-marker {
    display: none;
  }

  .tm-grupo summary::after {
    content: "+";
    font-weight: 700;
    font-size: 1rem;
  }

  .tm-grupo[open] summary::after {
    content: "–";
  }

  .tm-grupo__cuerpo {
    padding-top: 0.6rem;
  }

  .tm-grupo__lista {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  
  .tm-rango {
    position: relative;
    height: 26px;
  }

  .tm-rango::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    transform: translateY(-50%);
    background: var(--tm-gris-borde);
  }

  .tm-rango__input {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    margin: 0;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .tm-rango__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--tm-negro);
    border: 2px solid #fff;
    pointer-events: auto;
    cursor: pointer;
  }

  .tm-rango__input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--tm-negro);
    border: 2px solid #fff;
    pointer-events: auto;
    cursor: pointer;
  }

  .tm-rango__valores {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--tm-gris-texto);
    margin-top: 0.35rem;
  }

  .tm-filtros__acciones {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tm-filtros__acciones .tm-btn {
    flex: 1;
    padding: 0.55rem 0.5rem;
    font-size: 0.75rem;
  }

  
  .tm-cat__head {
    margin-bottom: 1rem;
  }

  .tm-cat__intro {
    max-width: 60ch;
    color: var(--tm-gris-texto);
    font-size: 0.9rem;
  }

  .tm-cat__barra {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--tm-gris-borde);
    margin-bottom: 1.25rem;
  }

  .tm-cat__toggle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--tm-gris-borde);
    border-radius: var(--tm-radio-pill);
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .tm-cat__conteo {
    font-size: 0.8rem;
    color: var(--tm-gris-texto);
  }

  .tm-cat__orden {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .tm-cat__orden select {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.4rem 1.75rem 0.4rem 0.75rem;
    border: 1px solid var(--tm-gris-borde);
    border-radius: var(--tm-radio-pill);
    background: var(--tm-blanco);
    cursor: pointer;
  }

  .tm-cat__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .tm-cat__mas {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  
  @media (max-width: 1100px) {
    .tm-cat__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .tm-cat__layout {
      grid-template-columns: 1fr;
    }
    .tm-cat__toggle {
      display: inline-flex;
    }
    .tm-filtros {
      position: fixed;
      inset: 0 30% 0 0;
      z-index: 120;
      background: var(--tm-blanco);
      padding: 1.25rem;
      overflow-y: auto;
      transform: translateX(-105%);
      transition: transform 0.25s ease;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.25);
    }
    .tm-filtros.is-abierto {
      transform: none;
    }
    .tm-filtros__cerrar {
      display: block;
    }
  }

  @media (max-width: 680px) {
    .tm-cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tm-filtros {
      inset: 0 12% 0 0;
    }
  }
</style>
