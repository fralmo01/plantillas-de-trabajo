---
const { producto: p } = Astro.props;
---

<article class="tm-prod">
  <a href="#" class="tm-prod__media">
    <img src={p.img} alt={p.nombre} loading="lazy" />
    {p.etiqueta && <span class="tm-prod__tag">{p.etiqueta}</span>}
    {p.dscto && <span class="tm-prod__dscto">{p.dscto}%</span>}
  </a>
  <div class="tm-prod__cuerpo">
    <h3 class="tm-prod__nombre">{p.nombre}</h3>
    <span class="tm-prod__sku">SKU: {p.sku}</span>
    <p class="tm-prod__precio">
      S/ {p.precio.toFixed(2)}
      {p.antes && <s>Antes S/ {p.antes.toFixed(2)}</s>}
    </p>
    <span class="tm-prod__colores">{p.colores} {p.colores === 1 ? 'color' : 'colores'} disponibles</span>
  </div>
</article>

<style>
  .tm-prod {
    display: flex;
    flex-direction: column;
    background: var(--tm-blanco);
    border: 1px solid var(--tm-gris-borde);
    border-radius: var(--tm-radio);
    overflow: hidden;
  }

  .tm-prod__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--tm-gris-tarjeta);
    display: block;
  }

  .tm-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tm-prod__tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--tm-amarillo);
    color: var(--tm-negro);
    font-size: 0.66rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 5px;
  }

  .tm-prod__dscto {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tm-amarillo);
    color: var(--tm-negro);
    font-size: 0.72rem;
    font-weight: 800;
    border-radius: 50%;
  }

  .tm-prod__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem 1.1rem;
    text-align: center;
    flex: 1;
  }

  .tm-prod__nombre {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.25;
  }

  .tm-prod__sku {
    font-size: 0.66rem;
    color: var(--tm-gris-texto);
  }

  .tm-prod__precio {
    margin-top: 0.2rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .tm-prod__precio s {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--tm-gris-texto);
  }

  .tm-prod__colores {
    font-size: 0.68rem;
    color: var(--tm-gris-texto);
    margin-top: auto;
  }
</style>
