---
const anio = new Date().getFullYear();

const columnas = [
  {
    titulo: 'Sobre nosotros',
    enlaces: ['Tiempos y costos de envío', 'Cambios y devoluciones', 'Plazos de reembolso'],
  },
  {
    titulo: 'Ayuda & apoyo',
    enlaces: [
      'Términos y condiciones',
      'Protección de datos',
      'Política de cookies',
      'Términos de recojo en tienda',
    ],
  },
  {
    titulo: 'Servicio al cliente',
    enlaces: ['Contáctanos', 'Seguimiento de pedido', 'Nuestras tiendas'],
  },
];
---

<footer class="tm-pie">
  <div class="tm-contenedor tm-pie__grid">
    {
      columnas.map((c) => (
        <div class="tm-pie__col">
          <h4>{c.titulo}</h4>
          <ul>
            {c.enlaces.map((e) => (
              <li>
                <a href="#">{e}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="tm-pie__col">
      <h4>Pago seguro</h4>
      <div class="tm-pie__pagos">
        <span>VISA</span><span>Mastercard</span><span>Amex</span><span>Yape</span>
      </div>
      <h4 style="margin-top:1.2rem">Encuéntranos en</h4>
      <div class="tm-pie__redes" aria-label="Redes sociales">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="Instagram">◎</a>
        <a href="#" aria-label="TikTok">♪</a>
        <a href="#" aria-label="YouTube">▶</a>
      </div>
    </div>
  </div>

  <p class="tm-pie__legal">
    © {anio} tu tienda.com — Todos los derechos reservados. Diseño y estructura de
    referencia (demo).
  </p>
</footer>

<style>
  .tm-pie {
    background: var(--tm-blanco);
    border-top: 1px solid var(--tm-gris-borde);
    padding-block: 2.5rem 1.5rem;
  }

  .tm-pie__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .tm-pie__col h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .tm-pie__col ul {
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .tm-pie__col a {
    font-size: 0.82rem;
    color: var(--tm-gris-texto);
  }

  .tm-pie__col a:hover {
    color: var(--tm-tinta);
  }

  .tm-pie__pagos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tm-pie__pagos span {
    font-size: 0.66rem;
    font-weight: 800;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--tm-gris-borde);
    border-radius: 5px;
  }

  .tm-pie__redes {
    display: flex;
    gap: 0.5rem;
  }

  .tm-pie__redes a {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--tm-gris-borde);
    border-radius: 50%;
    font-size: 0.9rem;
  }

  .tm-pie__legal {
    text-align: center;
    font-size: 0.72rem;
    color: var(--tm-gris-texto);
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .tm-pie__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tm-pie__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
