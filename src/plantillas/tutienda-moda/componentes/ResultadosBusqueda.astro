---
import TarjetaProducto from './TarjetaProducto.astro';
import { productos, sugerencias } from '../datos/productos.js';

const base = '/plantillas/tutienda-moda';

const norm = (s: unknown) =>
  (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const conHeno = productos.map((p) => ({
  p,
  heno: norm([p.nombre, p.categoria, ...(p.tags ?? [])].join(' ')),
}));
---

<section class="tm-cat">
  <div class="tm-contenedor">
    <nav class="tm-cat__crumbs" aria-label="Ruta">
      <a href={`${base}/`}>Inicio</a>
      <span>/</span>
      <span aria-current="page">Búsqueda</span>
    </nav>

    <header class="tm-busca__head">
      <h1 class="tm-titulo-seccion">
        Resultados para <span id="mk-q" class="tm-busca__q">…</span>
      </h1>
      <p class="tm-busca__conteo"><span id="mk-n">0</span> productos encontrados</p>
    </header>

    
    <div class="tm-busca__vacio" id="mk-vacio" hidden>
      <p>No encontramos productos para <b id="mk-q2"></b>.</p>
      <p class="tm-busca__prueba">Prueba con:</p>
      <div class="tm-busca__chips">
        {
          sugerencias.map((s) => (
            <a href={`${base}/buscar/?q=${encodeURIComponent(s)}`} class="tm-cat__chip">
              {s}
            </a>
          ))
        }
      </div>
    </div>

    
    <div class="tm-cat__grid" id="mk-grid">
      {
        conHeno.map(({ p, heno }) => (
          <div data-buscable data-heno={heno}>
            <TarjetaProducto producto={p} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const norm = (s: string) =>
    (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const params = new URLSearchParams(location.search);
  const termino = (params.get('q') ?? '').trim();
  const palabras = norm(termino).split(/\s+/).filter(Boolean);

  const items = [...document.querySelectorAll<HTMLElement>('[data-buscable]')];
  const elQ = document.getElementById('mk-q');
  const elQ2 = document.getElementById('mk-q2');
  const elN = document.getElementById('mk-n');
  const elVacio = document.getElementById('mk-vacio');
  const elGrid = document.getElementById('mk-grid');

  if (elQ) elQ.textContent = termino ? `“${termino}”` : '(vacío)';
  if (elQ2) elQ2.textContent = `“${termino}”`;

  let visibles = 0;
  for (const it of items) {
    const heno = it.dataset.heno ?? '';
    const ok = palabras.length > 0 && palabras.every((w) => heno.includes(w));
    it.hidden = !ok;
    if (ok) visibles++;
  }

  if (elN) elN.textContent = String(visibles);
  if (elVacio) elVacio.hidden = visibles > 0;
  if (elGrid) elGrid.hidden = visibles === 0;

  
  const inputCab = document.querySelector<HTMLInputElement>('.tm-buscador__input');
  if (inputCab && termino) inputCab.value = termino;
</script>

<style>
  .tm-cat {
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4rem);
  }

  .tm-cat__crumbs {
    display: flex;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--tm-gris-texto);
    margin-bottom: 1rem;
  }

  .tm-busca__head {
    margin-bottom: 1.5rem;
  }

  .tm-busca__q {
    color: var(--tm-tinta);
  }

  .tm-busca__conteo {
    font-size: 0.82rem;
    color: var(--tm-gris-texto);
    margin-top: 0.35rem;
  }

  .tm-busca__vacio {
    border: 1px dashed var(--tm-gris-borde);
    border-radius: var(--tm-radio);
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .tm-busca__prueba {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  .tm-busca__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.75rem;
  }

  .tm-cat__chip {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--tm-gris-borde);
    border-radius: var(--tm-radio-pill);
    background: var(--tm-blanco);
  }

  .tm-cat__chip:hover {
    border-color: var(--tm-negro);
  }

  .tm-cat__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 980px) {
    .tm-cat__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 680px) {
    .tm-cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
