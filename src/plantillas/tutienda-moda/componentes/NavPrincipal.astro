---
import { navItems, navPills, whatsapp } from '../datos/nav.js';

const { activo } = Astro.props; 
const waHref = `https://wa.me/${whatsapp.numero}?text=${encodeURIComponent(whatsapp.mensaje)}`;
---

<nav class="tm-nav" aria-label="Navegación principal">
  <div class="tm-contenedor tm-nav__inner" id="tm-nav-inner">
    <a class="tm-nav__atencion" href={waHref} target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.6.7.7-2.5-.2-.3A8 8 0 0 1 12 4z" />
      </svg>
      <span>Atención<br />al cliente</span>
    </a>

    <ul class="tm-nav__lista">
      {
        navItems.map((it) => (
          <li>
            <a
              href={it.href}
              class:list={['tm-nav__link', { 'is-activo': activo === it.etiqueta }]}
            >
              {it.etiqueta}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="tm-nav__pills">
      {
        navPills.map((p) => (
          <a href={p.href} class:list={['tm-pill', `tm-pill--${p.tono}`]}>
            {p.etiqueta}
            {p.bang && <span class="tm-pill__bang">!</span>}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  .tm-nav {
    background: var(--tm-blanco);
    border-bottom: 1px solid var(--tm-gris-borde);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .tm-nav__inner {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
  }

  .tm-nav__atencion {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 0.9rem;
    margin-block: 0.4rem;
    border: 1px solid var(--tm-gris-borde);
    border-radius: 8px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--tm-tinta);
    flex-shrink: 0;
  }

  .tm-nav__atencion svg {
    color: var(--tm-verde-wa);
    flex-shrink: 0;
  }

  .tm-nav__lista {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.2rem);
    list-style: none;
    flex: 1;
  }

  .tm-nav__link {
    display: inline-block;
    padding: 1rem 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--tm-tinta);
    border-bottom: 3px solid transparent;
  }

  .tm-nav__link:hover,
  .tm-nav__link.is-activo {
    border-bottom-color: var(--tm-amarillo);
  }

  .tm-nav__pills {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .tm-pill__bang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    border-radius: 50%;
    background: var(--tm-negro);
    color: var(--tm-amarillo);
    font-size: 0.75em;
  }

  @media (max-width: 860px) {
    .tm-nav__inner {
      flex-wrap: wrap;
    }
    .tm-nav__lista {
      order: 3;
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .tm-nav__inner.is-abierto .tm-nav__lista {
      max-height: 60vh;
    }
    .tm-nav__link {
      display: block;
      width: 100%;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--tm-gris-borde);
    }
    .tm-nav__pills {
      order: 2;
      margin-left: auto;
    }
  }
</style>
