---
const anio = new Date().getFullYear();

const cols = [
  { titulo: 'Distritos de Lima', enlaces: ['Miraflores & malecón', 'San Isidro & Casa Moreyra', 'Barranco & alturas'] },
  { titulo: 'Tipos de experiencia', enlaces: ['Omakase nikkei', 'Biodiversidad andina', 'Cevichería de autor', 'Carnes dry aged'] },
  { titulo: 'Para restaurantes', enlaces: ['Demostración para clientes', 'Integración WhatsApp & POS', 'Contacto comercial'] },
];
---

<footer class="rg-footer">
  <div class="rg-wrap">
    <div class="rg-footer__grid">
      <div>
        <div class="rg-hdr__brand" style="margin-bottom:1rem">
          <span class="rg-logo-symbol">E</span>
          <span class="rg-logo-text">
            <span class="rg-logo-title">EPICURA</span>
            <span class="rg-logo-sub">Alta cocina · reservas</span>
          </span>
        </div>
        <p class="rg-footer__lead">
          Plataforma de alta cocina peruana y reservas en tiempo real. Diseñada para presentar
          a restaurantes de autor la experiencia digital más sofisticada del mercado.
        </p>
      </div>
      {
        cols.map((c) => (
          <div>
            <h4 class="rg-footer__col-title">{c.titulo}</h4>
            <ul class="rg-footer__links">
              {c.enlaces.map((e) => (
                <li>
                  <a href="#">{e}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="rg-footer__bottom">
      <p>© {anio} Epicura · Plantilla de demostración para clientes gastronómicos.</p>
      <p class="rg-footer__gold">Hecho con excelencia culinaria 100% peruana.</p>
    </div>
  </div>
</footer>

<style>
  .rg-footer {
    background: var(--rg-bg-subtle);
    border-top: 1px solid var(--rg-border-subtle);
    padding-block: 3rem 1.5rem;
    margin-top: 3rem;
  }

  .rg-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 2rem;
  }

  .rg-footer__lead {
    font-size: 0.86rem;
    color: var(--rg-text-muted);
    max-width: 340px;
    line-height: 1.6;
  }

  .rg-footer__col-title {
    font-family: var(--rg-font-display);
    font-size: 0.9rem;
    color: var(--rg-gold-300);
    margin-bottom: 0.8rem;
  }

  .rg-footer__links {
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .rg-footer__links a {
    font-size: 0.82rem;
    color: var(--rg-text-muted);
  }

  .rg-footer__links a:hover {
    color: var(--rg-text-primary);
  }

  .rg-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rg-border-subtle);
    font-size: 0.78rem;
    color: var(--rg-text-dim);
  }

  .rg-footer__gold {
    color: var(--rg-gold-400);
  }

  @media (max-width: 820px) {
    .rg-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .rg-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
