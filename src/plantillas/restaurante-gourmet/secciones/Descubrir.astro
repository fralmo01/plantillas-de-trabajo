---
import { restaurantes, distritos, cocinas } from '../datos/restaurantes.js';

const norm = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
---

<div class="rg-filterbar-wrap" id="rutas">
  <div class="rg-wrap rg-filterbar">
    <label class="rg-filter-search">
      <svg class="rg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
      <input type="search" id="rg-q" placeholder="Buscar por restaurante, cocina o chef…" aria-label="Buscar" />
    </label>
    <div class="rg-filter-selects">
      <select class="rg-select" id="rg-f-cocina" aria-label="Tipo de cocina">
        <option value="todas">Todas las cocinas</option>
        {cocinas.map((c: string) => <option value={c}>{c}</option>)}
      </select>
      <select class="rg-select" id="rg-f-distrito" aria-label="Distrito">
        <option value="todos">Todos los distritos</option>
        {distritos.map((d) => <option value={d.nombre}>{d.nombre}</option>)}
      </select>
      <select class="rg-select" id="rg-f-precio" aria-label="Rango de precio">
        <option value="todos">Cualquier precio</option>
        <option value="$$$">Gourmet (S/ 60 – 150)</option>
        <option value="$$$$">Degustación (S/ 150+)</option>
      </select>
      <button class="rg-pill" id="rg-f-top50" type="button">🏆 The World’s 50 Best</button>
    </div>
  </div>
</div>

<section class="rg-seccion rg-wrap" id="descubrir">
  <div class="rg-seccion-head">
    <div>
      <h2 class="rg-seccion-head__title">Mesas destacadas en Lima</h2>
      <p class="rg-seccion-head__sub">
        Selección curada de restaurantes galardonados con disponibilidad confirmada en tiempo real.
      </p>
    </div>
    <div class="rg-count" id="rg-count">Mostrando {restaurantes.length} experiencias</div>
  </div>

  <div class="rg-grid" id="rg-grid">
    {
      restaurantes.map((r) => (
        <article
          class="rg-card"
          data-buscable
          data-heno={norm([r.nombre, r.cocina, r.chef, r.distrito].join(' '))}
          data-cocina={r.cocina}
          data-distrito={r.distrito}
          data-precio={r.nivelPrecio}
          data-top50={String(r.top50)}
        >
          <div class="rg-card__media">
            <img src={r.img} alt={r.nombre} loading="lazy" />
            <span class="rg-card__award">⭐ {r.reconocimiento}</span>
          </div>
          <div class="rg-card__body">
            <div class="rg-card__head">
              <h3>{r.nombre}</h3>
              <span class="rg-card__rating">★ {r.calificacion}</span>
            </div>
            <p class="rg-card__cuisine">
              {r.cocina} &middot; <span>{r.distrito}</span>
            </p>
            <p class="rg-card__desc">{r.descripcion}</p>
            <div class="rg-card__info">
              <span>Chef: <strong>{r.chef}</strong></span>
              <span class="rg-card__price">{r.nivelPrecio}</span>
            </div>
            <p class="rg-card__slots-lbl">Pases disponibles hoy:</p>
            <div class="rg-card__slots">
              {r.horarios.map((h: string) => <button type="button" class="rg-slot">{h}</button>)}
            </div>
            <div class="rg-card__actions">
              <button type="button" class="rg-btn rg-btn--gold-outline rg-btn--sm rg-btn--full">Ver ficha &amp; carta</button>
              <button type="button" class="rg-btn rg-btn--gold rg-btn--sm rg-btn--full">Reservar</button>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p class="rg-vacio" id="rg-vacio" hidden>
    No encontramos restaurantes con esos filtros.
    <button type="button" id="rg-reset" class="rg-btn rg-btn--gold-outline rg-btn--sm">Limpiar filtros</button>
  </p>

  <div class="rg-rutas">
    <div class="rg-seccion-head">
      <div>
        <h2 class="rg-seccion-head__title">Rutas gastronómicas por distrito</h2>
        <p class="rg-seccion-head__sub">Explora los barrios icónicos de Lima y sus conceptos de alta cocina.</p>
      </div>
    </div>
    <div class="rg-rutas__grid">
      {
        distritos.map((d) => (
          <button type="button" class="rg-ruta" data-ruta={d.nombre}>
            <span class="rg-ruta__media">
              <img src={d.imagen} alt={d.nombre} loading="lazy" />
              <span class="rg-ruta__cap">
                <b>{d.nombre}</b>
                <em>{d.tag}</em>
              </span>
            </span>
            <span class="rg-ruta__desc">{d.descripcion}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const norm = (s: string) =>
    (s ?? '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const cards = [...document.querySelectorAll<HTMLElement>('#rg-grid [data-buscable]')];
  const q = document.getElementById('rg-q') as HTMLInputElement | null;
  const fCocina = document.getElementById('rg-f-cocina') as HTMLSelectElement | null;
  const fDistrito = document.getElementById('rg-f-distrito') as HTMLSelectElement | null;
  const fPrecio = document.getElementById('rg-f-precio') as HTMLSelectElement | null;
  const fTop50 = document.getElementById('rg-f-top50');
  const count = document.getElementById('rg-count');
  const vacio = document.getElementById('rg-vacio');

  function aplicar() {
    const term = norm(q?.value ?? '');
    const coc = fCocina?.value ?? 'todas';
    const dis = fDistrito?.value ?? 'todos';
    const pre = fPrecio?.value ?? 'todos';
    const soloTop = fTop50?.classList.contains('is-active');
    let visibles = 0;

    for (const c of cards) {
      const ok =
        (!term || (c.dataset.heno ?? '').includes(term)) &&
        (coc === 'todas' || c.dataset.cocina === coc) &&
        (dis === 'todos' || c.dataset.distrito === dis) &&
        (pre === 'todos' || c.dataset.precio === pre) &&
        (!soloTop || c.dataset.top50 === 'true');
      c.hidden = !ok;
      if (ok) visibles++;
    }
    if (count) count.textContent = `Mostrando ${visibles} experiencia${visibles === 1 ? '' : 's'}`;
    if (vacio) vacio.hidden = visibles > 0;
  }

  q?.addEventListener('input', aplicar);
  [fCocina, fDistrito, fPrecio].forEach((s) => s?.addEventListener('change', aplicar));
  fTop50?.addEventListener('click', () => {
    fTop50.classList.toggle('is-active');
    aplicar();
  });
  document.getElementById('rg-reset')?.addEventListener('click', () => {
    if (q) q.value = '';
    [fCocina, fDistrito, fPrecio].forEach((s) => s && (s.value = s.options[0].value));
    fTop50?.classList.remove('is-active');
    aplicar();
  });
  document.querySelectorAll<HTMLElement>('.rg-ruta').forEach((r) =>
    r.addEventListener('click', () => {
      if (fDistrito) fDistrito.value = r.dataset.ruta ?? 'todos';
      aplicar();
      document.getElementById('descubrir')?.scrollIntoView({ behavior: 'smooth' });
    }),
  );
</script>

<style>
  .rg-filterbar-wrap {
    position: sticky;
    top: 62px;
    z-index: 40;
    background: rgba(13, 18, 31, 0.9);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--rg-border-subtle);
  }

  .rg-filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.85rem;
  }

  .rg-filter-search {
    flex: 1;
    min-width: 220px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--rg-bg-card);
    border: 1px solid var(--rg-border-medium);
    border-radius: var(--rg-radius-full);
    padding: 0.55rem 1rem;
    color: var(--rg-text-muted);
  }

  .rg-filter-search input {
    flex: 1;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--rg-text-primary);
    font-size: 0.88rem;
  }

  .rg-filter-selects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rg-select {
    background: var(--rg-bg-card);
    border: 1px solid var(--rg-border-medium);
    border-radius: var(--rg-radius-full);
    padding: 0.5rem 1.75rem 0.5rem 0.9rem;
    font-size: 0.8rem;
    color: var(--rg-text-secondary);
  }

  .rg-pill {
    border: 1px solid var(--rg-border-medium);
    border-radius: var(--rg-radius-full);
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--rg-text-secondary);
  }

  .rg-pill.is-active {
    background: linear-gradient(135deg, var(--rg-gold-400), var(--rg-gold-600));
    color: #070a11;
    border-color: transparent;
  }

  .rg-count {
    font-size: 0.85rem;
    color: var(--rg-gold-400);
    font-weight: 600;
  }

  .rg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .rg-card {
    background: var(--rg-bg-card);
    border: 1px solid var(--rg-border-subtle);
    border-radius: var(--rg-radius-lg);
    overflow: hidden;
    transition: var(--rg-transition);
  }

  .rg-card:hover {
    border-color: var(--rg-border-medium);
    background: var(--rg-bg-card-hover);
    transform: translateY(-3px);
  }

  .rg-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .rg-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-card__award {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: rgba(7, 10, 17, 0.82);
    color: var(--rg-gold-300);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.55rem;
    border-radius: var(--rg-radius-full);
  }

  .rg-card__body {
    padding: 1.15rem 1.2rem 1.3rem;
  }

  .rg-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .rg-card__head h3 {
    font-family: var(--rg-font-display);
    font-size: 1.15rem;
    font-weight: 800;
  }

  .rg-card__rating {
    color: var(--rg-gold-400);
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .rg-card__cuisine {
    font-size: 0.8rem;
    color: var(--rg-gold-300);
    margin: 0.3rem 0 0.6rem;
  }

  .rg-card__cuisine span {
    color: var(--rg-text-muted);
  }

  .rg-card__desc {
    font-size: 0.83rem;
    color: var(--rg-text-secondary);
    margin-bottom: 0.9rem;
  }

  .rg-card__info {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--rg-text-muted);
    padding-block: 0.6rem;
    border-top: 1px solid var(--rg-border-subtle);
  }

  .rg-card__price {
    color: var(--rg-gold-400);
    font-weight: 700;
  }

  .rg-card__slots-lbl {
    font-size: 0.68rem;
    color: var(--rg-text-dim);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0.4rem 0 0.5rem;
  }

  .rg-card__slots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .rg-slot {
    border: 1px solid var(--rg-border-medium);
    border-radius: 8px;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    color: var(--rg-text-secondary);
  }

  .rg-slot:hover {
    border-color: var(--rg-gold-500);
    color: var(--rg-gold-300);
  }

  .rg-card__actions {
    display: flex;
    gap: 0.5rem;
  }

  .rg-vacio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding: 3.5rem 1rem;
    background: var(--rg-bg-card);
    border: 1px dashed var(--rg-border-medium);
    border-radius: var(--rg-radius-xl);
    color: var(--rg-text-muted);
  }

  .rg-rutas {
    margin-top: 4rem;
  }

  .rg-rutas__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .rg-ruta {
    text-align: left;
    background: var(--rg-bg-card);
    border: 1px solid var(--rg-border-subtle);
    border-radius: var(--rg-radius-lg);
    overflow: hidden;
    transition: var(--rg-transition);
  }

  .rg-ruta:hover {
    border-color: var(--rg-gold-500);
    transform: translateY(-3px);
  }

  .rg-ruta__media {
    position: relative;
    display: block;
    height: 160px;
  }

  .rg-ruta__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-ruta__cap {
    position: absolute;
    inset: auto 1rem 0.8rem;
    z-index: 1;
  }

  .rg-ruta__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(7, 10, 17, 0.9), transparent 75%);
  }

  .rg-ruta__cap b {
    display: block;
    font-family: var(--rg-font-display);
    font-size: 1.1rem;
  }

  .rg-ruta__cap em {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--rg-gold-300);
    font-weight: 600;
  }

  .rg-ruta__desc {
    display: block;
    padding: 1rem;
    font-size: 0.8rem;
    color: var(--rg-text-muted);
  }
</style>
