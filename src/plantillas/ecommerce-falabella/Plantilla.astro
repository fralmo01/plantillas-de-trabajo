---
import './estilos.css';

import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import ZonaAccesos from './secciones/ZonaAccesos.astro';
import CarruselProductos from './secciones/CarruselProductos.astro';
import Beneficios from './secciones/Beneficios.astro';
import Catalogo from './secciones/Catalogo.astro';
import PiePagina from './secciones/PiePagina.astro';
---

<div class="tpl-ecommerce-falabella">
  <Cabecera />
  <main>
    <HeroCarrusel />
    <ZonaAccesos />
    <CarruselProductos titulo="Ofertas del día" filtro="oferta" id="ofertas" />
    <Beneficios />
    <Catalogo />
    <CarruselProductos titulo="Recomendados para ti" id="recomendados" />
  </main>
  <PiePagina />
</div>
