---
import { accesos } from '../datos/catalogo.js';
---

<section class="ef-wrap ef-seccion">
  <div class="ef-accesos">
    {
      accesos.map((a) => (
        <a href="#" class="ef-acceso">
          <span aria-hidden="true">{a.icono}</span>
          {a.nombre}
        </a>
      ))
    }
  </div>
</section>

<style>
  .ef-accesos {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
  }

  .ef-acceso {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    background: #fff;
    border: 1px solid var(--ef-linea);
    border-radius: var(--ef-radio);
    padding: 0.9rem 0.5rem;
    font-size: 0.74rem;
    font-weight: 600;
  }

  .ef-acceso span {
    font-size: 1.3rem;
  }

  .ef-acceso:hover {
    border-color: var(--ef-verde);
  }

  @media (max-width: 720px) {
    .ef-accesos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
