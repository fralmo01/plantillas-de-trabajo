---
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import { productos } from '../datos/catalogo.js';

const { titulo, filtro, id } = Astro.props as {
  titulo: string;
  filtro?: 'oferta' | 'nuevo';
  id?: string;
};

let lista = productos;
if (filtro === 'oferta') lista = productos.filter((p) => p.antes);
if (filtro === 'nuevo') lista = productos.filter((p) => p.tag === 'Nuevo');
lista = lista.slice(0, 10);
---

<section class="ef-wrap ef-seccion" id={id}>
  <h2 class="ef-titulo">{titulo}</h2>
  <div class="ef-fila ef-fila--5">
    {lista.map((p) => <TarjetaProducto producto={p} />)}
  </div>
</section>
