---
import { banners } from '../datos/catalogo.js';
---

<section class="ef-hero" aria-roledescription="carrusel" aria-label="Banners promocionales">
  <div class="ef-hero__track" id="ef-hero-track">
    {
      banners.map((b, i) => (
        <article class:list={['ef-hero__slide', `ef-hero__slide--${b.tema}`]} data-i={i}>
          <img src={`https://picsum.photos/seed/${b.seed}/1400/440`} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="ef-hero__texto">
            <span class="ef-hero__kicker">{b.kicker}</span>
            <h2>{b.titulo}</h2>
            <p>{b.sub}</p>
            <a href="#ofertas" class="ef-btn">{b.cta}</a>
          </div>
        </article>
      ))
    }
  </div>
  <button class="ef-hero__nav ef-hero__nav--prev" id="ef-hero-prev" aria-label="Anterior">‹</button>
  <button class="ef-hero__nav ef-hero__nav--next" id="ef-hero-next" aria-label="Siguiente">›</button>
  <div class="ef-hero__dots" id="ef-hero-dots">
    {banners.map((_, i) => <button aria-label={`Slide ${i + 1}`} data-dot={i}></button>)}
  </div>
</section>

<script>
  const track = document.getElementById('ef-hero-track');
  const dots = [...document.querySelectorAll<HTMLButtonElement>('#ef-hero-dots button')];
  const total = track ? track.children.length : 0;
  let idx = 0;
  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }
  document.getElementById('ef-hero-prev')?.addEventListener('click', () => ir(idx - 1));
  document.getElementById('ef-hero-next')?.addEventListener('click', () => ir(idx + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => ir(i)));
  let t = setInterval(() => ir(idx + 1), 6000);
  track?.parentElement?.addEventListener('mouseenter', () => clearInterval(t));
  track?.parentElement?.addEventListener('mouseleave', () => (t = setInterval(() => ir(idx + 1), 6000)));
  ir(0);
</script>

<style>
  .ef-hero {
    position: relative;
    max-width: var(--ef-max);
    margin: 1rem auto 0;
    padding-inline: clamp(0.75rem, 3vw, 2rem);
    overflow: hidden;
  }

  .ef-hero__track {
    display: flex;
    transition: transform 0.45s ease;
    border-radius: var(--ef-radio);
    overflow: hidden;
  }

  .ef-hero__slide {
    position: relative;
    flex: 0 0 100%;
    min-height: clamp(220px, 30vw, 380px);
  }

  .ef-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ef-hero__texto {
    position: relative;
    z-index: 1;
    max-width: 40ch;
    padding: clamp(1.5rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.92), transparent);
    height: 100%;
  }

  .ef-hero__slide--oscuro .ef-hero__texto {
    background: linear-gradient(90deg, rgba(20, 20, 20, 0.85), transparent);
    color: #fff;
  }

  .ef-hero__slide--oscuro h2,
  .ef-hero__slide--oscuro .ef-hero__kicker {
    color: #fff;
  }

  .ef-hero__slide--morado .ef-hero__texto {
    background: linear-gradient(90deg, rgba(123, 31, 162, 0.9), transparent);
    color: #fff;
  }

  .ef-hero__slide--morado h2,
  .ef-hero__slide--morado .ef-hero__kicker {
    color: #fff;
  }

  .ef-hero__kicker {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ef-verde-osc);
  }

  .ef-hero__texto h2 {
    font-size: clamp(1.4rem, 3.5vw, 2.4rem);
  }

  .ef-hero__texto p {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .ef-hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--ef-tinta);
    font-size: 1.3rem;
    line-height: 1;
  }

  .ef-hero__nav--prev {
    left: 1.5rem;
  }
  .ef-hero__nav--next {
    right: 1.5rem;
  }

  .ef-hero__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .ef-hero__dots button {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
  }

  .ef-hero__dots button.is-on {
    background: var(--ef-verde);
    width: 22px;
  }
</style>
