---
import { topLinks, marca } from '../datos/motors.js';
---

<div class="tm-top">
  <div class="tm-wrap tm-top__inner">
    <nav class="tm-top__links" aria-label="Accesos">
      {topLinks.map((l: string) => <a href="#">{l}</a>)}
      <a href="#"><span aria-hidden="true">📞</span> {marca.tel}</a>
    </nav>
    <div class="tm-top__redes" aria-label="Redes">
      <a href="#" aria-label="Facebook">f</a>
      <a href="#" aria-label="Instagram">◎</a>
      <a href="#" aria-label="YouTube">▶</a>
    </div>
  </div>
</div>

<style>
  .tm-top {
    background: var(--tm-rojo);
    color: #fff;
    font-size: 0.76rem;
  }

  .tm-top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.4rem;
  }

  .tm-top__links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .tm-top__links a:hover {
    text-decoration: underline;
  }

  .tm-top__redes {
    display: flex;
    gap: 0.4rem;
  }

  .tm-top__redes a {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    font-size: 0.7rem;
  }

  @media (max-width: 620px) {
    .tm-top__links {
      gap: 0.75rem;
    }
  }
</style>
