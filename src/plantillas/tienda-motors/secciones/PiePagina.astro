---
import { marca } from '../datos/motors.js';
const anio = new Date().getFullYear();
const cols = [
  { titulo: 'Empresa', enlaces: ['Nosotros', 'Post venta', 'Tiendas y talleres', 'Financiamiento', 'Agenda cita en taller'] },
  { titulo: 'Información', enlaces: ['Llamados a revisión', 'Comunicados', 'Noticias', 'Contacto', 'Términos y condiciones'] },
];
---

<footer class="tm-ftr">
  <div class="tm-wrap tm-ftr__grid">
    <div class="tm-ftr__marca">
      <span class="tm-ftr__logo">
        <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><path d="M12 2 3 20h18L12 2zm0 5 4.5 9h-9L12 7z" /></svg>
        {marca.nombre}<b>{marca.sub}</b>
      </span>
      <p>Concesionario multimarca. Venta de autos, camiones y servicio post venta en todo el país.</p>
    </div>

    {
      cols.map((c) => (
        <div>
          <h4>{c.titulo}</h4>
          <ul>
            {c.enlaces.map((e) => (
              <li>
                <a href="#">{e}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h4>Casa matriz</h4>
      <p class="tm-ftr__dato">Av. El Polo 1117, Santiago de Surco, Lima</p>
      <p class="tm-ftr__dato">Central telefónica: {marca.tel}</p>
      <h4 style="margin-top:1rem">Atención callcenter</h4>
      <p class="tm-ftr__dato">L–V: 8:30 a 18:00 · Sáb: 8:30 a 13:00</p>
    </div>
  </div>
  <p class="tm-ftr__legal">Maqueta de referencia (demo). Precios y cálculos referenciales, sin valor de oferta. © {anio} {marca.nombre} {marca.sub}</p>
</footer>

<style>
  .tm-ftr {
    background: var(--tm-footer);
    color: rgba(255, 255, 255, 0.72);
    padding-block: 2.75rem 1.5rem;
  }

  .tm-ftr__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2rem;
  }

  .tm-ftr__logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 900;
    font-size: 1.15rem;
    color: #fff;
  }

  .tm-ftr__logo b {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--tm-rojo);
  }

  .tm-ftr__marca p {
    font-size: 0.82rem;
    max-width: 320px;
    margin-top: 0.75rem;
  }

  .tm-ftr h4 {
    color: #fff;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.7rem;
  }

  .tm-ftr ul {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .tm-ftr a {
    font-size: 0.82rem;
  }

  .tm-ftr a:hover {
    color: #fff;
  }

  .tm-ftr__dato {
    font-size: 0.8rem;
  }

  .tm-ftr__legal {
    text-align: center;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 900px) {
    .tm-ftr__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tm-ftr__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
