---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import QueBuscas from './secciones/QueBuscas.astro';
import ModelosDestacados from './secciones/ModelosDestacados.astro';
import Novedades from './secciones/Novedades.astro';
import Marcas from './secciones/Marcas.astro';
import Cotiza from './secciones/Cotiza.astro';
import Legales from './secciones/Legales.astro';
import PiePagina from './secciones/PiePagina.astro';
---

<div class="tpl-tienda-motors">
  <BarraSuperior />
  <Cabecera />
  <main>
    <HeroCarrusel />
    <QueBuscas />
    <ModelosDestacados />
    <Novedades />
    <Marcas />
    <Cotiza />
    <Legales />
  </main>
  <PiePagina />
</div>
