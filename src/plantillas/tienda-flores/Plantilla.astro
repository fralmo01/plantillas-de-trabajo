---
import './estilos.css';

import BarraSuperior from './secciones/BarraSuperior.astro';
import Cabecera from './secciones/Cabecera.astro';
import HeroCarrusel from './secciones/HeroCarrusel.astro';
import Ocasiones from './secciones/Ocasiones.astro';
import Novedades from './secciones/Novedades.astro';
import Destacados from './secciones/Destacados.astro';
import MasVendidos from './secciones/MasVendidos.astro';
import Categorias from './secciones/Categorias.astro';
import Banners from './secciones/Banners.astro';
import Garantias from './secciones/Garantias.astro';
import Newsletter from './secciones/Newsletter.astro';
import PiePagina from './secciones/PiePagina.astro';
import ChatBot from './secciones/ChatBot.astro';
---

<div class="tpl-tienda-flores">
  <BarraSuperior />
  <Cabecera />
  <main>
    <HeroCarrusel />
    <Ocasiones />
    <Novedades />
    <Destacados />
    <MasVendidos />
    <Categorias />
    <Banners />
    <Garantias />
    <Newsletter />
  </main>
  <PiePagina />
  <ChatBot />
</div>
