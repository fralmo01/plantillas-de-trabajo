---
import { categorias } from '../datos/flores.js';
---

<section class="tf-seccion tf-wrap" id="categorias">
  <h2 class="tf-titulo">Todos los regalos terminan en sonrisas</h2>
  <ul class="tf-cats">
    {categorias.map((c: { t: string; img: string }) => (
      <li>
        <a href="#destacados" class="tf-cats__item">
          <span class="tf-cats__foto"><img src={c.img} alt={c.t} loading="lazy" /></span>
          <span class="tf-cats__lbl">{c.t}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .tf-cats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .tf-cats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .tf-cats__foto {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 190px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--tf-rosa);
    display: block;
  }

  .tf-cats__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .tf-cats__item:hover .tf-cats__foto img {
    transform: scale(1.07);
  }

  .tf-cats__lbl {
    font-family: var(--tf-serif);
    font-style: italic;
    color: var(--tf-rojo);
    font-size: 1.15rem;
  }

  @media (max-width: 820px) {
    .tf-cats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tf-cats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
