---
import { banners } from '../datos/flores.js';
---

<section class="tf-seccion tf-wrap">
  <div class="tf-bnrs">
    {banners.map((b: { titulo: string; sub: string; img: string }) => (
      <a href="#destacados" class="tf-bnr">
        <img src={b.img} alt={b.titulo} loading="lazy" />
        <span class="tf-bnr__tx">
          <b>{b.titulo}</b>
          <em>{b.sub}</em>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .tf-bnrs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .tf-bnr {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    background: var(--tf-rosa);
  }

  .tf-bnr img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .tf-bnr:hover img {
    transform: scale(1.05);
  }

  .tf-bnr__tx {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.25rem;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: linear-gradient(0deg, rgba(43, 43, 43, 0.72), transparent);
  }

  .tf-bnr__tx b {
    font-family: var(--tf-serif);
    font-size: 1.3rem;
  }

  .tf-bnr__tx em {
    font-style: normal;
    font-size: 0.8rem;
    opacity: 0.9;
  }

  @media (max-width: 820px) {
    .tf-bnrs {
      grid-template-columns: 1fr;
    }
  }
</style>
