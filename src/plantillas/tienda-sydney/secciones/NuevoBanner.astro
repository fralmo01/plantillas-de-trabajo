---
import { nuevoBanner, getSydneyImg } from '../datos/sydney.js';
---

<section class="sy-nuevo">
  <img src={nuevoBanner.img ?? getSydneyImg(nuevoBanner.seed, 1600, 700)} alt={nuevoBanner.titulo} loading="lazy" />
  <div class="sy-wrap sy-nuevo__tx">
    <h2>{nuevoBanner.titulo}</h2>
    <p>{nuevoBanner.sub}</p>
    <a href="/plantillas/tienda-sydney/buscar/" class="sy-btn sy-btn--claro">{nuevoBanner.cta}</a>
  </div>
</section>

<style>
  .sy-nuevo {
    position: relative;
    min-height: clamp(340px, 50vw, 520px);
    display: flex;
    align-items: flex-end;
  }

  .sy-nuevo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sy-nuevo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.55), transparent 60%);
  }

  .sy-nuevo__tx {
    position: relative;
    z-index: 1;
    color: #fff;
    padding-bottom: 3rem;
    max-width: 34rem;
  }

  .sy-nuevo__tx h2 {
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .sy-nuevo__tx p {
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }
</style>
