---
import { heroSlides, getSydneyImg } from '../datos/sydney.js';

interface Slide {
  kicker: string;
  titulo: string;
  sub: string;
  cta1: string;
  cta2: string;
  seed: string;
  img?: string;
}
---

<section class="sy-hero">
  <div class="sy-hero__track" id="sy-hero-track">
    {(heroSlides as Slide[]).map((s, i) => (
      <article class="sy-hero__slide">
        <img src={s.img ?? getSydneyImg(s.seed, 1600, 750)} alt={s.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="sy-wrap sy-hero__texto">
          <span class="sy-hero__kicker">{s.kicker}</span>
          <h1>{s.titulo}</h1>
          <p>{s.sub}</p>
          <div class="sy-hero__cta">
            <a href="#destacadas" class="sy-btn sy-btn--oscuro">{s.cta1}</a>
            <a href="/plantillas/tienda-sydney/buscar/" class="sy-btn sy-btn--claro">{s.cta2}</a>
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="sy-hero__dots" id="sy-hero-dots">
    {heroSlides.map((_: unknown, i: number) => <button aria-label={`Ir al slide ${i + 1}`} data-dot={i}></button>)}
  </div>
</section>

<script>
  const track = document.getElementById('sy-hero-track');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#sy-hero-dots button'));
  const total = track ? track.children.length : 0;
  let idx = 0;

  function ir(n: number) {
    if (!track) return;
    idx = (n + total) % total;
    track.style.transform = `translateX(-${idx * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
  }

  dots.forEach((d, i) => d.addEventListener('click', () => ir(i)));

  let timer = window.setInterval(() => ir(idx + 1), 6000);
  track?.addEventListener('mouseenter', () => window.clearInterval(timer));
  track?.addEventListener('mouseleave', () => (timer = window.setInterval(() => ir(idx + 1), 6000)));
  ir(0);
</script>

<style>
  .sy-hero {
    position: relative;
    overflow: hidden;
  }

  .sy-hero__track {
    display: flex;
    transition: transform 0.6s ease;
  }

  .sy-hero__slide {
    position: relative;
    flex: 0 0 100%;
    min-height: clamp(360px, 60vw, 640px);
    display: flex;
    align-items: center;
  }

  .sy-hero__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sy-hero__slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(23, 32, 51, 0.55), transparent 60%);
  }

  .sy-hero__texto {
    position: relative;
    z-index: 1;
    color: #fff;
    max-width: 30rem;
  }

  .sy-hero__kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 1rem;
  }

  .sy-hero__texto h1 {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.2rem);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .sy-hero__texto p {
    font-size: 1rem;
    margin-bottom: 1.75rem;
  }

  .sy-hero__cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sy-hero__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    z-index: 1;
  }

  .sy-hero__dots button {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
  }

  .sy-hero__dots button.is-on {
    background: #fff;
    width: 22px;
    border-radius: 999px;
  }
</style>
