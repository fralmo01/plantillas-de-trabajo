---
import { testimonios, getSydneyImg } from '../datos/sydney.js';
---

<section class="sy-seccion sy-wrap">
  <h2 class="sy-titulo">Testimonios</h2>
  <p class="sy-sub">Descubre lo que nuestros clientes dicen sobre nuestros productos.</p>

  <div class="sy-test">
    {testimonios.map((t: { nombre: string; estrellas: number; texto: string; seed: string; img?: string }) => (
      <div class="sy-test__card">
        <div class="sy-test__cab">
          <img src={t.img ?? getSydneyImg(t.seed, 120, 120)} alt={t.nombre} loading="lazy" />
          <div>
            <strong>{t.nombre}</strong>
            <div class="sy-test__estrellas" aria-hidden="true">{'★'.repeat(t.estrellas)}</div>
          </div>
        </div>
        <p>{t.texto}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .sy-test {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .sy-test__cab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .sy-test__cab img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
  }

  .sy-test__cab strong {
    display: block;
    font-size: 0.88rem;
  }

  .sy-test__estrellas {
    color: #f5b400;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .sy-test__card p {
    background: var(--sy-crema);
    padding: 1rem;
    font-size: 0.85rem;
    color: var(--sy-tinta-suave);
  }

  @media (max-width: 820px) {
    .sy-test {
      grid-template-columns: 1fr;
    }
  }
</style>
