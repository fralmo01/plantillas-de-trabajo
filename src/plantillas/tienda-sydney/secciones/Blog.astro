---
import { blogPosts, getSydneyImg } from '../datos/sydney.js';
---

<section class="sy-seccion sy-wrap">
  <div class="sy-blog__cab">
    <div>
      <h2 class="sy-titulo">Nuestro Blog</h2>
      <p class="sy-sub" style="margin-bottom:0">Explora los articulos de tu interes.</p>
    </div>
    <a href="#top" class="sy-btn sy-btn--oscuro">Ver mas</a>
  </div>

  <div class="sy-blog">
    {blogPosts.map((p: { t: string; seed: string; img?: string }) => (
      <a href="#top" class="sy-blog__card">
        <img src={p.img ?? getSydneyImg(p.seed, 600, 420)} alt={p.t} loading="lazy" />
        <h3>{p.t}</h3>
      </a>
    ))}
  </div>
</section>

<style>
  .sy-blog__cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    gap: 1rem;
  }

  .sy-blog {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .sy-blog__card img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 0.9rem;
  }

  .sy-blog__card h3 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .sy-blog {
      grid-template-columns: 1fr;
    }
  }
</style>
