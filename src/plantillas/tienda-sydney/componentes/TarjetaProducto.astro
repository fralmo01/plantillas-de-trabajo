---
import { soles, colores, getSydneyImg } from '../datos/sydney.js';

interface Producto {
  nombre: string;
  precio: number;
  antes?: number;
  tag?: string;
  seed: string;
  img?: string;
}
const { producto } = Astro.props as { producto: Producto };
const img = producto.img ?? getSydneyImg(producto.seed, 500, 600);
const swatches = colores.slice(0, 3 + (producto.seed.length % 3));
---

<article class="sy-prod" data-nombre={producto.nombre.toLowerCase()}>
  <div class="sy-prod__media">
    {producto.tag && <span class="sy-prod__tag">{producto.tag}</span>}
    <img src={img} alt={producto.nombre} loading="lazy" decoding="async" />
  </div>
  <div class="sy-prod__body">
    <h3 class="sy-prod__nombre">{producto.nombre}</h3>
    <p class="sy-prod__precio">
      <b>{soles(producto.precio)}</b>
      {producto.antes && <s>{soles(producto.antes)}</s>}
    </p>
    <div class="sy-prod__swatches" aria-hidden="true">
      {swatches.map((c: string) => <span style={`background:${c}`}></span>)}
    </div>
    <button type="button" class="sy-btn sy-btn--oscuro sy-prod__add">Comprar</button>
  </div>
</article>

<style>
  .sy-prod[hidden] {
    display: none;
  }

  .sy-prod {
    display: flex;
    flex-direction: column;
  }

  .sy-prod__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--sy-crema);
    overflow: hidden;
  }

  .sy-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .sy-prod:hover .sy-prod__media img {
    transform: scale(1.03);
  }

  .sy-prod__tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--sy-rojo);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
  }

  .sy-prod__body {
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sy-prod__nombre {
    font-size: 0.85rem;
    font-weight: 500;
    min-height: 2.4em;
  }

  .sy-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .sy-prod__precio b {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--sy-rojo);
  }

  .sy-prod__precio s {
    color: var(--sy-gris);
    font-size: 0.78rem;
  }

  .sy-prod__swatches {
    display: flex;
    gap: 0.4rem;
  }

  .sy-prod__swatches span {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--sy-linea);
    display: inline-block;
  }

  .sy-prod__add {
    width: 100%;
    margin-top: 0.4rem;
  }

  .sy-prod__add.is-ok {
    background: var(--sy-wa);
    border-color: var(--sy-wa);
  }
</style>
