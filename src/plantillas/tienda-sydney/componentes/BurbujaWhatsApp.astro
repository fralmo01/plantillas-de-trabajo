---
import { whatsapp } from '../datos/sydney.js';

const href = `https://wa.me/${whatsapp.numero}?text=${encodeURIComponent(whatsapp.mensaje)}`;
---

<a class="sy-wa" href={href} target="_blank" rel="noopener" aria-label="Escribenos por WhatsApp">
  <svg width="28" height="28" viewBox="0 0 32 32" fill="currentColor">
    <path d="M16 3C9 3 3.5 8.6 3.5 15.5c0 2.4.7 4.7 1.9 6.7L3 29l7-1.8c1.9 1 4 1.6 6 1.6 7 0 12.5-5.6 12.5-12.5S23 3 16 3zm0 22.6c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.1 1 1-4-.3-.4a10 10 0 0 1-1.6-5.5C5.4 9.9 10.1 5.3 16 5.3s10.6 4.6 10.6 10.2S21.9 25.6 16 25.6zm5.8-7.6c-.3-.2-1.9-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.3-.7.1a8.4 8.4 0 0 1-2.5-1.5 9.3 9.3 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6s.1-.4 0-.6-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.3 2.5 3.8 6 5.3.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 1.9-.8 2.2-1.5s.3-1.4.2-1.5-.3-.2-.6-.4z" />
  </svg>
</a>

<style>
  .sy-wa {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--sy-wa);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.45);
    z-index: 95;
  }

  .sy-wa:hover {
    filter: brightness(1.05);
  }
</style>
