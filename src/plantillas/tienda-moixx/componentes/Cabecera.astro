---
import { marca, navPrincipal } from '../datos/moixx.js';

const base = '/plantillas/tienda-moixx';

interface Item {
  t: string;
  href?: string;
  menu?: string;
  destacado?: boolean;
  columnas?: { t: string; links: string[] }[];
}
---

<header class="mx-hdr" id="top">
  <div class="mx-wrap mx-hdr__row">
    <a href={`${base}/`} class="mx-logo">{marca.nombre}</a>

    <nav class="mx-nav" aria-label="Navegacion principal">
      <ul class="mx-nav__list">
        {(navPrincipal as Item[]).map((n) => (
          <li class={n.menu ? 'mx-nav__has-mega' : ''} data-menu={n.menu}>
            {n.menu ? (
              <button type="button" class={`mx-nav__link${n.destacado ? ' es-destacado' : ''}`} data-abrir={n.menu}>{n.t}</button>
            ) : (
              <a href={n.href} class={`mx-nav__link${n.destacado ? ' es-destacado' : ''}`}>{n.t}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="mx-hdr__acc">
      <button type="button" class="mx-hdr__ico" id="mx-buscar-btn" aria-label="Buscar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <a href={`${base}/#top`} class="mx-hdr__ico" aria-label="Mi cuenta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
      </a>
      <a href={`${base}/#top`} class="mx-hdr__ico" aria-label="Favoritos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.35-9.5-8.5C.8 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.2 4 3.5 7.5C19 16.65 12 21 12 21z"></path></svg>
      </a>
      <button type="button" class="mx-hdr__ico mx-hdr__cart" id="mx-cart" aria-label="Ver carrito">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span class="mx-hdr__badge" id="mx-cart-count" hidden>0</span>
      </button>
    </div>
  </div>

  <form class="mx-buscar" id="mx-buscar" role="search" action={`${base}/buscar/`} method="get" hidden>
    <div class="mx-wrap mx-buscar__inner">
      <input type="search" name="q" id="mx-buscar-input" placeholder="Buscar en tienda.com..." aria-label="Buscar productos" autocomplete="off" />
      <button type="submit">Buscar</button>
    </div>
  </form>

  {(navPrincipal as Item[]).filter((n) => n.menu).map((n) => (
    <div class="mx-mega" data-mega={n.menu} hidden>
      <div class="mx-wrap mx-mega__grid" style={`--cols:${n.columnas?.length ?? 1}`}>
        {n.columnas?.map((c) => (
          <div class="mx-mega__col">
            <h3>{c.t}</h3>
            <ul>
              {c.links.map((l) => <li><a href={`${base}/buscar/?q=${encodeURIComponent(l.toLowerCase())}`}>{l}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  ))}
</header>

<script>
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-abrir]'));
  const megas = Array.from(document.querySelectorAll<HTMLElement>('[data-mega]'));

  function cerrarTodo() {
    megas.forEach((m) => (m.hidden = true));
    btns.forEach((b) => b.classList.remove('is-on'));
  }

  btns.forEach((b) => {
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const nombre = b.dataset.abrir;
      const target = megas.find((m) => m.dataset.mega === nombre);
      const yaAbierto = target && !target.hidden;
      cerrarTodo();
      if (target && !yaAbierto) {
        target.hidden = false;
        b.classList.add('is-on');
      }
    });
  });

  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    const dentro = megas.some((m) => m.contains(t)) || btns.some((b) => b.contains(t));
    if (!dentro) cerrarTodo();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarTodo();
  });

  const buscarBtn = document.getElementById('mx-buscar-btn');
  const buscarForm = document.getElementById('mx-buscar') as HTMLElement | null;
  const buscarInput = document.getElementById('mx-buscar-input') as HTMLInputElement | null;
  buscarBtn?.addEventListener('click', () => {
    if (!buscarForm) return;
    buscarForm.hidden = !buscarForm.hidden;
    if (!buscarForm.hidden) buscarInput?.focus();
  });

  const qActual = new URLSearchParams(location.search).get('q');
  if (buscarInput && qActual) buscarInput.value = qActual;

  const badge = document.getElementById('mx-cart-count');
  let total = 0;
  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const add = el.closest<HTMLButtonElement>('.mx-prod__add');
    if (add) {
      e.preventDefault();
      total += 1;
      if (badge) {
        badge.textContent = String(total);
        badge.hidden = false;
      }
      const prev = add.textContent;
      add.textContent = 'Anadido';
      add.classList.add('is-ok');
      window.setTimeout(() => {
        add.textContent = prev;
        add.classList.remove('is-ok');
      }, 1100);
    }
    const fav = el.closest<HTMLButtonElement>('.mx-prod__fav');
    if (fav) {
      fav.classList.toggle('is-on');
    }
  });
</script>

<style>
  .mx-hdr {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 90;
  }

  .mx-hdr__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }

  .mx-logo {
    font-family: var(--mx-serif);
    font-size: 1.7rem;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .mx-nav__list {
    display: flex;
    gap: 1.9rem;
    list-style: none;
  }

  .mx-nav__link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding-block: 0.4rem;
  }

  .mx-nav__link:hover,
  .mx-nav__link.is-on {
    color: var(--mx-gris);
  }

  .mx-nav__link.es-destacado {
    color: var(--mx-rojo);
  }

  .mx-hdr__acc {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex-shrink: 0;
  }

  .mx-hdr__ico {
    position: relative;
    color: var(--mx-tinta);
    display: grid;
    place-items: center;
  }

  .mx-hdr__ico:hover {
    color: var(--mx-gris);
  }

  .mx-hdr__badge[hidden] {
    display: none;
  }

  .mx-hdr__badge {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 15px;
    height: 15px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--mx-rojo);
    color: #fff;
    font-size: 0.55rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .mx-buscar[hidden] {
    display: none;
  }

  .mx-buscar {
    border-top: 1px solid var(--mx-linea);
    background: var(--mx-crema);
  }

  .mx-buscar__inner {
    display: flex;
    gap: 0.6rem;
    padding-block: 0.85rem;
  }

  .mx-buscar__inner input {
    flex: 1;
    border: none;
    background: transparent;
    border-bottom: 1px solid var(--mx-tinta);
    padding: 0.5rem 0;
    font-size: 0.9rem;
  }

  .mx-buscar__inner input:focus {
    outline: none;
  }

  .mx-buscar__inner button {
    padding: 0.5rem 1.4rem;
    background: var(--mx-tinta);
    color: #fff;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mx-mega[hidden] {
    display: none;
  }

  .mx-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--mx-crema);
    border-top: 1px solid var(--mx-linea);
    box-shadow: 0 30px 50px -30px rgba(0, 0, 0, 0.25);
    z-index: 80;
  }

  .mx-mega__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2rem;
    padding-block: 2.25rem;
  }

  .mx-mega__col h3 {
    font-family: var(--mx-font);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--mx-gris);
    margin-bottom: 1rem;
  }

  .mx-mega__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .mx-mega__col a {
    font-size: 0.85rem;
  }

  .mx-mega__col a:hover {
    color: var(--mx-gris);
  }

  @media (max-width: 960px) {
    .mx-nav__list {
      display: none;
    }
    .mx-mega {
      display: none !important;
    }
  }
</style>
