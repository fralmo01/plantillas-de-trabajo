---
import { soles, filtrosColor, getMoixxImg } from '../datos/moixx.js';

interface Producto {
  nombre: string;
  precio: number;
  antes?: number;
  seed: string;
  img?: string;
}
const { producto } = Astro.props as { producto: Producto };
const img = producto.img ?? getMoixxImg(producto.seed, 500, 650);
const swatches = filtrosColor.slice(0, 2 + (producto.seed.length % 3));
---

<article class="mx-prod" data-nombre={producto.nombre.toLowerCase()}>
  <div class="mx-prod__media">
    <img src={img} alt={producto.nombre} loading="lazy" decoding="async" />
    <button type="button" class="mx-prod__fav" aria-label="Agregar a favoritos">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.35-9.5-8.5C.8 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.2 4 3.5 7.5C19 16.65 12 21 12 21z"></path></svg>
    </button>
    <button type="button" class="mx-btn mx-btn--oscuro mx-prod__add">Anadir</button>
  </div>
  <div class="mx-prod__body">
    <div class="mx-prod__swatches" aria-hidden="true">
      {swatches.map((c: { nombre: string; hex: string }) => <span style={`background:${c.hex}`}></span>)}
    </div>
    <h3 class="mx-prod__nombre">{producto.nombre}</h3>
    <p class="mx-prod__precio">
      {producto.antes && <s>{soles(producto.antes)}</s>}
      <b>{soles(producto.precio)}</b>
    </p>
  </div>
</article>

<style>
  .mx-prod[hidden] {
    display: none;
  }

  .mx-prod {
    display: flex;
    flex-direction: column;
  }

  .mx-prod__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--mx-crema);
    overflow: hidden;
  }

  .mx-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mx-prod__fav {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--mx-tinta);
  }

  .mx-prod__fav.is-on {
    color: var(--mx-rojo);
  }

  .mx-prod__add {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .mx-prod:hover .mx-prod__add {
    opacity: 1;
    transform: translateY(0);
  }

  .mx-prod__add.is-ok {
    background: var(--mx-wa);
  }

  .mx-prod__body {
    padding-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mx-prod__swatches {
    display: flex;
    gap: 0.35rem;
  }

  .mx-prod__swatches span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--mx-linea);
    display: inline-block;
  }

  .mx-prod__nombre {
    font-family: var(--mx-font);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .mx-prod__precio {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.85rem;
  }

  .mx-prod__precio s {
    color: var(--mx-gris);
    font-size: 0.78rem;
  }

  .mx-prod__precio b {
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .mx-prod__add {
      opacity: 1;
      transform: none;
      position: static;
      margin-top: 0.5rem;
      width: 100%;
    }
  }
</style>
