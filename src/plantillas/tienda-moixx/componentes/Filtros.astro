---
import { catalogo, filtrosTipo, filtrosColor, filtrosTalla, ordenarPor } from '../datos/moixx.js';

const contar = (tipo: string) => catalogo.filter((p: Record<string, unknown>) => p.tipo === tipo).length;
---

<aside class="mx-filtros" id="mx-filtros">
  <div class="mx-filtros__cab">
    <span>Filtrar</span>
    <button class="mx-filtros__x" type="button" aria-label="Cerrar filtros">&times;</button>
  </div>

  <form class="mx-filtros__form" onsubmit="return false">
    <details class="mx-grupo" open>
      <summary>Tipo de producto</summary>
      <div class="mx-grupo__cuerpo">
        <ul class="mx-grupo__lista" data-filtro="tipo">
          {filtrosTipo.map((t: string) => (
            <li>
              <label>
                <input type="checkbox" name="tipo" value={t} />
                <span>{t}</span>
                <b>({contar(t)})</b>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <details class="mx-grupo">
      <summary>Color</summary>
      <div class="mx-grupo__cuerpo">
        <div class="mx-grupo__colores">
          {filtrosColor.map((c: { nombre: string; hex: string }) => (
            <button type="button" class="mx-color" title={c.nombre} aria-label={c.nombre}>
              <span style={`background:${c.hex}`}></span>
            </button>
          ))}
        </div>
      </div>
    </details>

    <details class="mx-grupo">
      <summary>Talla</summary>
      <div class="mx-grupo__cuerpo">
        <div class="mx-grupo__tallas">
          {filtrosTalla.map((t: string) => <button type="button" class="mx-talla">{t}</button>)}
        </div>
      </div>
    </details>

    <details class="mx-grupo">
      <summary>Marca</summary>
      <div class="mx-grupo__cuerpo">
        <label class="mx-check"><input type="checkbox" disabled /> <span>tienda.com</span></label>
      </div>
    </details>

    <details class="mx-grupo">
      <summary>Disponibilidad</summary>
      <div class="mx-grupo__cuerpo">
        <label class="mx-check"><input type="checkbox" disabled /> <span>En stock</span></label>
      </div>
    </details>

    <details class="mx-grupo" open>
      <summary>Ordenar por</summary>
      <div class="mx-grupo__cuerpo">
        <ul class="mx-grupo__radios">
          {ordenarPor.map((o: string, i: number) => (
            <li>
              <label>
                <input type="radio" name="orden" value={o} checked={i === 0} />
                <span>{o}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <button type="button" class="mx-btn mx-btn--claro mx-filtros__limpiar" id="mx-filtros-limpiar">Limpiar filtros</button>
  </form>
</aside>

<style>
  .mx-filtros {
    align-self: start;
  }

  .mx-filtros__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .mx-filtros__cab span {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mx-filtros__x {
    display: none;
    font-size: 1.1rem;
  }

  .mx-grupo {
    border-bottom: 1px solid var(--mx-linea);
    padding-block: 0.85rem;
  }

  .mx-grupo summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .mx-grupo summary::-webkit-details-marker {
    display: none;
  }

  .mx-grupo summary::after {
    content: "\002B";
    color: var(--mx-gris);
  }

  .mx-grupo[open] summary::after {
    content: "\2212";
  }

  .mx-grupo__cuerpo {
    padding-top: 0.85rem;
    display: grid;
    gap: 0.6rem;
  }

  .mx-grupo__lista,
  .mx-grupo__radios {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .mx-grupo__lista label,
  .mx-grupo__radios label,
  .mx-check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.83rem;
    cursor: pointer;
  }

  .mx-grupo__lista label b {
    margin-left: auto;
    color: var(--mx-gris);
    font-weight: 500;
    font-size: 0.72rem;
  }

  .mx-grupo__lista input,
  .mx-grupo__radios input,
  .mx-check input {
    accent-color: var(--mx-tinta);
  }

  .mx-grupo__colores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mx-color {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    padding: 2px;
    border: 1px solid var(--mx-linea);
  }

  .mx-color span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .mx-grupo__tallas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mx-talla {
    min-width: 38px;
    padding: 0.4rem;
    border: 1px solid var(--mx-linea);
    font-size: 0.78rem;
  }

  .mx-talla:hover {
    border-color: var(--mx-tinta);
  }

  .mx-filtros__limpiar {
    width: 100%;
    margin-top: 0.5rem;
    border: 1px solid var(--mx-tinta);
  }

  @media (max-width: 900px) {
    .mx-filtros {
      position: fixed;
      inset: 0 25% 0 0;
      z-index: 350;
      background: #fff;
      padding: 1.25rem;
      overflow-y: auto;
      transform: translateX(-105%);
      transition: transform 0.25s ease;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.25);
    }
    .mx-filtros.is-abierto {
      transform: none;
    }
    .mx-filtros__x {
      display: block;
    }
  }
</style>
