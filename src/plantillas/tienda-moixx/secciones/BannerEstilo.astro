---
import { bannerEstilo, getMoixxImg } from '../datos/moixx.js';
---

<section class="mx-estilo">
  <img src={bannerEstilo.img ?? getMoixxImg(bannerEstilo.seed, 1600, 700)} alt={bannerEstilo.titulo} loading="lazy" />
  <div class="mx-estilo__tx">
    <h2>{bannerEstilo.titulo}</h2>
    <p>{bannerEstilo.sub}</p>
    <a href="/plantillas/tienda-moixx/buscar/" class="mx-link-subrayado">{bannerEstilo.cta}</a>
  </div>
</section>

<style>
  .mx-estilo {
    position: relative;
    min-height: clamp(360px, 50vw, 520px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mx-estilo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mx-estilo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
  }

  .mx-estilo__tx {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #fff;
  }

  .mx-estilo__tx h2 {
    color: #fff;
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 0.5rem;
  }

  .mx-estilo__tx p {
    font-family: var(--mx-font);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .mx-estilo__tx a {
    color: #fff;
  }
</style>
