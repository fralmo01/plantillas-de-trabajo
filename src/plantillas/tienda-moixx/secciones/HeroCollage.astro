---
import { heroCollage, getMoixxImg } from '../datos/moixx.js';
---

<section class="mx-hero">
  <div class="mx-hero__paneles">
    {heroCollage.paneles.map((p: { seed: string; img?: string }) => (
      <div class="mx-hero__panel">
        <img src={p.img ?? getMoixxImg(p.seed, 700, 900)} alt={heroCollage.campana} loading="eager" />
      </div>
    ))}
  </div>
  <div class="mx-hero__tx">
    <h1>{heroCollage.campana}</h1>
    <p>{heroCollage.tagline}</p>
    <a href="#grid-1" class="mx-link-subrayado mx-hero__cta">{heroCollage.cta}</a>
  </div>
</section>

<style>
  .mx-hero {
    position: relative;
  }

  .mx-hero__paneles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .mx-hero__panel {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .mx-hero__panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mx-hero__tx {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #fff;
    width: min(90vw, 30rem);
  }

  .mx-hero__tx h1 {
    color: #fff;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .mx-hero__tx p {
    font-family: var(--mx-font);
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .mx-hero__cta {
    color: #fff;
  }

  @media (max-width: 700px) {
    .mx-hero__paneles {
      grid-template-columns: 1fr;
    }
    .mx-hero__panel {
      aspect-ratio: 1 / 1;
    }
    .mx-hero__panel:not(:first-child) {
      display: none;
    }
  }
</style>
