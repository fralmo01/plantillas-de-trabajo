---
import { duoDestacado, getRevolveImg } from '../datos/revolve.js';

const base = '/plantillas/tienda-revolve';
---

<section class="rv-seccion rv-duo">
  <div class="rv-wrap rv-duo__grid">
    {duoDestacado.map((d: { t: string; numero?: string; sub?: string; seed: string }) => (
      <a href={`${base}/buscar/`} class="rv-duo__tile">
        <img src={getRevolveImg(d.seed, 900, 700)} alt={d.t} loading="lazy" />
        <div class="rv-duo__tx">
          {d.numero && <span class="rv-duo__numero">{d.numero}</span>}
          <h3>{d.t}</h3>
          {d.sub && <p>{d.sub}</p>}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .rv-duo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .rv-duo__tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .rv-duo__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .rv-duo__tile:hover img {
    transform: scale(1.04);
  }

  .rv-duo__tx {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    text-align: center;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 45%);
    color: #fff;
  }

  .rv-duo__numero {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }

  .rv-duo__tx h3 {
    font-size: 1.15rem;
    color: #fff;
  }

  .rv-duo__tx p {
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    .rv-duo__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
