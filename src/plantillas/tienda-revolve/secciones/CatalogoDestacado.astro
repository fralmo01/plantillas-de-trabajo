---
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import { catalogo } from '../datos/revolve.js';

interface Producto {
  nombre: string;
  disenador: string;
  precio: number;
  seed: string;
  tendencia?: boolean;
}
const destacados = (catalogo as Producto[]).filter((p) => p.tendencia);
---

<section class="rv-seccion rv-cat">
  <div class="rv-wrap">
    <h2 class="rv-titulo-seccion">Lo Mas Deseado</h2>
    <div class="rv-cat__grid">
      {destacados.map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </div>
</section>

<style>
  .rv-cat__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem 1.25rem;
  }

  @media (max-width: 1100px) {
    .rv-cat__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .rv-cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
