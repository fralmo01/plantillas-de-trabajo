---
import { utilityBar, marca } from '../datos/revolve.js';
---

<div class="rv-util">
  <div class="rv-wrap rv-util__row">
    <p class="rv-util__msg">{utilityBar.mensaje}</p>
    <div class="rv-util__links">
      <a href="#top">{utilityBar.linkHermana}</a>
      <a href="#top">Ayuda</a>
      <span class="rv-util__hermana">{marca.hermana}</span>
    </div>
  </div>
</div>

<style>
  .rv-util {
    background: var(--rv-tinta);
    color: #fff;
  }

  .rv-util__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-block: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
  }

  .rv-util__msg {
    text-align: center;
  }

  .rv-util__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .rv-util__links a:hover {
    opacity: 0.7;
  }

  .rv-util__hermana {
    letter-spacing: 0.12em;
    opacity: 0.6;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
    padding-left: 1rem;
  }

  @media (max-width: 720px) {
    .rv-util__row {
      flex-wrap: wrap;
      row-gap: 0.35rem;
    }
    .rv-util__hermana {
      display: none;
    }
  }
</style>
