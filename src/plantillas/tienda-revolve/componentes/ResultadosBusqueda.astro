---
import Filtros from './Filtros.astro';
import TarjetaProducto from './TarjetaProducto.astro';
import { catalogo, sugerenciasBusqueda } from '../datos/revolve.js';

interface Producto {
  nombre: string;
  disenador: string;
  precio: number;
  seed: string;
  tipo: string;
  tendencia?: boolean;
  tags?: string[];
}
const base = '/plantillas/tienda-revolve';
const productos = catalogo as Producto[];
const heno = (p: Producto) => [p.nombre, p.disenador, p.tipo, ...(p.tags ?? [])].join(' ').toLowerCase();
---

<section class="rv-res rv-wrap">
  <h1 class="rv-res__titulo" id="rv-res-titulo">Todos los productos</h1>

  <button class="rv-res__toggle" type="button" id="rv-toggle-filtros">Filtrar</button>

  <div class="rv-res__layout">
    <Filtros />

    <div class="rv-res__grid-wrap">
      <div class="rv-res__vacio" id="rv-res-vacio" hidden>
        <p>No encontramos productos para <b id="rv-res-vacio-q"></b>.</p>
        <p class="rv-res__prueba">Prueba buscando:</p>
        <div class="rv-res__sugs">
          {sugerenciasBusqueda.map((s: string) => (
            <a href={`${base}/buscar/?q=${encodeURIComponent(s)}`} class="rv-btn rv-btn--claro">{s}</a>
          ))}
        </div>
      </div>

      <div class="rv-res__grid" id="rv-res-grid">
        {productos.map((p) => (
          <div data-item data-heno={heno(p)} data-disenador={p.disenador} data-precio={p.precio}>
            <TarjetaProducto producto={p} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const norm = (s: string) => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const termino = (new URLSearchParams(location.search).get('q') ?? '').trim();
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));

  const tituloEl = document.getElementById('rv-res-titulo');
  const vacio = document.getElementById('rv-res-vacio') as HTMLElement | null;
  const vacioQ = document.getElementById('rv-res-vacio-q');
  const grid = document.getElementById('rv-res-grid') as HTMLElement | null;

  if (tituloEl && termino) tituloEl.textContent = `Resultados para "${termino}"`;
  if (vacioQ) vacioQ.textContent = `"${termino}"`;

  function checkboxesActivos(nombre: string) {
    return Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${nombre}"]:checked`)).map((i) => i.value);
  }

  function aplicar() {
    const palabras = norm(termino).split(/\s+/).filter(Boolean);
    const disenadores = checkboxesActivos('disenador');

    let visibles = 0;
    for (const it of items) {
      const heno = norm(it.dataset.heno || '');
      const nombreOk = palabras.length === 0 || palabras.every((w) => heno.includes(w));
      const disenadorOk = disenadores.length === 0 || disenadores.includes(it.dataset.disenador || '');
      const ok = nombreOk && disenadorOk;
      it.hidden = !ok;
      if (ok) visibles++;
    }
    if (vacio) vacio.hidden = visibles > 0;
    if (grid) grid.hidden = visibles === 0;
  }

  document.querySelectorAll<HTMLInputElement>('.rv-filtros input[type="checkbox"]').forEach((cb) => {
    cb.addEventListener('change', aplicar);
  });

  const ordenRadios = document.querySelectorAll<HTMLInputElement>('input[name="orden"]');
  ordenRadios.forEach((r) => {
    r.addEventListener('change', () => {
      if (!grid) return;
      const visibles = items.filter((it) => !it.hidden);
      const precio = (it: HTMLElement) => Number(it.dataset.precio || '0');
      if (r.value === 'Precio: menor a mayor') visibles.sort((a, b) => precio(a) - precio(b));
      if (r.value === 'Precio: mayor a menor') visibles.sort((a, b) => precio(b) - precio(a));
      visibles.forEach((it) => grid.appendChild(it));
    });
  });

  document.getElementById('rv-filtros-limpiar')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.rv-filtros input[type="checkbox"]').forEach((cb) => (cb.checked = false));
    aplicar();
  });

  const panel = document.getElementById('rv-filtros');
  const abrirBtn = document.getElementById('rv-toggle-filtros');
  const cerrarBtn = panel?.querySelector('.rv-filtros__x');
  abrirBtn?.addEventListener('click', () => panel?.classList.toggle('is-abierto'));
  cerrarBtn?.addEventListener('click', () => panel?.classList.remove('is-abierto'));

  aplicar();
</script>

<style>
  .rv-res {
    padding-block: 2.25rem 4rem;
  }

  .rv-res__titulo {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .rv-res__toggle {
    display: none;
    border: 1px solid var(--rv-tinta);
    padding: 0.5rem 1rem;
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .rv-res__layout {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .rv-res__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem 1.25rem;
  }

  .rv-res__grid[hidden] {
    display: none;
  }

  .rv-res__vacio[hidden] {
    display: none;
  }

  .rv-res__vacio {
    border: 1px dashed var(--rv-linea);
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .rv-res__prueba {
    margin-top: 0.75rem;
    font-weight: 600;
  }

  .rv-res__sugs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.75rem;
  }

  @media (max-width: 1100px) {
    .rv-res__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .rv-res__layout {
      grid-template-columns: 1fr;
    }
    .rv-res__toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 700px) {
    .rv-res__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
