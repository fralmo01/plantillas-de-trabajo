---
import { soles, getRevolveImg } from '../datos/revolve.js';

interface Producto {
  nombre: string;
  disenador: string;
  precio: number;
  seed: string;
  tendencia?: boolean;
  img?: string;
}
const { producto } = Astro.props as { producto: Producto };
const img = producto.img ?? getRevolveImg(producto.seed, 500, 650);
---

<article class="rv-prod">
  <div class="rv-prod__media">
    {producto.tendencia && <span class="rv-prod__badge">Trending</span>}
    <img src={img} alt={producto.nombre} loading="lazy" decoding="async" />
    <button type="button" class="rv-prod__fav" aria-label="Agregar a favoritos">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.35-9.5-8.5C.8 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.2 4 3.5 7.5C19 16.65 12 21 12 21z"></path></svg>
    </button>
    <button type="button" class="rv-btn rv-btn--oscuro rv-prod__add">Anadir</button>
  </div>
  <div class="rv-prod__body">
    <p class="rv-prod__disenador">{producto.disenador}</p>
    <h3 class="rv-prod__nombre">{producto.nombre}</h3>
    <p class="rv-prod__precio">{soles(producto.precio)}</p>
  </div>
</article>

<style>
  .rv-prod[hidden] {
    display: none;
  }

  .rv-prod {
    display: flex;
    flex-direction: column;
  }

  .rv-prod__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--rv-gris-claro);
    overflow: hidden;
  }

  .rv-prod__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rv-prod__badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: var(--rv-tinta);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    z-index: 2;
  }

  .rv-prod__fav {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--rv-tinta);
  }

  .rv-prod__fav.is-on {
    color: var(--rv-rojo);
  }

  .rv-prod__add {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .rv-prod:hover .rv-prod__add {
    opacity: 1;
    transform: translateY(0);
  }

  .rv-prod__add.is-ok {
    background: #2c8a4d;
  }

  .rv-prod__body {
    padding-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rv-prod__disenador {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .rv-prod__nombre {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--rv-gris);
  }

  .rv-prod__precio {
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }

  @media (max-width: 700px) {
    .rv-prod__add {
      opacity: 1;
      transform: none;
      position: static;
      margin-top: 0.5rem;
      width: 100%;
    }
  }
</style>
