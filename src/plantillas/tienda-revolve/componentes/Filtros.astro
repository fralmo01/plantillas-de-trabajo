---
import { catalogo, filtrosDisenador, filtrosColor, filtrosTalla, ordenarPor } from '../datos/revolve.js';

const contar = (d: string) => catalogo.filter((p: Record<string, unknown>) => p.disenador === d).length;
---

<aside class="rv-filtros" id="rv-filtros">
  <div class="rv-filtros__cab">
    <span>Filtrar</span>
    <button class="rv-filtros__x" type="button" aria-label="Cerrar filtros">&times;</button>
  </div>

  <form class="rv-filtros__form" onsubmit="return false">
    <details class="rv-grupo" open>
      <summary>Disenador</summary>
      <div class="rv-grupo__cuerpo">
        <ul class="rv-grupo__lista" data-filtro="disenador">
          {filtrosDisenador.map((d: string) => (
            <li>
              <label>
                <input type="checkbox" name="disenador" value={d} />
                <span>{d}</span>
                <b>({contar(d)})</b>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <details class="rv-grupo">
      <summary>Color</summary>
      <div class="rv-grupo__cuerpo">
        <div class="rv-grupo__colores">
          {filtrosColor.map((c: { nombre: string; hex: string }) => (
            <button type="button" class="rv-color" title={c.nombre} aria-label={c.nombre}>
              <span style={`background:${c.hex}`}></span>
            </button>
          ))}
        </div>
      </div>
    </details>

    <details class="rv-grupo">
      <summary>Talla</summary>
      <div class="rv-grupo__cuerpo">
        <div class="rv-grupo__tallas">
          {filtrosTalla.map((t: string) => <button type="button" class="rv-talla">{t}</button>)}
        </div>
      </div>
    </details>

    <details class="rv-grupo">
      <summary>Precio</summary>
      <div class="rv-grupo__cuerpo">
        <label class="rv-check"><input type="checkbox" disabled /> <span>Menos de S/ 300</span></label>
        <label class="rv-check"><input type="checkbox" disabled /> <span>S/ 300 - S/ 800</span></label>
        <label class="rv-check"><input type="checkbox" disabled /> <span>Mas de S/ 800</span></label>
      </div>
    </details>

    <details class="rv-grupo" open>
      <summary>Ordenar por</summary>
      <div class="rv-grupo__cuerpo">
        <ul class="rv-grupo__radios">
          {ordenarPor.map((o: string, i: number) => (
            <li>
              <label>
                <input type="radio" name="orden" value={o} checked={i === 0} />
                <span>{o}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <button type="button" class="rv-btn rv-btn--claro rv-filtros__limpiar" id="rv-filtros-limpiar">Limpiar filtros</button>
  </form>
</aside>

<style>
  .rv-filtros {
    align-self: start;
  }

  .rv-filtros__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .rv-filtros__cab span {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rv-filtros__x {
    display: none;
    font-size: 1.1rem;
  }

  .rv-grupo {
    border-bottom: 1px solid var(--rv-linea);
    padding-block: 0.85rem;
  }

  .rv-grupo summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.83rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .rv-grupo summary::-webkit-details-marker {
    display: none;
  }

  .rv-grupo summary::after {
    content: "\002B";
    color: var(--rv-gris);
  }

  .rv-grupo[open] summary::after {
    content: "\2212";
  }

  .rv-grupo__cuerpo {
    padding-top: 0.85rem;
    display: grid;
    gap: 0.6rem;
  }

  .rv-grupo__lista,
  .rv-grupo__radios {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .rv-grupo__lista label,
  .rv-grupo__radios label,
  .rv-check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .rv-grupo__lista label b {
    margin-left: auto;
    color: var(--rv-gris);
    font-weight: 500;
    font-size: 0.72rem;
  }

  .rv-grupo__lista input,
  .rv-grupo__radios input,
  .rv-check input {
    accent-color: var(--rv-tinta);
  }

  .rv-grupo__colores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rv-color {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    padding: 2px;
    border: 1px solid var(--rv-linea);
  }

  .rv-color span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .rv-grupo__tallas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rv-talla {
    min-width: 38px;
    padding: 0.4rem;
    border: 1px solid var(--rv-linea);
    font-size: 0.78rem;
  }

  .rv-talla:hover {
    border-color: var(--rv-tinta);
  }

  .rv-filtros__limpiar {
    width: 100%;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .rv-filtros {
      position: fixed;
      inset: 0 25% 0 0;
      z-index: 350;
      background: #fff;
      padding: 1.25rem;
      overflow-y: auto;
      transform: translateX(-105%);
      transition: transform 0.25s ease;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.25);
    }
    .rv-filtros.is-abierto {
      transform: none;
    }
    .rv-filtros__x {
      display: block;
    }
  }
</style>
