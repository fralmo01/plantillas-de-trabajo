---
import { faqChat } from '../datos/revolve.js';
---

<div class="rv-chat">
  <div class="rv-chat__panel" id="rv-chat-panel" hidden>
    <div class="rv-chat__cab">
      <span>Como podemos ayudarte?</span>
      <button type="button" class="rv-chat__x" id="rv-chat-cerrar" aria-label="Cerrar chat">&times;</button>
    </div>
    <div class="rv-chat__cuerpo">
      {faqChat.map((f: { t: string; r: string }) => (
        <details class="rv-chat__item">
          <summary>{f.t}</summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
    <div class="rv-chat__pie">
      <p>No encontraste lo que buscabas? Escribenos y te respondemos en breve.</p>
    </div>
  </div>

  <button type="button" class="rv-chat__btn" id="rv-chat-btn" aria-label="Abrir chat de ayuda">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-8.7 8.4 8.5 8.5 0 0 1-4-1L3 20l1.1-5.3a8.38 8.38 0 0 1-1-4A8.38 8.38 0 0 1 11.5 3a8.5 8.5 0 0 1 9.5 8.5z"></path></svg>
  </button>
</div>

<script>
  const btn = document.getElementById('rv-chat-btn');
  const panel = document.getElementById('rv-chat-panel') as HTMLElement | null;
  const cerrar = document.getElementById('rv-chat-cerrar');

  btn?.addEventListener('click', () => {
    if (panel) panel.hidden = !panel.hidden;
  });
  cerrar?.addEventListener('click', () => {
    if (panel) panel.hidden = true;
  });
</script>

<style>
  .rv-chat {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 400;
  }

  .rv-chat__btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--rv-tinta);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .rv-chat__panel[hidden] {
    display: none;
  }

  .rv-chat__panel {
    position: absolute;
    right: 0;
    bottom: 68px;
    width: min(320px, 84vw);
    background: #fff;
    border: 1px solid var(--rv-linea);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  .rv-chat__cab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.1rem;
    background: var(--rv-tinta);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .rv-chat__x {
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
  }

  .rv-chat__cuerpo {
    padding: 0.75rem 1.1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rv-chat__item {
    border-bottom: 1px solid var(--rv-linea);
    padding-block: 0.6rem;
  }

  .rv-chat__item summary {
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .rv-chat__item summary::-webkit-details-marker {
    display: none;
  }

  .rv-chat__item p {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--rv-gris);
    line-height: 1.5;
  }

  .rv-chat__pie {
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--rv-linea);
    font-size: 0.72rem;
    color: var(--rv-gris);
  }
</style>
