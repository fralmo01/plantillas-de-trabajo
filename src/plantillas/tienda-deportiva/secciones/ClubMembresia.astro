<section class="tt-seccion tt-club" id="club">
  <div class="tt-contenedor">
    <div class="tt-club__caja">
      <div class="tt-club__encabezado">
        <span class="tt-badge tt-badge--neon">MEMBRESÍA GRATUITA</span>
        <h2 class="tt-club__titulo">ÚNETE A TU TIENDA CLUB</h2>
        <p class="tt-club__sub">
          Obtén un <strong>15% de descuento inmediato</strong> en tu primera compra y accede a beneficios exclusivos antes que nadie.
        </p>
      </div>

      
      <div class="tt-club__beneficios">
        <div class="tt-bene-item">
          <div class="tt-bene-icono">⚡</div>
          <div class="tt-bene-texto">
            <h4>DROPS EXCLUSIVOS</h4>
            <p>Acceso prioritario a lanzamientos y colaboraciones limitadas.</p>
          </div>
        </div>

        <div class="tt-bene-item">
          <div class="tt-bene-icono">🚚</div>
          <div class="tt-bene-texto">
            <h4>ENVÍOS GRATUITOS</h4>
            <p>Envío estándar gratis en todos tus pedidos sin monto mínimo.</p>
          </div>
        </div>

        <div class="tt-bene-item">
          <div class="tt-bene-icono">🎁</div>
          <div class="tt-bene-texto">
            <h4>REGALO DE CUMPLEAÑOS</h4>
            <p>Un cupón especial para celebrar tu día a lo grande.</p>
          </div>
        </div>

        <div class="tt-bene-item">
          <div class="tt-bene-icono">🔄</div>
          <div class="tt-bene-texto">
            <h4>30 DÍAS DE CAMBIO</h4>
            <p>Devoluciones y cambios rápidos y sin costos adicionales.</p>
          </div>
        </div>
      </div>

      
      <form class="tt-club__form" id="form-club">
        <div class="tt-club__inputs">
          <input 
            type="email" 
            placeholder="Introduce tu correo electrónico..." 
            required 
            class="tt-club__input-email"
            id="input-club-email"
          />
          <button type="submit" class="tt-boton tt-boton--blanco tt-club__btn-submit">
            ÚNETE GRATIS <span>→</span>
          </button>
        </div>

        
        <div class="tt-club__preferencias">
          <label class="tt-radio-label">
            <input type="radio" name="preferencia" value="hombre" checked />
            <span>Hombre</span>
          </label>
          <label class="tt-radio-label">
            <input type="radio" name="preferencia" value="mujer" />
            <span>Mujer</span>
          </label>
          <label class="tt-radio-label">
            <input type="radio" name="preferencia" value="todos" />
            <span>Ver todo</span>
          </label>
        </div>

        <p class="tt-club__legal">
          Al registrarte aceptas los Términos y Condiciones y la Política de Privacidad de <strong>tu tienda.com</strong>.
        </p>

        <div class="tt-club__mensaje-exito" id="msg-club-exito">
          🎉 <strong>¡Bienvenido a Tu Tienda Club!</strong> Hemos enviado tu cupón del <strong>15% OFF</strong> a tu correo.
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .tt-club {
    background: var(--tt-blanco);
  }

  .tt-club__caja {
    background: var(--tt-negro);
    color: var(--tt-blanco);
    padding: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--tt-gris-oscuro);
  }

  .tt-club__encabezado {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .tt-club__titulo {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin-block: 0.8rem 0.6rem;
    color: var(--tt-blanco);
  }

  .tt-club__sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }

  .tt-club__sub strong {
    color: var(--tt-amarillo-neon);
  }

  .tt-club__beneficios {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
    border-top: 1px solid var(--tt-gris-oscuro);
    border-bottom: 1px solid var(--tt-gris-oscuro);
    padding-block: 2rem;
  }

  .tt-bene-item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .tt-bene-icono {
    font-size: 1.6rem;
    line-height: 1;
  }

  .tt-bene-texto h4 {
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 0.3rem;
    color: var(--tt-blanco);
  }

  .tt-bene-texto p {
    font-size: 0.75rem;
    color: var(--tt-gris-medio);
    line-height: 1.4;
  }

  .tt-club__form {
    max-width: 600px;
    margin-inline: auto;
  }

  .tt-club__inputs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tt-club__input-email {
    flex: 1;
    background: var(--tt-gris-oscuro);
    border: 1px solid var(--tt-gris-medio);
    color: var(--tt-blanco);
    padding: 0.85rem 1.2rem;
    font-family: var(--tt-font-texto);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .tt-club__input-email:focus {
    border-color: var(--tt-amarillo-neon);
  }

  .tt-club__btn-submit span {
    transition: transform 0.2s ease;
  }

  .tt-club__btn-submit:hover span {
    transform: translateX(4px);
  }

  .tt-club__preferencias {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .tt-radio-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    font-family: var(--tt-font-display);
    font-weight: 700;
  }

  .tt-radio-label input {
    accent-color: var(--tt-amarillo-neon);
  }

  .tt-club__legal {
    text-align: center;
    font-size: 0.7rem;
    color: var(--tt-gris-medio);
    line-height: 1.4;
  }

  .tt-club__legal strong {
    color: var(--tt-blanco);
  }

  .tt-club__mensaje-exito {
    display: none;
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(226, 243, 78, 0.12);
    border: 1px solid var(--tt-amarillo-neon);
    color: var(--tt-blanco);
    font-size: 0.85rem;
    text-align: center;
  }

  .tt-club__mensaje-exito.activo {
    display: block;
  }

  @media (max-width: 900px) {
    .tt-club__beneficios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .tt-club__beneficios {
      grid-template-columns: 1fr;
    }
    .tt-club__inputs {
      flex-direction: column;
    }
  }
</style>

<script>
  const formClub = document.getElementById('form-club');
  const msgExito = document.getElementById('msg-club-exito');
  const inputEmail = document.getElementById('input-club-email');

  if (formClub && msgExito) {
    formClub.addEventListener('submit', (e) => {
      e.preventDefault();
      msgExito.classList.add('activo');
      if (inputEmail) {
        (inputEmail as HTMLInputElement).value = '';
      }
    });
  }
</script>
