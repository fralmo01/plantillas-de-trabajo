---
const deportes = [
  {
    nombre: "FÚTBOL",
    frase: "Precisión, control y velocidad en cada jugada",
    img: "https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=600&auto=format&fit=crop",
    enlace: "#deportes"
  },
  {
    nombre: "RUNNING",
    frase: "Kilómetros de amortiguación y ligereza",
    img: "https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?q=80&w=600&auto=format&fit=crop",
    enlace: "#deportes"
  },
  {
    nombre: "GYM & TRAINING",
    frase: "Fuerza, resistencia y confort técnico",
    img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=600&auto=format&fit=crop",
    enlace: "#deportes"
  },
  {
    nombre: "BÁSQUETBOL",
    frase: "Salto explosivo y agarre sobre la duela",
    img: "https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=600&auto=format&fit=crop",
    enlace: "#deportes"
  },
  {
    nombre: "OUTDOOR & TRAIL",
    frase: "Tracción todoterreno para la montaña",
    img: "https://images.unsplash.com/photo-1551632811-561732d1e306?q=80&w=600&auto=format&fit=crop",
    enlace: "#deportes"
  }
];
---

<section class="tt-seccion tt-deportes" id="deportes">
  <div class="tt-contenedor">
    <div class="tt-deportes__cabecera">
      <h2 class="tt-deportes__titulo">DISCIPLINAS DEPORTIVAS</h2>
      <p class="tt-deportes__subtitulo">EQUÍPATE CON LA MEJOR TECNOLOGÍA PARA TU DISCIPLINA</p>
    </div>

    <div class="tt-deportes__grid">
      {deportes.map((dep) => (
        <a href={dep.enlace} class="tt-dep-card">
          <div class="tt-dep-card__img-wrap">
            <img src={dep.img} alt={`Disciplina ${dep.nombre}`} loading="lazy" />
            <div class="tt-dep-card__gradiente"></div>
          </div>
          <div class="tt-dep-card__info">
            <h3 class="tt-dep-card__titulo">{dep.nombre}</h3>
            <p class="tt-dep-card__frase">{dep.frase}</p>
            <span class="tt-dep-card__enlace">EXPLORAR →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tt-deportes {
    background: var(--tt-gris-bg);
    border-top: 1px solid var(--tt-gris-borde);
  }

  .tt-deportes__cabecera {
    margin-bottom: 2rem;
  }

  .tt-deportes__titulo {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    color: var(--tt-negro);
  }

  .tt-deportes__subtitulo {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--tt-gris-medio);
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }

  .tt-deportes__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .tt-dep-card {
    position: relative;
    height: 380px;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    overflow: hidden;
    background: var(--tt-negro);
    border: 1px solid var(--tt-gris-borde);
  }

  .tt-dep-card__img-wrap {
    position: absolute;
    inset: 0;
  }

  .tt-dep-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tt-dep-card:hover .tt-dep-card__img-wrap img {
    transform: scale(1.08);
  }

  .tt-dep-card__gradiente {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .tt-dep-card__info {
    position: relative;
    z-index: 2;
    padding: 1.2rem;
    color: var(--tt-blanco);
  }

  .tt-dep-card__titulo {
    font-size: 1.25rem;
    line-height: 1.1;
    margin-bottom: 0.3rem;
    color: var(--tt-blanco);
  }

  .tt-dep-card__frase {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }

  .tt-dep-card__enlace {
    font-family: var(--tt-font-display);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--tt-amarillo-neon);
    letter-spacing: 0.05em;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .tt-dep-card:hover .tt-dep-card__enlace {
    transform: translateX(4px);
  }

  @media (max-width: 1100px) {
    .tt-deportes__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tt-deportes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tt-dep-card {
      height: 280px;
    }
  }
</style>
