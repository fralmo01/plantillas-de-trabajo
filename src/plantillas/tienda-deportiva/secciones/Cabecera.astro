<header class="tt-cabecera">
  <div class="tt-contenedor tt-cabecera__inner">
    
    <button class="tt-cabecera__btn-mobile" id="btn-toggle-menu" aria-label="Abrir navegación">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    
    <a href="#inicio" class="tt-logo" aria-label="tu tienda.com">
      <div class="tt-logo__barras" aria-hidden="true">
        <span class="tt-barra tt-barra--1"></span>
        <span class="tt-barra tt-barra--2"></span>
        <span class="tt-barra tt-barra--3"></span>
      </div>
      <div class="tt-logo__texto">
        <span class="tt-logo__marca">tu tienda<span class="tt-logo__punto">.com</span></span>
      </div>
    </a>

    
    <nav class="tt-nav" id="menu-principal" aria-label="Navegación principal">
      <ul class="tt-nav__lista">
        <li><a href="#mujer" class="tt-nav__link">Mujer</a></li>
        <li><a href="#hombre" class="tt-nav__link">Hombre</a></li>
        <li><a href="#ninos" class="tt-nav__link">Niños</a></li>
        <li>
          <a href="#tendencias" class="tt-nav__link tt-nav__link--tendencias">
            <span class="tt-icono-tendencia">👟</span> Tendencias
          </a>
        </li>
        <li><a href="#deportes" class="tt-nav__link">Deportes</a></li>
        <li><a href="#outlet" class="tt-nav__link tt-nav__link--promo">Hasta 30% off</a></li>
      </ul>
    </nav>

    
    <div class="tt-acciones">
      
      <div class="tt-buscador">
        <input 
          type="text" 
          placeholder="Buscar" 
          aria-label="Buscar en la tienda"
          class="tt-buscador__input"
        />
        <button class="tt-buscador__btn" aria-label="Buscar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>

      
      <a href="#cuenta" class="tt-btn-icono" aria-label="Perfil de usuario">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="tt-badge-usuario">1</span>
      </a>

      
      <a href="#favoritos" class="tt-btn-icono" aria-label="Favoritos" id="btn-wishlist">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>

      
      <a href="#carrito" class="tt-btn-icono" aria-label="Bolsa de compras" id="btn-carrito">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </a>
    </div>
  </div>

  
  <div class="tt-cinta-aviso">
    <div class="tt-contenedor tt-cinta-aviso__inner">
      <a href="#club" class="tt-cinta-aviso__enlace">
        <span>🔥 <strong>TU TIENDA CLUB FESTIVAL YA LLEGÓ.</strong> INICIA SESIÓN Y APROVECHA OFERTAS, PREMIOS Y SORPRESAS.</span>
        <span class="tt-cinta-aviso__flecha">→</span>
      </a>
    </div>
  </div>
</header>

<style>
  .tt-cabecera {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--tt-blanco);
    border-bottom: 1px solid var(--tt-gris-borde);
  }

  .tt-cabecera__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1.5rem;
  }

  .tt-cabecera__btn-mobile {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem;
  }

  
  .tt-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--tt-negro);
    flex-shrink: 0;
  }

  .tt-logo__barras {
    display: flex;
    align-items: flex-end;
    gap: 3.5px;
    height: 24px;
  }

  .tt-barra {
    display: block;
    width: 6px;
    background: var(--tt-negro);
    transform: skew(-24deg);
    border-radius: 0.5px;
  }

  .tt-barra--1 { height: 12px; }
  .tt-barra--2 { height: 18px; }
  .tt-barra--3 { height: 24px; }

  .tt-logo__marca {
    font-family: var(--tt-font-condensed);
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .tt-logo__punto {
    color: var(--tt-azul-enlace);
  }

  
  .tt-nav__lista {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 1.8rem;
  }

  .tt-nav__link {
    text-decoration: none;
    color: var(--tt-negro);
    font-family: var(--tt-font-texto);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    position: relative;
    padding-block: 0.3rem;
  }

  .tt-nav__link:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .tt-nav__link--tendencias {
    font-weight: 800;
  }

  .tt-icono-tendencia {
    font-size: 0.9rem;
  }

  .tt-nav__link--promo {
    color: var(--tt-rojo-promo);
    font-weight: 800;
  }

  
  .tt-acciones {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .tt-buscador {
    display: flex;
    align-items: center;
    background: var(--tt-gris-tarjeta);
    padding: 0.35rem 0.6rem 0.35rem 0.85rem;
    width: 180px;
    border: 1px solid transparent;
  }

  .tt-buscador:focus-within {
    background: var(--tt-blanco);
    border-color: var(--tt-negro);
  }

  .tt-buscador__input {
    border: none;
    background: transparent;
    font-size: 0.82rem;
    color: var(--tt-negro);
    width: 100%;
    outline: none;
  }

  .tt-buscador__btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--tt-negro);
    display: flex;
    align-items: center;
  }

  .tt-btn-icono {
    position: relative;
    color: var(--tt-negro);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: 0.2rem;
  }

  .tt-badge-usuario {
    position: absolute;
    top: -2px;
    right: -3px;
    background: var(--tt-verde-club);
    color: var(--tt-blanco);
    font-size: 0.6rem;
    font-weight: 800;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  
  .tt-cinta-aviso {
    background: var(--tt-gris-suave);
    border-top: 1px solid var(--tt-gris-borde);
    padding-block: 0.5rem;
    font-size: 0.75rem;
  }

  .tt-cinta-aviso__inner {
    display: flex;
    justify-content: center;
  }

  .tt-cinta-aviso__enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 850px;
    color: var(--tt-negro);
    text-decoration: none;
    font-family: var(--tt-font-condensed);
    letter-spacing: 0.02em;
  }

  .tt-cinta-aviso__enlace:hover {
    text-decoration: underline;
  }

  .tt-cinta-aviso__flecha {
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .tt-cabecera__btn-mobile {
      display: block;
    }

    .tt-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--tt-blanco);
      border-bottom: 2px solid var(--tt-negro);
      padding: 1.2rem;
    }

    .tt-nav.abierto {
      display: block;
    }

    .tt-nav__lista {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .tt-buscador {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('btn-toggle-menu');
  const nav = document.getElementById('menu-principal');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      nav.classList.toggle('abierto');
    });
  }
</script>
