---
import { mundos } from '../datos/metro.js';
---

<section class="tm-seccion tm-wrap">
  <h2 class="tm-titulo">Descubre lo genial de nuestros mundos</h2>
  <div class="tm-fila tm-mundos">
    {mundos.map((m: { t: string; seed: string }) => (
      <a href="#tabs" class="tm-mundos__item">
        <img src={`https://picsum.photos/seed/${m.seed}/320/220`} alt={m.t} loading="lazy" />
        <span>{m.t}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .tm-mundos {
    grid-auto-columns: minmax(220px, 1fr);
  }

  .tm-mundos__item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .tm-mundos__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tm-mundos__item span {
    position: absolute;
    left: 0.75rem;
    bottom: 0.6rem;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }
</style>
