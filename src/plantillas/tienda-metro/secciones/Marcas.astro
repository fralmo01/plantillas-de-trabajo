---
import { marcas } from '../datos/metro.js';
---

<section class="tm-seccion tm-wrap">
  <h2 class="tm-titulo">Nuestras marcas destacadas</h2>
  <div class="tm-marcas">
    {marcas.map((m: { t: string; sub: string; seed: string }) => (
      <a href="#tabs" class="tm-marcas__card">
        <img src={`https://picsum.photos/seed/${m.seed}/420/240`} alt={m.t} loading="lazy" />
        <div class="tm-marcas__tx">
          <strong>{m.t}</strong>
          <span>{m.sub}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .tm-marcas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .tm-marcas__card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    min-height: 150px;
    display: block;
  }

  .tm-marcas__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tm-marcas__tx {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.2rem;
    color: #fff;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.68), transparent 65%);
  }

  .tm-marcas__tx strong {
    font-size: 0.95rem;
    font-weight: 800;
  }

  .tm-marcas__tx span {
    font-size: 0.76rem;
  }

  @media (max-width: 820px) {
    .tm-marcas {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .tm-marcas {
      grid-template-columns: 1fr;
    }
  }
</style>
