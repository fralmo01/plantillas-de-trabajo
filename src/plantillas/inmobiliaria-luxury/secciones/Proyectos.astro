---
import { proyectos, distritos, etapasFiltro, usd } from '../datos/proyectos.js';
---

<section class="il-seccion il-wrap" id="mapa">
  <p class="il-eyebrow">Ubicaciones</p>
  <h2 class="il-titulo">Proyectos por distrito</h2>
  <p class="il-sub">Filtra por zona y etapa de obra. Todos los precios en dólares, referenciales al tipo de cambio del día.</p>

  <div class="il-cat" id="catalogo">
    <div class="il-cat__filtros" role="group" aria-label="Filtros">
      <select id="il-f-distrito" aria-label="Distrito">
        <option value="todos">Todos los distritos</option>
        {distritos.map((d: string) => <option value={d}>{d}</option>)}
      </select>
      <select id="il-f-etapa" aria-label="Etapa">
        <option value="todas">Cualquier etapa</option>
        {etapasFiltro.map((e: string) => <option value={e}>{e}</option>)}
      </select>
      <span class="il-cat__count" id="il-count">{proyectos.length} proyectos</span>
    </div>

    <div class="il-cat__grid" id="il-grid">
      {
        proyectos.map((p) => (
          <article class="il-proj" data-distrito={p.distrito} data-etapa={p.etapa}>
            <div class="il-proj__media">
              <img src={p.img} alt={p.nombre} loading="lazy" />
              <span class="il-proj__etapa">{p.etapa}</span>
            </div>
            <div class="il-proj__body">
              <h3>{p.nombre}</h3>
              <p class="il-proj__dist">{p.distrito} &middot; entrega {p.entrega}</p>
              <ul class="il-proj__specs">
                <li>{p.dorms}</li>
                <li>{p.m2}</li>
                <li>{p.tag}</li>
              </ul>
              <p class="il-proj__precio">Desde <b>{usd(p.desdeUSD)}</b></p>
              <a href="#concierge" class="il-btn il-btn--navy il-proj__cta">Solicitar información</a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="il-cat__vacio" id="il-vacio" hidden>No hay proyectos con esos filtros.</p>
  </div>
</section>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('#il-grid .il-proj')];
  const fD = document.getElementById('il-f-distrito') as HTMLSelectElement | null;
  const fE = document.getElementById('il-f-etapa') as HTMLSelectElement | null;
  const count = document.getElementById('il-count');
  const vacio = document.getElementById('il-vacio');
  function aplicar() {
    const d = fD?.value ?? 'todos';
    const e = fE?.value ?? 'todas';
    let n = 0;
    for (const c of cards) {
      const ok = (d === 'todos' || c.dataset.distrito === d) && (e === 'todas' || c.dataset.etapa === e);
      c.hidden = !ok;
      if (ok) n++;
    }
    if (count) count.textContent = `${n} proyecto${n === 1 ? '' : 's'}`;
    if (vacio) vacio.hidden = n > 0;
  }
  fD?.addEventListener('change', aplicar);
  fE?.addEventListener('change', aplicar);
</script>

<style>
  .il-cat__filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .il-cat__filtros select {
    border: 1px solid var(--il-border-med);
    border-radius: 999px;
    padding: 0.55rem 1.75rem 0.55rem 1rem;
    font-size: 0.82rem;
    background: var(--il-surface);
  }

  .il-cat__count {
    font-size: 0.82rem;
    color: var(--il-muted);
    margin-left: auto;
  }

  .il-cat__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .il-proj {
    background: var(--il-surface);
    border: 1px solid var(--il-border);
    border-radius: var(--il-radio-lg);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .il-proj:hover {
    transform: translateY(-4px);
    box-shadow: var(--il-sombra);
  }

  .il-proj__media {
    position: relative;
    aspect-ratio: 16 / 11;
  }

  .il-proj__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .il-proj__etapa {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--il-bg);
    color: var(--il-navy);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  .il-proj__body {
    padding: 1.25rem;
  }

  .il-proj__body h3 {
    font-size: 1.25rem;
  }

  .il-proj__dist {
    font-size: 0.8rem;
    color: var(--il-muted);
    margin: 0.25rem 0 0.75rem;
  }

  .il-proj__specs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }

  .il-proj__specs li {
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--il-subtle);
    color: var(--il-navy);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .il-proj__precio {
    font-size: 0.85rem;
    color: var(--il-text-2);
    margin-bottom: 1rem;
  }

  .il-proj__precio b {
    font-family: var(--il-serif);
    font-size: 1.2rem;
    color: var(--il-navy);
  }

  .il-proj__cta {
    width: 100%;
    font-size: 0.72rem;
  }

  .il-cat__vacio {
    text-align: center;
    color: var(--il-muted);
    padding: 2.5rem;
  }
</style>
