---
import { faqs } from '../datos/gym.js';
---

<section class="gs-seccion gs-wrap" id="faq">
  <h2 class="gs-titulo">Preguntas frecuentes</h2>
  <div class="gs-faq">
    {
      faqs.map((f: { q: string; a: string }, i: number) => (
        <details class="gs-faq__item" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .gs-faq {
    max-width: 780px;
    margin-inline: auto;
    display: grid;
    gap: 0.75rem;
  }

  .gs-faq__item {
    background: var(--gs-g50);
    border: 1px solid var(--gs-g200);
    border-radius: var(--gs-radio-md);
    padding: 0.25rem 1.25rem;
  }

  .gs-faq__item summary {
    list-style: none;
    cursor: pointer;
    font-weight: 800;
    font-size: 0.92rem;
    padding: 1rem 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .gs-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .gs-faq__item summary::after {
    content: "+";
    font-size: 1.2rem;
    color: var(--gs-amarillo-osc);
  }

  .gs-faq__item[open] summary::after {
    content: "–";
  }

  .gs-faq__item p {
    padding-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--gs-g500);
  }
</style>
